# Green Office 2026 — local development (copy to .env)
# Never commit .env. No secrets in this example file.

# Supabase local stack (from `supabase status` after `supabase start`)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Dashboard data source: static | live | hybrid (default static — safe without Supabase)
PUBLIC_DASHBOARD_DATA_MODE=static

# Local auth bootstrap (scripts/bootstrap-local-auth.mjs) — never commit the password
# LOCAL_DEV_TEST_PASSWORD=

# Service role for local bootstrap scripts only (from supabase status -o env) — never commit
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: show preview badge on static builds
# PUBLIC_PREVIEW_BADGE=true
