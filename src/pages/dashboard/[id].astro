---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { dashboards, dashTitle, dashDescription } from '../../data/dashboard-config';
import type { DashboardMeta } from '../../data/dashboard-config';
import { generatedMetricMap } from '../../utils/dashboard-generated-metrics';
import { getLocale } from '../../i18n/utils';
import MetricDashboard from '../../components/dashboard/MetricDashboard.astro';

const genMap = generatedMetricMap;

export function getStaticPaths() {
  return dashboards.map((d) => ({
    params: { id: d.id },
    props: { dashboard: d },
  }));
}

const { dashboard } = Astro.props as { dashboard: DashboardMeta };
const locale = getLocale(Astro.url);
const metric = genMap[dashboard.id];

const pageTitle = dashTitle(dashboard, locale);
const pageDescription = dashDescription(dashboard, locale);
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale}>
  <MetricDashboard dashboard={dashboard} metric={metric} locale={locale} />
</BaseLayout>