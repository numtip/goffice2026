---
import ContentDetailPage from '../../components/content/ContentDetailPage.astro';
import { newsCollection } from '../../data/content/load-content';

export function getStaticPaths() {
  return newsCollection.items
    .filter((item) => item.status === 'published')
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
---

<ContentDetailPage
  item={item}
  locale="th"
  hubRoute="/news"
  hubLabelTh="ข่าวสาร"
  hubLabelEn="News"
/>
