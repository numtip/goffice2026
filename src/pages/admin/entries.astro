---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Entries" activeNav="entries">
  <div id="entries-loading" class="text-sm text-gray-600" aria-live="polite">กำลังโหลด… / Loading…</div>
  <div id="entries-error" class="hidden rounded border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert" tabindex="-1"></div>
  <div id="entries-denied" class="hidden rounded border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900" role="alert">
    ไม่มีสิทธิ์เข้าถึง / Access denied — staff or admin only.
  </div>

  <section id="entries-panel" class="hidden space-y-6">
    <div>
      <h1 class="text-2xl font-semibold text-primary">บันทึกข้อมูล / Entries</h1>
      <p class="mt-1 text-sm text-gray-600">สร้างร่างและส่งตรวจตัวชี้วัดที่มอบหมาย / Draft and submit assigned metrics.</p>
    </div>

    <form id="entry-form" class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm space-y-4" aria-describedby="entry-form-hint">
      <h2 id="entry-form-title" class="font-medium text-gray-900">สร้างร่าง / Create draft</h2>
      <p id="entry-form-hint" class="text-xs text-gray-500">หนึ่งรายการต่อตัวชี้วัด/ปี/เดือน / One entry per metric, year, and month.</p>
      <input type="hidden" id="entry-edit-id" value="" />
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="entry-metric" class="block text-sm font-medium">ตัวชี้วัด / Metric</label>
          <select id="entry-metric" required aria-required="true" class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"></select>
        </div>
        <div>
          <label for="entry-year" class="block text-sm font-medium">ปี / Year</label>
          <input id="entry-year" type="number" min="2560" max="2575" required aria-required="true" class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" value="2569" />
        </div>
        <div>
          <label for="entry-month" class="block text-sm font-medium">เดือน / Month</label>
          <input id="entry-month" type="number" min="1" max="12" required aria-required="true" class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" value="1" />
        </div>
        <div>
          <label for="entry-value" class="block text-sm font-medium">ค่า / Value</label>
          <input id="entry-value" type="number" min="0" step="any" required aria-required="true" class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>
      </div>
      <div>
        <label for="entry-note" class="block text-sm font-medium">หมายเหตุ / Note</label>
        <textarea id="entry-note" rows="2" class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="submit" id="entry-save-btn" class="rounded bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">บันทึกร่าง / Save draft</button>
        <button type="button" id="entry-cancel-edit" class="hidden rounded border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">ยกเลิก / Cancel</button>
      </div>
    </form>

    <div class="rounded-lg border border-gray-200 bg-white shadow-sm overflow-x-auto">
      <table class="min-w-full text-sm">
        <caption class="sr-only">Monthly metric entries</caption>
        <thead class="bg-gray-50 text-left text-gray-700">
          <tr>
            <th scope="col" class="px-4 py-2">Metric</th>
            <th scope="col" class="px-4 py-2">Year</th>
            <th scope="col" class="px-4 py-2">Month</th>
            <th scope="col" class="px-4 py-2">Value</th>
            <th scope="col" class="px-4 py-2">Status</th>
            <th scope="col" class="px-4 py-2">Actions</th>
          </tr>
        </thead>
        <tbody id="entries-table-body"></tbody>
      </table>
      <p id="entries-empty" class="hidden p-4 text-sm text-gray-500">ไม่มีข้อมูล / No entries yet.</p>
    </div>
  </section>
</AdminLayout>

<script>
  import { requireAdminSession, requireRole, redirectIfNeeded } from '../../lib/admin/guard';
  import { createEntryService } from '../../lib/admin/entry-service';
  import { applyRoleNav } from '../../lib/admin/shell';
  import { formatAdminError } from '../../lib/admin/errors';
  import type { UserProfile } from '../../lib/repositories/profile-repository';
  import type { MonthlyMetricEntry } from '../../lib/supabase/types';

  const loadingEl = document.getElementById('entries-loading');
  const errorEl = document.getElementById('entries-error');
  const deniedEl = document.getElementById('entries-denied');
  const panelEl = document.getElementById('entries-panel');
  const metricSelect = document.getElementById('entry-metric') as HTMLSelectElement | null;
  const tableBody = document.getElementById('entries-table-body');
  const emptyEl = document.getElementById('entries-empty');
  const form = document.getElementById('entry-form') as HTMLFormElement | null;
  const editIdInput = document.getElementById('entry-edit-id') as HTMLInputElement | null;
  const formTitle = document.getElementById('entry-form-title');
  const saveBtn = document.getElementById('entry-save-btn');
  const cancelEditBtn = document.getElementById('entry-cancel-edit');

  const entryService = createEntryService();
  let metricLabelById = new Map<string, string>();

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      errorEl.focus();
    }
  }

  function clearEditMode() {
    if (editIdInput) editIdInput.value = '';
    if (formTitle) formTitle.textContent = 'สร้างร่าง / Create draft';
    if (saveBtn) saveBtn.textContent = 'บันทึกร่าง / Save draft';
    cancelEditBtn?.classList.add('hidden');
    metricSelect?.removeAttribute('disabled');
    (document.getElementById('entry-year') as HTMLInputElement | null)?.removeAttribute('readonly');
    (document.getElementById('entry-month') as HTMLInputElement | null)?.removeAttribute('readonly');
  }

  function startEdit(entry: MonthlyMetricEntry) {
    if (editIdInput) editIdInput.value = entry.id;
    if (metricSelect) metricSelect.value = entry.metric_type_id;
    (document.getElementById('entry-year') as HTMLInputElement).value = String(entry.year);
    (document.getElementById('entry-month') as HTMLInputElement).value = String(entry.month);
    (document.getElementById('entry-value') as HTMLInputElement).value = String(entry.value);
    (document.getElementById('entry-note') as HTMLTextAreaElement).value = entry.note ?? '';
    if (formTitle) {
      formTitle.textContent =
        entry.status === 'needs_revision'
          ? 'แก้ไขหลังส่งกลับ / Edit after revision request'
          : 'แก้ไขร่าง / Edit draft';
    }
    if (saveBtn) saveBtn.textContent = 'บันทึกการแก้ไข / Save changes';
    cancelEditBtn?.classList.remove('hidden');
    metricSelect?.setAttribute('disabled', 'true');
    (document.getElementById('entry-year') as HTMLInputElement).setAttribute('readonly', 'true');
    (document.getElementById('entry-month') as HTMLInputElement).setAttribute('readonly', 'true');
    form?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function statusBadge(status: string): string {
    const colors: Record<string, string> = {
      draft: 'bg-gray-100 text-gray-800',
      submitted: 'bg-blue-100 text-blue-800',
      needs_revision: 'bg-amber-100 text-amber-900',
      approved: 'bg-green-100 text-green-800',
    };
    const cls = colors[status] ?? 'bg-gray-100 text-gray-800';
    return `<span class="rounded px-2 py-0.5 text-xs ${cls}">${status}</span>`;
  }

  async function renderEntries(profile: UserProfile) {
    const entries = await entryService.listMyEntries(profile);
    if (!tableBody) return;
    tableBody.innerHTML = '';

    if (entries.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');

    for (const entry of entries) {
      const tr = document.createElement('tr');
      tr.className = 'border-t border-gray-100';
      const label = metricLabelById.get(entry.metric_type_id) ?? entry.metric_type_id;
      const editable = ['draft', 'needs_revision'].includes(entry.status);
      tr.innerHTML = `
        <td class="px-4 py-2">${label}</td>
        <td class="px-4 py-2">${entry.year}</td>
        <td class="px-4 py-2">${entry.month}</td>
        <td class="px-4 py-2">${entry.value}</td>
        <td class="px-4 py-2">${statusBadge(entry.status)}</td>
        <td class="px-4 py-2"><div class="flex flex-wrap gap-2"></div></td>
      `;
      const actions = tr.querySelector('td:last-child div');
      if (editable && actions) {
        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'text-xs underline text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded';
        editBtn.textContent = 'แก้ไข / Edit';
        editBtn.addEventListener('click', () => startEdit(entry));

        const submitBtn = document.createElement('button');
        submitBtn.type = 'button';
        submitBtn.className = 'text-xs underline text-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded';
        submitBtn.textContent = 'ส่งตรวจ / Submit';
        submitBtn.addEventListener('click', async () => {
          submitBtn.setAttribute('disabled', 'true');
          try {
            await entryService.submitDraft(profile, entry.id);
            clearEditMode();
            await renderEntries(profile);
          } catch (err) {
            showError(formatAdminError(err));
          } finally {
            submitBtn.removeAttribute('disabled');
          }
        });

        actions.appendChild(editBtn);
        actions.appendChild(submitBtn);
      } else if (entry.status === 'approved') {
        const span = document.createElement('span');
        span.className = 'text-xs text-gray-500';
        span.textContent = 'ล็อกแล้ว / Locked';
        actions?.appendChild(span);
      } else if (entry.status === 'submitted') {
        const span = document.createElement('span');
        span.className = 'text-xs text-gray-500';
        span.textContent = 'รอตรวจ / Pending review';
        actions?.appendChild(span);
      }
      tableBody.appendChild(tr);
    }
  }

  cancelEditBtn?.addEventListener('click', () => {
    form?.reset();
    clearEditMode();
  });

  void (async () => {
    const guard = await requireAdminSession();
    if (!guard.ok) {
      redirectIfNeeded(guard);
      loadingEl?.classList.add('hidden');
      return;
    }

    const profile = guard.profile!;
    applyRoleNav(profile);

    if (!requireRole(profile, ['staff', 'admin'])) {
      loadingEl?.classList.add('hidden');
      deniedEl?.classList.remove('hidden');
      return;
    }

    try {
      const assignable = await entryService.listAssignableMetrics(profile);
      metricLabelById = new Map(assignable.map((m) => [m.id, `${m.label_th} (${m.code})`]));
      if (metricSelect) {
        if (assignable.length === 0) {
          metricSelect.innerHTML = '<option value="">ไม่มีตัวชี้วัด / No assignable metrics</option>';
          saveBtn?.setAttribute('disabled', 'true');
        } else {
          metricSelect.innerHTML = assignable
            .map((m) => `<option value="${m.id}">${m.label_th} / ${m.label_en ?? m.code}</option>`)
            .join('');
        }
      }
      await renderEntries(profile);
      panelEl?.classList.remove('hidden');
    } catch (err) {
      showError(formatAdminError(err));
    } finally {
      loadingEl?.classList.add('hidden');
    }
  })();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    const guard = await requireAdminSession();
    if (!guard.ok || !guard.profile) {
      redirectIfNeeded(guard);
      return;
    }

    const metricTypeId = metricSelect?.value;
    const year = Number((document.getElementById('entry-year') as HTMLInputElement).value);
    const month = Number((document.getElementById('entry-month') as HTMLInputElement).value);
    const value = Number((document.getElementById('entry-value') as HTMLInputElement).value);
    const note = (document.getElementById('entry-note') as HTMLTextAreaElement).value.trim() || null;
    const editId = editIdInput?.value.trim();

    if (!metricTypeId) return;

    saveBtn?.setAttribute('disabled', 'true');
    saveBtn?.setAttribute('aria-busy', 'true');

    try {
      if (editId) {
        await entryService.updateDraft(guard.profile, editId, { value, note });
      } else {
        await entryService.createDraft(guard.profile, {
          metric_type_id: metricTypeId,
          year,
          month,
          value,
          note,
        });
      }
      form.reset();
      clearEditMode();
      await renderEntries(guard.profile);
    } catch (err) {
      showError(formatAdminError(err));
    } finally {
      saveBtn?.removeAttribute('disabled');
      saveBtn?.removeAttribute('aria-busy');
    }
  });
</script>
