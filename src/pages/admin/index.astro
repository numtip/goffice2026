---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Overview" activeNav="home">
  <div id="admin-loading" class="text-sm text-gray-600" aria-live="polite">กำลังโหลด… / Loading…</div>
  <div id="admin-error" class="hidden rounded border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert"></div>

  <section id="admin-home" class="hidden space-y-6">
    <div>
      <h1 class="text-2xl font-semibold text-primary">ภาพรวม / Overview</h1>
      <p id="admin-welcome" class="mt-1 text-sm text-gray-600"></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <a
        id="card-entries"
        href="../../admin/entries/"
        class="hidden rounded-lg border border-gray-200 bg-white p-4 shadow-sm hover:border-primary"
      >
        <h2 class="font-medium text-gray-900">บันทึกข้อมูล / Entries</h2>
        <p class="mt-1 text-sm text-gray-600">สร้างและส่งร่างข้อมูลรายเดือน / Create and submit monthly drafts</p>
      </a>
      <a
        id="card-review"
        href="../../admin/review/"
        class="hidden rounded-lg border border-gray-200 bg-white p-4 shadow-sm hover:border-primary"
      >
        <h2 class="font-medium text-gray-900">ตรวจสอบ / Review</h2>
        <p class="mt-1 text-sm text-gray-600">อนุมัติหรือส่งกลับรายการที่ส่งแล้ว / Approve or reject submitted entries</p>
      </a>
    </div>

    <p class="text-xs text-gray-500">
      Dashboard public mode remains static (`PUBLIC_DASHBOARD_DATA_MODE=static`). Admin uses local Supabase only.
    </p>
  </section>
</AdminLayout>

<script>
  import { requireAdminSession, redirectIfNeeded } from '../../lib/admin/guard';

  const loadingEl = document.getElementById('admin-loading');
  const errorEl = document.getElementById('admin-error');
  const homeEl = document.getElementById('admin-home');
  const welcomeEl = document.getElementById('admin-welcome');
  const entriesCard = document.getElementById('card-entries');
  const reviewCard = document.getElementById('card-review');
  const base = import.meta.env.BASE_URL ?? '/';

  void (async () => {
    const guard = await requireAdminSession();
    if (!guard.ok) {
      if (guard.reason === 'not_configured' && errorEl) {
        errorEl.textContent =
          'Supabase is not configured. Run supabase start and fill .env from supabase status -o env.';
        errorEl.classList.remove('hidden');
      } else {
        redirectIfNeeded(guard);
      }
      loadingEl?.classList.add('hidden');
      return;
    }

    const profile = guard.profile!;
    if (welcomeEl) {
      welcomeEl.textContent = `${profile.full_name ?? profile.email} · role: ${profile.role}`;
    }

    if (['staff', 'admin'].includes(profile.role)) {
      entriesCard?.classList.remove('hidden');
      if (entriesCard instanceof HTMLAnchorElement) {
        entriesCard.href = `${base}admin/entries/`.replace(/\/{2,}/g, '/');
      }
    }

    if (['reviewer', 'admin'].includes(profile.role)) {
      reviewCard?.classList.remove('hidden');
      if (reviewCard instanceof HTMLAnchorElement) {
        reviewCard.href = `${base}admin/review/`.replace(/\/{2,}/g, '/');
      }
    }

    loadingEl?.classList.add('hidden');
    homeEl?.classList.remove('hidden');
  })();
</script>
