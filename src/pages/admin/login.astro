---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Sign in">
  <section class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h1 class="text-xl font-semibold text-primary">เข้าสู่ระบบ / Sign in</h1>
    <p class="mt-1 text-sm text-gray-600">Local Supabase auth only — no cloud login.</p>

    <div id="login-config-error" class="mt-4 hidden rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900" role="alert"></div>
    <div id="login-error" class="mt-4 hidden rounded border border-red-300 bg-red-50 p-3 text-sm text-red-800" role="alert"></div>

    <form id="login-form" class="mt-6 space-y-4" novalidate>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">อีเมล / Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="username"
          required
          class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700">รหัสผ่าน / Password</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        />
      </div>
      <button
        type="submit"
        id="login-submit"
        class="w-full rounded bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary-800 disabled:opacity-50"
      >
        เข้าสู่ระบบ / Sign in
      </button>
    </form>
    <p id="login-loading" class="mt-4 hidden text-sm text-gray-500" aria-live="polite">กำลังโหลด… / Loading…</p>
  </section>
</AdminLayout>

<script>
  import { signInWithPassword } from '../../lib/supabase/auth';
  import { getSupabaseAvailability } from '../../lib/supabase/client';
  import { redirectFromLoginIfAuthenticated } from '../../lib/admin/guard';

  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('login-error');
  const configErrorEl = document.getElementById('login-config-error');
  const loadingEl = document.getElementById('login-loading');
  const submitBtn = document.getElementById('login-submit') as HTMLButtonElement | null;

  const availability = getSupabaseAvailability();
  if (!availability.configured || !availability.clientReady) {
    if (configErrorEl) {
      configErrorEl.textContent =
        'ยังไม่ได้ตั้งค่า Supabase — คัดลอกคีย์จาก supabase status -o env ไปยัง .env / Supabase not configured — copy keys from supabase status -o env to .env';
      configErrorEl.classList.remove('hidden');
    }
    submitBtn?.setAttribute('disabled', 'true');
  } else {
    redirectFromLoginIfAuthenticated();
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');
    loadingEl?.classList.remove('hidden');
    submitBtn?.setAttribute('disabled', 'true');

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const password = String(data.get('password') ?? '');

    try {
      await signInWithPassword(email, password);
      const base = import.meta.env.BASE_URL ?? '/';
      window.location.href = `${base}admin/`.replace(/\/{2,}/g, '/');
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Sign-in failed';
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
      }
    } finally {
      loadingEl?.classList.add('hidden');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
