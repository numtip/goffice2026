---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Review" activeNav="review">
  <div id="review-loading" class="text-sm text-gray-600" aria-live="polite">กำลังโหลด… / Loading…</div>
  <div id="review-error" class="hidden rounded border border-red-300 bg-red-50 p-4 text-sm text-red-800" role="alert"></div>
  <div id="review-denied" class="hidden rounded border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900" role="alert">
    ไม่มีสิทธิ์เข้าถึง / Access denied — reviewer or admin only.
  </div>

  <section id="review-panel" class="hidden space-y-6">
    <div>
      <h1 class="text-2xl font-semibold text-primary">ตรวจสอบ / Review</h1>
      <p class="mt-1 text-sm text-gray-600">อนุมัติหรือส่งกลับรายการที่ส่งแล้ว (ตามตัวชี้วัดที่มอบหมาย) / Approve or reject submitted entries for assigned metrics.</p>
    </div>

    <div id="review-queue" class="space-y-4" role="list"></div>
    <p id="review-empty" class="hidden text-sm text-gray-500">ไม่มีรายการรอตรวจ / No submitted entries in your queue.</p>
  </section>
</AdminLayout>

<script>
  import { requireAdminSession, requireRole, redirectIfNeeded } from '../../lib/admin/guard';
  import { createReviewRepository } from '../../lib/repositories/review-repository';
  import { createMetricsRepository } from '../../lib/repositories/metrics-repository';
  import { applyRoleNav } from '../../lib/admin/shell';
  import { formatAdminError } from '../../lib/admin/errors';
  import type { UserProfile } from '../../lib/repositories/profile-repository';

  const loadingEl = document.getElementById('review-loading');
  const errorEl = document.getElementById('review-error');
  const deniedEl = document.getElementById('review-denied');
  const panelEl = document.getElementById('review-panel');
  const queueEl = document.getElementById('review-queue');
  const emptyEl = document.getElementById('review-empty');

  const reviewRepo = createReviewRepository();
  const metricsRepo = createMetricsRepository();
  const actingIds = new Set<string>();

  function showError(message: string) {
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function setCardBusy(card: HTMLElement, busy: boolean) {
    card.querySelectorAll('button, textarea').forEach((el) => {
      if (busy) {
        el.setAttribute('disabled', 'true');
      } else {
        el.removeAttribute('disabled');
      }
    });
    card.setAttribute('aria-busy', busy ? 'true' : 'false');
  }

  async function renderQueue(profile: UserProfile) {
    if (!queueEl) return;
    queueEl.innerHTML = '';

    const [entries, metricTypes] = await Promise.all([
      reviewRepo.listSubmittedEntries(),
      metricsRepo.listMetricTypes(),
    ]);
    const labelById = new Map(metricTypes.map((m) => [m.id, `${m.label_th} (${m.code})`]));

    if (entries.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');

    for (const entry of entries) {
      const card = document.createElement('article');
      card.className = 'rounded-lg border border-gray-200 bg-white p-4 shadow-sm space-y-3';
      card.setAttribute('role', 'listitem');
      const label = labelById.get(entry.metric_type_id) ?? entry.metric_type_id;
      card.innerHTML = `
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <h2 class="font-medium text-gray-900">${label}</h2>
            <p class="text-sm text-gray-600">${entry.year} / month ${entry.month} · value ${entry.value}</p>
          </div>
          <span class="rounded bg-blue-100 px-2 py-0.5 text-xs text-blue-800">${entry.status}</span>
        </div>
        <label class="block text-sm">
          <span class="font-medium">ความคิดเห็น / Comment <span class="text-gray-500 font-normal">(จำเป็นเมื่อส่งกลับ / required for revision)</span></span>
          <textarea class="review-comment mt-1 w-full rounded border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" rows="2" aria-label="Review comment"></textarea>
        </label>
        <div class="flex flex-wrap gap-2"></div>
      `;

      const actions = card.querySelector('div:last-child');
      const commentInput = card.querySelector('.review-comment') as HTMLTextAreaElement | null;

      const approveBtn = document.createElement('button');
      approveBtn.type = 'button';
      approveBtn.className = 'rounded bg-primary px-3 py-1.5 text-sm text-white hover:bg-primary-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      approveBtn.textContent = 'อนุมัติ / Approve';

      const rejectBtn = document.createElement('button');
      rejectBtn.type = 'button';
      rejectBtn.className = 'rounded border border-gray-300 px-3 py-1.5 text-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';
      rejectBtn.textContent = 'ส่งกลับแก้ไข / Request revision';

      async function runAction(action: 'approve' | 'reject') {
        if (actingIds.has(entry.id)) return;
        actingIds.add(entry.id);
        setCardBusy(card, true);
        errorEl?.classList.add('hidden');

        try {
          const comment = commentInput?.value.trim() ?? '';
          if (action === 'reject' && !comment) {
            showError('กรุณาระบุความคิดเห็นเมื่อส่งกลับแก้ไข / Comment is required when requesting revision.');
            return;
          }
          if (comment) {
            await reviewRepo.addComment(entry.id, comment, profile.id);
          }
          await reviewRepo.transitionEntryStatus(
            entry.id,
            action === 'approve' ? 'approved' : 'needs_revision',
            profile.id,
          );
          card.remove();
          actingIds.delete(entry.id);
          if (queueEl && queueEl.children.length === 0) {
            emptyEl?.classList.remove('hidden');
          }
        } catch (err) {
          showError(formatAdminError(err));
          setCardBusy(card, false);
          actingIds.delete(entry.id);
        }
      }

      approveBtn.addEventListener('click', () => void runAction('approve'));
      rejectBtn.addEventListener('click', () => void runAction('reject'));

      actions?.appendChild(approveBtn);
      actions?.appendChild(rejectBtn);
      queueEl.appendChild(card);
    }
  }

  void (async () => {
    const guard = await requireAdminSession();
    if (!guard.ok) {
      redirectIfNeeded(guard);
      loadingEl?.classList.add('hidden');
      return;
    }

    const profile = guard.profile!;
    applyRoleNav(profile);

    if (!requireRole(profile, ['reviewer', 'admin'])) {
      loadingEl?.classList.add('hidden');
      deniedEl?.classList.remove('hidden');
      return;
    }

    try {
      await renderQueue(profile);
      panelEl?.classList.remove('hidden');
    } catch (err) {
      showError(formatAdminError(err));
    } finally {
      loadingEl?.classList.add('hidden');
    }
  })();
</script>
