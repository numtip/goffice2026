---
import ContentDetailPage from '../../components/content/ContentDetailPage.astro';
import activitiesData from '../../data/content/activities.json';

export function getStaticPaths() {
  return activitiesData.items
    .filter((item) => item.status === 'published')
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
---

<ContentDetailPage
  item={item}
  locale="th"
  hubRoute="/activities"
  hubLabelTh="กิจกรรม"
  hubLabelEn="Activities"
/>
