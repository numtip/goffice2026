---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import indicatorsData from '../../data/criteria/indicators.json';
import categoriesData from '../../data/criteria/categories.json';
import issuesData from '../../data/criteria/issues.json';
import { getLocale } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';
import { getLocalizedPath } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const isEn = locale === 'en';
const path = (p: string) => (isEn ? getLocalizedPath('en', p) : withBase(p));

const categories = categoriesData.categories;
const issues = issuesData.issues;
const indicators = indicatorsData.indicators;

const issueTitleById = new Map(issues.map((i) => [i.id, i.title]));

const grouped = categories.map((cat) => ({
  cat,
  indicators: indicators.filter((ind) => ind.categoryCode === cat.code),
}));

const pageTitle = isEn ? 'Indicators | Green Office' : 'ตัวชี้วัด | สำนักงานสีเขียว';
const heading = isEn ? 'Assessment indicators' : 'ตัวชี้วัดการประเมิน';
const subtitle = isEn
  ? 'Browse all 65 Green Office indicators by code, title, or category. Use search to jump to a specific indicator.'
  : 'เรียกดูตัวชี้วัดสำนักงานสีเขียว 65 รายการตามรหัส ชื่อ หรือหมวดหมู่ — ใช้ช่องค้นหาเพื่อไปยังตัวชี้วัดที่ต้องการ';
---

<BaseLayout title={pageTitle} description={subtitle} locale={locale}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6" data-go-evidence-1="indicators-hub">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">{heading}</h1>
      <p class="mt-2 text-gray-600 max-w-2xl">{subtitle}</p>
    </header>

    <form method="get" action={path('/indicators/')} class="mb-8" role="search">
      <label for="indicator-q" class="sr-only">
        {isEn ? 'Search indicators' : 'ค้นหาตัวชี้วัด'}
      </label>
      <div class="flex flex-col sm:flex-row gap-3">
        <input
          id="indicator-q"
          name="q"
          type="search"
          value=""
          autocomplete="off"
          placeholder={isEn ? 'Code or title (e.g. 3.2.2)' : 'รหัสหรือชื่อ (เช่น 3.2.2)'}
          class="flex-1 rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
        />
        <button
          type="submit"
          class="rounded-lg bg-green-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
        >
          {isEn ? 'Search' : 'ค้นหา'}
        </button>
      </div>
      <p class="mt-2 text-xs text-gray-500">
        {isEn
          ? 'Works without JavaScript via form submit; optional live filter when scripts are enabled.'
          : 'ใช้งานได้โดยไม่ต้องมี JavaScript ผ่านการส่งฟอร์ม — กรองแบบทันทีเมื่อเปิดสคริปต์'}
      </p>
    </form>

    <div id="indicator-hub-list">
      {grouped.map(({ cat, indicators: catIndicators }) => {
        const catTitle = isEn ? cat.title.en : cat.title.th;
        return (
          <section class="mb-10" aria-labelledby={`cat-${cat.code}`}>
            <h2 id={`cat-${cat.code}`} class="text-lg font-semibold text-gray-800 mb-4">
              <a
                href={path(`/categories/${cat.code}`)}
                class="text-green-800 hover:text-green-950 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
              >
                {catTitle}
              </a>
            </h2>
            <ul class="space-y-2" role="list">
              {catIndicators.map((ind) => {
                const issue = issueTitleById.get(ind.issueCode);
                const searchBlob = [
                  ind.code,
                  ind.title.th,
                  ind.title.en,
                  ind.requirementSummary.th,
                  ind.requirementSummary.en,
                  catTitle,
                  issue?.th,
                  issue?.en,
                ]
                  .filter(Boolean)
                  .join(' ')
                  .toLowerCase();
                const title = isEn ? ind.title.en || ind.title.th : ind.title.th || ind.title.en;
                return (
                  <li
                    class="indicator-hub-row rounded-lg border border-gray-100 bg-white px-4 py-3 shadow-sm"
                    data-search={searchBlob}
                    data-code={ind.code}
                  >
                    <a
                      href={path(`/indicators/${ind.code}/`)}
                      class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                    >
                      <span class="font-mono text-sm font-semibold text-green-800">{ind.code}</span>
                      <span class="text-sm text-gray-800">{title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>

    <p id="indicator-hub-empty" class="hidden text-center text-gray-500 py-8" role="status">
      {isEn ? 'No indicators match your search.' : 'ไม่พบตัวชี้วัดที่ตรงกับคำค้นหา'}
    </p>
  </div>

  <script is:inline>
    const input = document.getElementById('indicator-q');
    const rows = Array.from(document.querySelectorAll('.indicator-hub-row'));
    const empty = document.getElementById('indicator-hub-empty');
    const sections = Array.from(document.querySelectorAll('#indicator-hub-list section'));
    const urlQuery = new URLSearchParams(window.location.search).get('q') || '';

    function applyFilter(raw) {
      const q = (raw || '').trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const blob = row.getAttribute('data-search') || '';
        const code = (row.getAttribute('data-code') || '').toLowerCase();
        const match = !q || blob.includes(q) || code === q || code.startsWith(q);
        row.classList.toggle('hidden', !match);
        if (match) visible += 1;
      }
      for (const section of sections) {
        const any = section.querySelector('.indicator-hub-row:not(.hidden)');
        section.classList.toggle('hidden', !any);
      }
      empty?.classList.toggle('hidden', visible > 0);
    }

    if (input && urlQuery) input.value = urlQuery;
    applyFilter(urlQuery || (input ? input.value : ''));
    input?.addEventListener('input', () => applyFilter(input.value));
  </script>
</BaseLayout>
