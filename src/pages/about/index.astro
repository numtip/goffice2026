---
import AboutPageShell from '../../components/about/AboutPageShell.astro';
import AboutHubDocs from '../../components/about/AboutHubDocs.astro';
import AboutNotice from '../../components/about/AboutNotice.astro';
import AboutCanonicalFacts from '../../components/about/AboutCanonicalFacts.astro';
import aboutContent from '../../data/about/content.json';
import { getLocale } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const isTh = locale === 'th';
const content = aboutContent.pages['about-index'];
---

<AboutPageShell pageId="about-index">
  <AboutNotice noticeTh={content.noticeTh} noticeEn={content.noticeEn} isTh={isTh} />

  <AboutCanonicalFacts pageId="about-index" isTh={isTh} />

  {content.sections
    .filter((section) => !section.links)
    .map((section) => (
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-3">
          {isTh ? section.headingTh : section.headingEn}
        </h2>
        <p class="text-gray-700 leading-relaxed">{isTh ? section.bodyTh : section.bodyEn}</p>
      </section>
    ))}

  <AboutHubDocs isTh={isTh} />
</AboutPageShell>
