---
import AboutPageShell from '../../components/about/AboutPageShell.astro';
import AboutNotice from '../../components/about/AboutNotice.astro';
import aboutContent from '../../data/about/content.json';
import summaries from '../../data/about/document-summaries.json';
import documents from '../../data/about/documents.json';
import { getLocale, getLocalizedPath } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const isTh = locale === 'th';
const content = aboutContent.pages['about-feedback'];

function summaryFor(key: string) {
  return summaries.summaries.find((s) => s.documentId === key);
}

function docFor(key: string) {
  return documents.documents.find((d) => d.id === key);
}

function safeKeyPoints(points: string[] | undefined) {
  if (!points) return [];
  return points.filter(
    (pt) => !/@/.test(pt) && !/\(\d[\d\s-]{5,}\)/.test(pt) && !/Contains personal email/i.test(pt),
  );
}
---

<AboutPageShell pageId="about-feedback">
  <div slot="notice" class="not-prose mb-6 space-y-3">
    <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900">
      {isTh
        ? '🔒 เอกสารอ้างอิงมีข้อมูลติดต่อส่วนบุคคล — หน้านี้ไม่เผยแพร่อีเมลหรือเบอร์โทรศัพท์ รายละเอียดช่องทางติดต่อมีเอกสารภายในองค์กร'
        : '🔒 The reference document contains personal contact details — this page does not publish email or phone numbers. Contact channels are documented internally.'}
    </div>
    <AboutNotice noticeTh={content.noticeTh} noticeEn={content.noticeEn} isTh={isTh} />
  </div>

  <p class="text-sm text-gray-500 mb-6">
    {isTh ? 'ตัวชี้วัดที่เกี่ยวข้อง' : 'Related indicators'}:
    {content.relatedIndicators.map((code) => (
      <a href={getLocalizedPath(locale, `/indicators/${code}`)} class="ml-2 text-green-700 hover:underline">{code}</a>
    ))}
  </p>

  {content.sections.map((section) => {
    const summary = summaryFor(section.summaryKey ?? '');
    const doc = docFor(section.summaryKey ?? '');
    const keyPoints = safeKeyPoints(summary?.keyPoints);
    return (
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-2">
          {isTh ? section.headingTh : section.headingEn}
        </h2>
        {summary && (
          <>
            <p class="text-gray-700 leading-relaxed whitespace-pre-line">{summary.summaryTh}</p>
            {keyPoints.length > 0 && (
              <ul class="mt-3 list-disc pl-5 space-y-1 text-gray-600 text-sm">
                {keyPoints.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            )}
            <p class="mt-3 text-sm text-gray-600 italic">
              {isTh
                ? 'รายละเอียดช่องทางติดต่อ (อีเมล/โทรศัพท์) มีเอกสารภายในองค์กร — ไม่เผยแพร่บนหน้านี้'
                : 'Contact channel details (email/phone) are documented internally — not published on this page.'}
            </p>
          </>
        )}
        {doc && (
          <p class="mt-3 text-sm text-gray-500">
            {isTh ? 'เอกสารอ้างอิง' : 'Reference document'}: {doc.filename}
            <span class="ml-2 inline-block rounded bg-gray-100 px-2 py-0.5 text-xs">
              {doc.pageCount} {isTh ? 'หน้า' : 'pages'}
            </span>
          </p>
        )}
      </section>
    );
  })}
</AboutPageShell>
