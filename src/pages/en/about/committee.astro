---
import AboutPageShell from '../../../components/about/AboutPageShell.astro';
import aboutContent from '../../../data/about/content.json';
import summaries from '../../../data/about/document-summaries.json';
import documents from '../../../data/about/documents.json';
import { getLocale, getLocalizedPath } from '../../../i18n/utils';

const locale = getLocale(Astro.url);
const isTh = locale === 'th';
const content = aboutContent.pages['about-committee'];

function summaryFor(key: string) {
  return summaries.summaries.find((s) => s.documentId === key);
}

function docFor(key: string) {
  return documents.documents.find((d) => d.id === key);
}
---

<AboutPageShell pageId="about-committee">
  <div slot="notice" class="not-prose mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    {isTh ? content.noticeTh : content.noticeEn}
  </div>

  <p class="text-sm text-gray-500 mb-6">
    {isTh ? 'ตัวชี้วัดที่เกี่ยวข้อง' : 'Related indicators'}:
    {content.relatedIndicators.map((code) => (
      <a href={getLocalizedPath(locale, `/indicators/${code}`)} class="ml-2 text-green-700 hover:underline">{code}</a>
    ))}
  </p>

  {content.sections.map((section) => {
    const summary = summaryFor(section.summaryKey ?? '');
    const doc = docFor(section.summaryKey ?? '');
    const isDuplicate = summary?.reviewStatus === 'DUPLICATE_FILE_NEEDS_REVIEW';
    const isOcr = summary?.reviewStatus === 'OCR_DERIVED_NEEDS_VERIFICATION';
    return (
      <section class="mb-8">
        <h2 class="text-xl font-semibold text-gray-900 mb-2">
          {isTh ? section.headingTh : section.headingEn}
        </h2>
        {(section.pending || isDuplicate) && (
          <p class="text-sm text-amber-700 mb-2">
            {isTh ? '⚠️ เอกสารซ้ำ — รอยืนยัน' : '⚠️ Duplicate document — confirmation pending'}
          </p>
        )}
        {isOcr && (
          <p class="text-sm text-amber-700 mb-2">
            {isTh ? '⚠️ สรุปจาก OCR — ต้องตรวจสอบโดยมนุษย์' : '⚠️ OCR-derived summary — human verification required'}
          </p>
        )}
        {summary && (
          <>
            <p class="text-gray-700 leading-relaxed whitespace-pre-line">
              {isTh ? summary.summaryTh : (summary.summaryEn ?? summary.summaryTh)}
            </p>
            {summary.keyPoints && (
              <ul class="mt-3 list-disc pl-5 space-y-1 text-gray-600 text-sm">
                {summary.keyPoints.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            )}
          </>
        )}
        {doc && (
          <p class="mt-3 text-sm text-gray-500">
            {isTh ? 'เอกสารอ้างอิง' : 'Reference document'}: {doc.filename}
          </p>
        )}
      </section>
    );
  })}

  <section class="mt-8 rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-600">
    <p>
      {isTh
        ? '⏳ รูปถ่ายคณะกรรมการและแผนผังองค์กรยังไม่มี'
        : '⏳ Committee photo and org chart not yet available'}
    </p>
  </section>
</AboutPageShell>
