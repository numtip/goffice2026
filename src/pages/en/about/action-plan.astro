---
import AboutPageShell from '../../../components/about/AboutPageShell.astro';
import ActionPlanExperience from '../../../components/about/action-plan/ActionPlanExperience.astro';
import aboutContent from '../../../data/about/content.json';
import { getLocale, getLocalizedPath } from '../../../i18n/utils';

const locale = getLocale(Astro.url);
const isTh = locale === 'th';
const content = aboutContent.pages['about-action-plan'];
---

<AboutPageShell pageId="about-action-plan">
  <div slot="notice" class="not-prose mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900">
    {isTh ? content.noticeTh : content.noticeEn}
  </div>

  <p class="text-sm text-gray-500 mb-6 not-prose">
    {isTh ? 'ตัวชี้วัดที่เกี่ยวข้อง' : 'Related indicators'}:
    {content.relatedIndicators.map((code) => (
      <a href={getLocalizedPath(locale, `/indicators/${code}`)} class="ml-2 text-green-700 hover:underline">{code}</a>
    ))}
  </p>

  <ActionPlanExperience isTh={isTh} />
</AboutPageShell>
