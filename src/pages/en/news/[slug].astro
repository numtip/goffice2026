---
import ContentDetailPage from '../../../components/content/ContentDetailPage.astro';
import newsData from '../../../data/content/news.json';

export function getStaticPaths() {
  return newsData.items
    .filter((item) => item.status === 'published')
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
---

<ContentDetailPage
  item={item}
  locale="en"
  hubRoute="/news"
  hubLabelTh="ข่าวสาร"
  hubLabelEn="News"
/>
