---
interface Props {
  title?: string;
}

const { title = 'Sign in' } = Astro.props;
---

<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Green Office Admin</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <a
      href="#login-main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:shadow focus:outline-none focus:ring-2 focus:ring-primary"
    >
      ข้ามไปเนื้อหา / Skip to content
    </a>
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-md px-4 py-4">
        <p class="text-sm font-semibold text-primary">Green Office 2026</p>
        <p class="text-xs text-gray-600">ระบบจัดการข้อมูล / Data Admin (local)</p>
      </div>
    </header>
    <main id="login-main" class="mx-auto max-w-md px-4 py-6">
      <slot />
    </main>
  </body>
</html>
