---
import { getLocalizedPath } from '../../i18n/utils';
import type { HomeHeroStrings } from '../../i18n/dictionary';
import {
  heroCinematicVideoUrl,
  landingHeroPosterDimensions,
  landingHeroPosterSrcSet,
  landingHeroPosterUrl,
} from '../../utils/wow2-images';

interface Props {
  locale?: 'th' | 'en';
  t?: HomeHeroStrings;
}

const { locale = 'th' } = Astro.props;
const t = Astro.props.t ?? {
  badge: 'Environmental Intelligence Platform',
  title_line1: 'Green Office 2026',
  title_line2: 'A Green Office driven by data, action, and verifiable evidence',
  description: 'Monitor, measure, and report environmental performance for certification.',
  cta_dashboard: 'Explore Dashboard',
  cta_categories: 'Explore Categories',
  cta_evidence: 'Browse Evidence Library',
  coverage_label: 'FY 2569 monthly data coverage',
  coverage_caption: 'Month slots with data — not a certification score',
  coverage_unit: 'months',
  evidence_label: 'Evidence ready',
} as HomeHeroStrings;
---

<header
  class="group relative flex min-h-[52vh] items-center justify-center overflow-hidden sm:min-h-[68vh] lg:min-h-[80vh]"
  aria-labelledby="landing-hero-title"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <picture class="absolute inset-0 block h-full w-full">
      <source type="image/webp" srcset={landingHeroPosterSrcSet} sizes="100vw" />
      <img
        src={landingHeroPosterUrl}
        alt=""
        class="hero-bg-zoom h-full w-full object-cover object-[center_42%] transition-transform duration-[2s] ease-out group-hover:scale-105"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={landingHeroPosterDimensions.w}
        height={landingHeroPosterDimensions.h}
      />
    </picture>
    <video
      class="hero-bg-cinematic absolute inset-0 h-full w-full object-cover object-[center_42%]"
      data-hero-cinematic
      data-src={heroCinematicVideoUrl}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      tabindex="-1"
      aria-hidden="true"
    ></video>
    <div class="absolute inset-0 z-[2] bg-gradient-to-b from-[#001a12]/70 via-[#001a12]/60 to-[#001a12]/82"></div>
  </div>

  <div class="landing-stagger relative z-10 mx-auto w-full max-w-4xl px-4 pt-20 pb-12 text-center sm:px-6 sm:pt-24 sm:pb-16 md:px-8 lg:pt-28 lg:pb-20">
    <p class="landing-reveal mb-3 text-sm font-medium text-white/85 sm:mb-4 sm:text-base md:text-lg">
      {t.title_line1}
    </p>
    <h1
      id="landing-hero-title"
      class="landing-reveal mx-auto mb-4 max-w-3xl text-balance text-2xl font-bold leading-[1.2] tracking-tight text-emerald-300 sm:mb-5 sm:text-3xl sm:leading-[1.18] md:text-4xl lg:text-[2.75rem] lg:leading-[1.16]"
    >
      {t.title_line2}
    </h1>
    <p class="landing-reveal mx-auto mb-8 max-w-xl text-sm leading-relaxed text-white/80 sm:mb-10 sm:text-base">
      {t.description}
    </p>

    <div class="landing-reveal flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href={getLocalizedPath(locale, '/dashboard')}
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-emerald-500 px-6 py-3.5 text-label-sm font-semibold uppercase tracking-wider text-white shadow-lg shadow-emerald-500/25 transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-emerald-400 hover:shadow-xl hover:shadow-emerald-500/30 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 motion-reduce:transform-none sm:px-8 sm:py-4"
      >
        {t.cta_dashboard}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a
        href={getLocalizedPath(locale, '/evidence')}
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-white/30 bg-transparent px-6 py-3.5 text-label-sm font-semibold uppercase tracking-wider text-white transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-white/50 hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 motion-reduce:transform-none sm:px-8 sm:py-4"
      >
        {t.cta_evidence}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const DESKTOP_MQ = '(min-width: 768px)';
  const REDUCE_MQ = '(prefers-reduced-motion: reduce)';

  function canLoadHeroVideo(): boolean {
    if (window.matchMedia(REDUCE_MQ).matches) return false;
    if (!window.matchMedia(DESKTOP_MQ).matches) return false;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    if (connection?.saveData) return false;
    return true;
  }

  function initHeroCinematic() {
    const video = document.querySelector<HTMLVideoElement>('[data-hero-cinematic]');
    if (!video || video.dataset.heroBound === 'true') return;
    if (!canLoadHeroVideo()) return;

    const src = video.dataset.src;
    if (!src) return;

    video.dataset.heroBound = 'true';

    const reveal = () => {
      video.classList.add('is-ready');
    };

    video.addEventListener('playing', reveal, { once: true });
    video.addEventListener('canplay', () => {
      video.play().then(reveal).catch(() => {
        /* autoplay blocked — poster remains */
      });
    }, { once: true });

    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.loop = true;
    video.preload = 'metadata';
    video.setAttribute('playsinline', '');
    video.src = src;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCinematic);
  } else {
    initHeroCinematic();
  }
</script>
