---
import ResourcePerformanceCard from '../dashboard/ResourcePerformanceCard.astro';
import { getLocalizedPath } from '../../i18n/utils';
import type { HomeExecutiveKpiStrings } from '../../i18n/dictionary';
import { resourceIconMap, resourceAccentMap } from '../../utils/wow2-images';
import { resolveDisplayStatus, shouldShowYoy } from '../../utils/data-status';
import { dashboards, dashTitle } from '../../data/dashboard-config';
import criteriaCategories from '../../data/criteria/categories.json';
import criteriaIndicators from '../../data/criteria/indicators.json';
import type { MultiYearMetric } from '../../utils/multi-year-schema';

interface Props {
  locale: 'th' | 'en';
  t: HomeExecutiveKpiStrings;
  coveredMonthSlots: number;
  totalMonthSlots: number;
  genMap: Record<string, MultiYearMetric>;
}

const { locale, t, coveredMonthSlots, totalMonthSlots, genMap } = Astro.props;

const fmtCompact = (v: number) =>
  Intl.NumberFormat(locale === 'th' ? 'th' : 'en', { notation: 'compact', maximumFractionDigits: 1 }).format(v);

const resourceIds = ['energy', 'water', 'fuel', 'paper', 'waste', 'ghg'] as const;

// Real readiness stats derived from canonical/generated data (no invented scores).
const dataReadinessPct = totalMonthSlots > 0 ? Math.round((coveredMonthSlots / totalMonthSlots) * 100) : 0;
const categoryCount = criteriaCategories.categories.length;
const issueCount = new Set(criteriaIndicators.indicators.map((i) => i.issueCode)).size;
const indicatorTotal = criteriaIndicators.indicators.length;

const resourceCards = resourceIds.map((id) => {
  const d = dashboards.find((dd) => dd.id === id)!;
  const m = genMap[id] as MultiYearMetric | undefined;
  const yoy = m?.yoyChange;
  const current = m ? m.years[m.currentYear.toString()] : undefined;
  const baseline = m ? m.years[m.baselineYear.toString()] : undefined;
  const displayStatus = resolveDisplayStatus(current);
  const showYoy = shouldShowYoy(current);
  const monthsCount = current?.months?.length ?? 0;
  const partialYear = displayStatus === 'in_progress' && monthsCount < 12;
  const hasData = displayStatus !== 'pending' && displayStatus !== 'missing';

  return {
    title: dashTitle(d, locale),
    href: getLocalizedPath(locale, `/dashboard/${d.id}`),
    currentValue: hasData ? fmtCompact(current!.total) : (locale === 'th' ? 'รอข้อมูล' : 'Pending'),
    baselineValue: baseline ? fmtCompact(baseline.total) : '-',
    unit: m?.unit ?? d.kpiUnit ?? '',
    trendPct: showYoy && yoy ? yoy.percent : (null as number | null),
    trendDir: (yoy?.direction ?? 'stable') as 'up' | 'down' | 'stable',
    monthsCompleted: monthsCount,
    statusLabel: monthsCount > 0
      ? (locale === 'th' ? `${monthsCount} จาก 12 เดือน` : `${monthsCount} of 12 months`)
      : (locale === 'th' ? 'รอข้อมูล' : 'Data Pending'),
    partialYear,
    monthlyValues: current?.months?.map((mo) => mo.value) ?? [],
    iconUrl: resourceIconMap[id],
    accentColor: resourceAccentMap[id],
    color: d.color,
  };
});
---

<section
  id="executive-kpi-preview"
  class="landing-section relative bg-surface"
  aria-labelledby="executive-kpi-heading"
>
  <div class="landing-container">
    <div class="landing-reveal mx-auto mb-8 max-w-2xl text-center sm:mb-10">
      <h2
        id="executive-kpi-heading"
        class="landing-heading font-bold text-balance"
      >
        {t.heading}
      </h2>
      <p class="mt-3 text-body-md leading-relaxed text-on-surface-variant sm:mt-4 sm:text-body-lg">
        {t.subtitle}
      </p>
    </div>

    <dl class="landing-stagger mx-auto mb-10 grid max-w-3xl grid-cols-1 gap-3 sm:mb-12 sm:grid-cols-2 sm:gap-4">
      <div class="landing-reveal rounded-stitch border border-outline-variant/20 bg-surface-container p-4 text-left shadow-sm sm:p-5">
        <dt class="text-label-sm text-outline">
          {t.score_environmental}
        </dt>
        <dd class="mt-1 font-semibold text-primary">
          <span class="num-tabular text-2xl tracking-tight sm:text-3xl">{coveredMonthSlots}</span>
          <span class="text-base text-on-surface-variant">/{totalMonthSlots} {locale === 'th' ? 'เดือน' : 'months'}</span>
        </dd>
        <p class="mt-1 text-xs text-on-surface-variant">
          ({dataReadinessPct}%) {locale === 'th' ? 'ปีงบประมาณ 2569' : 'FY 2569'}
        </p>
      </div>

      <div class="landing-reveal rounded-stitch border border-outline-variant/20 bg-surface-container p-4 text-left shadow-sm sm:p-5">
        <dt class="text-label-sm text-outline">
          {t.score_categories}
        </dt>
        <dd class="mt-1 font-semibold text-primary">
          <span class="num-tabular text-2xl tracking-tight sm:text-3xl">{categoryCount}</span>
          <span class="text-base text-on-surface-variant">{locale === 'th' ? ' หมวด' : ' categories'}</span>
        </dd>
        <p class="mt-1 text-xs text-on-surface-variant">
          {issueCount} {locale === 'th' ? 'ประเด็น' : 'issues'} · {indicatorTotal} {locale === 'th' ? 'ตัวชี้วัด' : 'indicators'}
        </p>
      </div>
    </dl>

    <!-- Resource KPI cards -->
    <div class="landing-stagger grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {resourceCards.map((card) => (
        <div class="landing-reveal">
          <ResourcePerformanceCard
          title={card.title}
          href={card.href}
          currentValue={card.currentValue}
          baselineValue={card.baselineValue}
          unit={card.unit}
          trendPct={card.trendPct}
          trendDir={card.trendDir}
          monthsCompleted={card.monthsCompleted}
          statusLabel={card.statusLabel}
          partialYear={card.partialYear}
          monthlyValues={card.monthlyValues.length >= 2 ? card.monthlyValues : undefined}
          iconUrl={card.iconUrl}
          accentColor={card.accentColor}
          color={card.color}
        />
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="landing-reveal mt-8 text-center sm:mt-12">
      <a
        href={getLocalizedPath(locale, '/dashboard')}
        class="landing-btn-ghost min-h-11 text-primary hover:bg-surface-container-high"
      >
        {t.cta_dashboard}
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
