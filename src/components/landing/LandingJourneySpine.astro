---
import { getLocalizedPath } from '../../i18n/utils';
import type { HomeNavStrings, HomeSpineStrings } from '../../i18n/dictionary';

interface Props {
  locale: 'th' | 'en';
  nav: HomeNavStrings;
  t: HomeSpineStrings;
}

const { locale, nav, t } = Astro.props;

const stops = [
  { step: '1', href: '/dashboard', title: nav.dashboard, desc: t.performance_desc },
  { step: '2', href: '/evidence', title: nav.evidence, desc: t.evidence_desc },
  { step: '3', href: '/knowledge', title: nav.knowledge ?? (locale === 'th' ? 'ความรู้' : 'Knowledge'), desc: t.knowledge_desc },
] as const;
---

<nav class="border-t-2 border-primary/40 border-b border-outline-variant/30 bg-surface-container-lowest shadow-sm" aria-label={t.aria}>
  <ol class="landing-stagger mx-auto grid max-w-5xl grid-cols-1 gap-2 px-4 py-4 sm:grid-cols-3 sm:divide-x sm:divide-outline-variant/30 sm:gap-0 sm:px-6 sm:py-5">
    {stops.map((stop, index) => (
      <li class="landing-reveal list-none sm:px-3 first:sm:pl-0 last:sm:pr-0">
        <a
          href={getLocalizedPath(locale, stop.href)}
          class:list={[
            'focus-ring flex min-h-11 items-center gap-3 rounded-stitch px-3 py-2 text-left transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-white motion-reduce:transform-none',
            index === 0 && 'bg-white ring-1 ring-primary/15',
          ]}
        >
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white" aria-hidden="true">
            {stop.step}
          </span>
          <span class="min-w-0">
            <span class="block text-base font-bold tracking-tight text-on-surface sm:text-lg">{stop.title}</span>
            <span class="block text-xs leading-snug text-on-surface-variant sm:text-sm">{stop.desc}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>
