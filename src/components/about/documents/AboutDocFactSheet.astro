---
interface Fact {
  label: string;
  value: string;
}

interface Props {
  facts: Fact[];
}

const { facts } = Astro.props;
---

<section aria-labelledby="about-doc-facts" class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
  <h2 id="about-doc-facts" class="sr-only">Document facts</h2>
  <dl class="grid gap-3 sm:grid-cols-2">
    {facts.filter((f) => f.value).map((f) => (
      <div class="rounded-md bg-gray-50 px-3 py-2">
        <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">{f.label}</dt>
        <dd class="mt-0.5 text-sm text-gray-800 whitespace-pre-line">{f.value}</dd>
      </div>
    ))}
  </dl>
</section>
