---
interface Summary {
  documentId?: string;
  summaryTh?: string;
  summaryEn?: string;
  keyPoints?: string[];
  extractedFromPages?: string;
}

interface Doc {
  id?: string;
  filename?: string;
  pageCount?: number;
}

interface Section {
  headingTh: string;
  headingEn: string;
  summaryKey?: string;
  historical?: boolean;
}

interface Props {
  sections: Section[];
  isTh: boolean;
  summaries: Summary[];
  documents: Doc[];
}

const { sections, isTh, documents, summaries } = Astro.props;

function summaryFor(key?: string) {
  return summaries.find((s) => s.documentId === key);
}

function docFor(key?: string) {
  return documents.find((d) => d.id === key);
}

const refLabel = isTh ? 'เอกสารอ้างอิง' : 'Reference document';
const pagesLabel = isTh ? 'หน้า' : 'pages';
---

{sections.map((section) => {
  const summary = summaryFor(section.summaryKey ?? '');
  const doc = docFor(section.summaryKey ?? '');
  return (
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">
        {isTh ? section.headingTh : section.headingEn}
      </h2>
      {summary && (
        <p class="text-gray-700 leading-relaxed whitespace-pre-line">
          {isTh ? summary.summaryTh : (summary.summaryEn ?? summary.summaryTh)}
        </p>
      )}
      {summary?.keyPoints && !isTh && summary.keyPoints.length > 0 && (
        <ul class="mt-3 list-disc pl-5 space-y-1 text-gray-600 text-sm">
          {summary.keyPoints.map((pt) => (
            <li>{pt}</li>
          ))}
        </ul>
      )}
      {doc && (
        <p class="mt-3 text-sm text-gray-500">
          {refLabel}: {doc.filename}
          {doc.pageCount && (
            <span class="ml-2 inline-block rounded bg-gray-100 px-2 py-0.5 text-xs">
              {doc.pageCount} {pagesLabel}
            </span>
          )}
        </p>
      )}
    </section>
  );
})}
