---
/**
 * AboutCanonicalFacts — FY2569 foundation facts from CAT1 overlay contracts (primary),
 * with FY2568 historical baseline panels. About pages show organizational views;
 * indicator pages show assessment journeys.
 */
import {
  buildScopeView2569,
  buildPolicyApproval2569,
  buildPolicyCommitments2569,
  buildTargetBoard2569,
  buildAnnualPlanView2569,
  buildCommitteeFoundation2569,
  buildAppointmentAuthority2569,
  buildOrganizationCoverage2569,
  buildCommitteeGroups2569,
  CAT1_FY2569_YEAR,
  CAT11_DOCS_2569,
} from '../../utils/category1-fy2569-presentation';
import {
  buildScopeView,
  buildPolicyApproval,
  buildPolicyCommitments,
  buildPolicyInterviewGap,
  buildTargetBoard,
  buildAnnualPlanView,
  CAT1_YEAR,
  CAT11_DOCS,
} from '../../utils/category1-foundation-presentation';
import {
  buildCommitteeFoundation,
  buildAppointmentAuthority,
  buildOrganizationCoverage,
  buildCommitteeGroups,
  buildRoleUnderstandingGap,
  COMMITTEE_EVIDENCE,
} from '../../utils/category1-committee-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  pageId: string;
  isTh: boolean;
}

const { pageId, isTh } = Astro.props;
const locale = isTh ? 'th' : 'en';
const path = (p: string) => getLocalizedPath(locale, p);
const doc = (p: string) => withBase(p);

function t(th: string, en: string): string {
  return isTh ? th : en;
}
---

{pageId === 'about-index' && (
  <section
    class="not-prose mb-8 rounded-xl border border-green-100 bg-green-50/40 p-5"
    aria-labelledby="about-foundation-flow"
    data-about-foundation-hub
  >
    <p class="text-xs font-semibold uppercase tracking-wide text-green-800">
      {t(`ศูนย์รากฐานการบริหาร · FY${CAT1_FY2569_YEAR} (ปัจจุบัน)`, `Management foundation hub · FY${CAT1_FY2569_YEAR} (current)`)}
    </p>
    <h2 id="about-foundation-flow" class="mt-1 text-lg font-bold text-gray-900">
      {t('Scope → Policy → Goals → Plan → Governance', 'Scope → Policy → Goals → Plan → Governance')}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-gray-700">
      {t(
        'หน้า About แสดงมุมมององค์กรจากสัญญาข้อมูล CAT1 (ปี 2569 เป็นหลัก ปี 2568 เป็นฐาน) — ไม่สร้างชุดข้อมูลแยก',
        'About pages present organizational views from the CAT1 contracts (FY2569 primary, FY2568 baseline) — no duplicate datasets',
      )}
    </p>
    <ol class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
      {[
        { route: '/about/scope/', code: '1.1.1', th: 'ขอบเขต', en: 'Scope' },
        { route: '/about/policy/', code: '1.1.2', th: 'นโยบาย', en: 'Policy' },
        { route: '/about/goals/', code: '1.1.3', th: 'เป้าหมาย', en: 'Goals' },
        { route: '/about/action-plan/', code: '1.1.4', th: 'แผนปฏิบัติการ', en: 'Action plan' },
        { route: '/about/committee/', code: '1.2.1', th: 'ธรรมาภิบาล', en: 'Governance' },
      ].map((item) => (
        <li class="list-none rounded-lg border border-white/80 bg-white/70 px-3 py-2 text-sm">
          <a href={path(item.route)} class="font-medium text-green-800 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t(item.th, item.en)}
          </a>
          <span class="text-gray-500"> · {item.code}</span>
        </li>
      ))}
    </ol>
    <p class="mt-3 text-xs text-amber-800">
      {t(
        'ตัวชี้วัด 1.2.2 (ความเข้าใจบทบาท) — หลักฐานสัมภาษณ์ยัง MISSING ทั้งปี 2568 และ 2569',
        'Indicator 1.2.2 (role understanding) — interview evidence still MISSING for both FY2568 and FY2569',
      )}
    </p>
  </section>
)}

{pageId === 'about-scope' && (() => {
  const scope = buildScopeView2569();
  const baseline = buildScopeView();
  return (
    <section class="not-prose mb-8 space-y-4" data-about-canonical-facts="1.1.1" data-cat1-year={CAT1_FY2569_YEAR}>
      <div class="rounded-xl border border-green-100 bg-green-50/40 p-5">
        <p class="text-xs font-semibold text-green-800">{t(`FY${CAT1_FY2569_YEAR} (ปีปัจจุบัน)`, `FY${CAT1_FY2569_YEAR} (current year)`)}</p>
        <ul class="mt-3 grid gap-2 text-sm text-gray-800 sm:grid-cols-2" role="list">
          <li><strong>{t('พื้นที่รวม', 'Total area')}:</strong> {scope.totalSqm.toLocaleString()} m²</li>
          <li><strong>{t('บุคลากร', 'Personnel')}:</strong> {scope.personnelCount}</li>
          <li><strong>{t('หน่วยงาน', 'Organizations')}:</strong> {scope.organizationCount}</li>
          <li><strong>{t('ประกาศ', 'Announced')}:</strong> {scope.announcementDateBE}</li>
        </ul>
        <ul class="mt-3 space-y-1 text-sm text-gray-700" role="list">
          {scope.organizations.map((o) => (
            <li>{isTh ? o.nameTh : o.nameEn} ({o.personnelCount})</li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-gray-600">{isTh ? scope.proseNoteTh : scope.proseNoteEn}</p>
        <p class="mt-2 text-xs">
          <a href={path('/indicators/1.1.1/')} class="text-green-700 hover:underline">{t('ดูตัวชี้วัด 1.1.1', 'View indicator 1.1.1')}</a>
          {' · '}
          <a href={doc(CAT11_DOCS_2569.scopePdf)} class="text-green-700 hover:underline">{t('PDF 2569', 'FY2569 PDF')}</a>
        </p>
      </div>
      <details class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t(`ฐานประวัติ FY${CAT1_YEAR}`, `FY${CAT1_YEAR} historical baseline`)}
        </summary>
        <div class="mt-3 space-y-2 text-sm text-gray-700">
          <p><strong>{t('พื้นที่รวม', 'Total area')}:</strong> {baseline.totalSqm.toLocaleString()} m² · <strong>{t('หน่วยงาน', 'Organizations')}:</strong> {baseline.organizationCount}</p>
          <ul class="space-y-1" role="list">
            {baseline.organizations.map((o) => (
              <li>{isTh ? o.nameTh : o.nameEn}</li>
            ))}
          </ul>
          <p class="text-xs text-gray-600">{isTh ? baseline.roomInventoryNoteTh : baseline.roomInventoryNoteEn}</p>
          <p class="text-xs">
            <a href={doc(CAT11_DOCS.scopePdf)} class="text-green-700 hover:underline">{t('PDF 2568', 'FY2568 PDF')}</a>
          </p>
        </div>
      </details>
    </section>
  );
})()}

{pageId === 'about-policy' && (() => {
  const approval = buildPolicyApproval2569();
  const commitments = buildPolicyCommitments2569();
  const gap = buildPolicyInterviewGap();
  return (
    <section class="not-prose mb-8 space-y-4" data-about-canonical-facts="1.1.2" data-cat1-year={CAT1_FY2569_YEAR}>
      <div class="rounded-xl border border-green-100 bg-green-50/40 p-5">
        <p class="text-xs font-semibold text-green-800">{t(`FY${CAT1_FY2569_YEAR} (ปีปัจจุบัน)`, `FY${CAT1_FY2569_YEAR} (current year)`)}</p>
        <ul class="mt-3 space-y-2 text-sm text-gray-800" role="list">
          <li><strong>{t('ข้อนโยบาย', 'Commitments')}:</strong> {commitments.length}</li>
          <li><strong>{t('ลงนาม/ประกาศ', 'Signed/announced')}:</strong> {approval.announcementDateBE}</li>
          <li><strong>{t('ลงนามโดย', 'Signed by')}:</strong> {isTh ? approval.signedByRoleTh : approval.signedByRoleEn}</li>
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-blue-800">{isTh ? approval.authorityNoteTh : approval.authorityNoteEn}</p>
        <p class="mt-2 text-xs">
          <a href={path('/indicators/1.1.2/')} class="text-green-700 hover:underline">{t('ดูตัวชี้วัด 1.1.2', 'View indicator 1.1.2')}</a>
          {' · '}
          <a href={doc(CAT11_DOCS_2569.policyPdf)} class="text-green-700 hover:underline">{t('PDF 2569', 'FY2569 PDF')}</a>
        </p>
      </div>
      <div class="rounded-xl border border-amber-100 bg-amber-50/50 p-4">
        <p class="text-sm font-medium text-amber-900">{t('1.1.2(4) สัมภาษณ์ผู้บริหาร', '1.1.2(4) Management interview')}</p>
        <p class="mt-1 text-xs text-amber-800">{isTh ? gap.noteTh : gap.noteEn}</p>
      </div>
    </section>
  );
})()}

{pageId === 'about-goals' && (() => {
  const targets = buildTargetBoard2569();
  return (
    <section class="not-prose mb-8 space-y-4" data-about-canonical-facts="1.1.3" data-cat1-year={CAT1_FY2569_YEAR}>
      <div class="rounded-xl border border-green-100 bg-green-50/40 p-5">
        <p class="text-xs font-semibold text-green-800">{t(`FY${CAT1_FY2569_YEAR} (ปีปัจจุบัน) · เปรียบเทียบปี 2568`, `FY${CAT1_FY2569_YEAR} (current year) · vs FY2568`)}</p>
        <p class="mt-2 text-xs text-gray-600">
          {t(
            'เป้าหมายเป็น % การเปลี่ยนแปลงต่อปีจากปีฐาน 2568 — ค่าประกาศแยกครอบครัวตัวชี้วัด GHG',
            'Targets are year-over-year % change from the FY2568 base — GHG uses a separate announcement metric family',
          )}
        </p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2" role="list">
          {targets.map((tg) => (
            <li class="list-none rounded-lg border border-white bg-white/80 px-3 py-2 text-sm">
              <span class="font-medium">{isTh ? tg.labelTh : tg.labelEn}</span>
              <span class="ml-2 num-tabular text-green-800">{tg.targetPercent}%</span>
              {tg.ocrNote && (
                <p class="mt-1 text-xs text-amber-800">{isTh ? tg.ocrNote : tg.ocrNote}</p>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs">
          <a href={path('/indicators/1.1.3/')} class="text-green-700 hover:underline">{t('ดูตัวชี้วัด 1.1.3', 'View indicator 1.1.3')}</a>
          {' · '}
          <a href={doc(CAT11_DOCS_2569.targetsPdf)} class="text-green-700 hover:underline">{t('PDF 2569', 'FY2569 PDF')}</a>
        </p>
      </div>
    </section>
  );
})()}

{pageId === 'about-action-plan' && (() => {
  const plan = buildAnnualPlanView2569();
  const baseline = buildAnnualPlanView();
  return (
    <section class="not-prose mb-8 space-y-4" data-about-canonical-facts="1.1.4" data-cat1-year={CAT1_FY2569_YEAR} data-proj-plan-id={plan.id}>
      <div class="rounded-xl border border-blue-100 bg-blue-50/40 p-5">
        <p class="text-xs font-semibold text-blue-900">{t(`FY${CAT1_FY2569_YEAR} (ปีปัจจุบัน) · ${plan.id}`, `FY${CAT1_FY2569_YEAR} (current year) · ${plan.id}`)}</p>
        <p class="mt-2 text-sm font-medium text-gray-900">{plan.title}</p>
        <ul class="mt-3 space-y-1 text-sm text-gray-800" role="list">
          <li>{t('แผนลายลักษณ์อักษร', 'Written plan')}: {plan.writtenPlan ? '✓' : '—'}</li>
          <li>{t('อนุมัติ', 'Approved')}: {plan.executiveApproved ? '✓' : '—'} ({plan.approvalDateBE})</li>
          <li>{t('ครอบคลุมหมวด', 'Category coverage')}: {plan.categoryCoverage} · {t('กิจกรรม', 'activities')}: {plan.activityCount}</li>
          <li>{t('แผน/ผลแยกคอลัมน์', 'Plan/actual columns')}: {plan.plannedVsActualSeparate ? '✓' : '—'}</li>
        </ul>
        <p class="mt-3 text-xs text-gray-600">{isTh ? plan.planTableNoteTh : plan.planTableNoteEn}</p>
        {plan.sharedWith161 && (
          <p class="mt-2 text-xs text-gray-600">{t('บันทึกร่วมกับ 1.6.1', 'Shared record with 1.6.1')}</p>
        )}
        <p class="mt-2 text-xs">
          <a href={path('/indicators/1.1.4/')} class="text-blue-800 hover:underline">{t('ดูตัวชี้วัด 1.1.4', 'View indicator 1.1.4')}</a>
          {' · '}
          <a href={doc(CAT11_DOCS_2569.planXlsx)} class="text-blue-800 hover:underline">{t('Excel 2569', 'FY2569 Excel')}</a>
        </p>
      </div>
      <details class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 focus-visible:ring-offset-2 rounded">
          {t(`ฐานประวัติ FY${CAT1_YEAR} · ${baseline.id}`, `FY${CAT1_YEAR} historical baseline · ${baseline.id}`)}
        </summary>
        <div class="mt-3 space-y-1 text-sm text-gray-800">
          <p>{baseline.title}</p>
          <p class="text-xs text-gray-600">{isTh ? baseline.planTableNoteTh : baseline.planTableNoteEn}</p>
          <p class="text-xs">
            <a href={doc(CAT11_DOCS.planPdf)} class="text-blue-800 hover:underline">{t('PDF 2568', 'FY2568 PDF')}</a>
          </p>
        </div>
      </details>
    </section>
  );
})()}

{pageId === 'about-committee' && (() => {
  const foundation = buildCommitteeFoundation2569();
  const authority = buildAppointmentAuthority2569();
  const orgs = buildOrganizationCoverage2569();
  const groups = buildCommitteeGroups2569();
  const gap = buildRoleUnderstandingGap();
  const baselineFoundation = buildCommitteeFoundation();
  const baselineAuth = buildAppointmentAuthority();
  const baselineGroups = buildCommitteeGroups();
  return (
    <section class="not-prose mb-8 space-y-4" data-about-canonical-facts="1.2.1" data-cat1-year={CAT1_FY2569_YEAR}>
      <div class="rounded-xl border border-green-100 bg-green-50/40 p-5">
        <p class="text-xs font-semibold text-green-800">{t(`FY${CAT1_FY2569_YEAR} (ปีปัจจุบัน)`, `FY${CAT1_FY2569_YEAR} (current year)`)}</p>
        <ul class="mt-3 space-y-1 text-sm text-gray-800" role="list">
          <li><strong>{t('ลงนาม', 'Signed by')}:</strong> {isTh ? authority.signedByRoleTh : authority.signedByRoleEn}</li>
          <li><strong>{t('วันที่', 'Date')}:</strong> {authority.dateBE}</li>
          <li><strong>{t('หน่วยงาน', 'Organizations')}:</strong> {foundation.organizationCount}</li>
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-blue-800">{isTh ? foundation.structureChangeNoteTh : foundation.structureChangeNoteEn}</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2 text-sm" role="list">
          {orgs.map((o) => (
            <li class="list-none rounded border border-white bg-white/80 px-2 py-1">
              {isTh ? o.nameTh : o.nameEn}: <span class="num-tabular font-medium">{o.personnelCount}</span>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-gray-600">{isTh ? authority.orderRefNoteTh : authority.orderRefNoteEn}</p>
        <p class="mt-2 text-xs">
          <a href={path('/indicators/1.2.1/')} class="text-green-700 hover:underline">{t('ดูตัวชี้วัด 1.2.1', 'View indicator 1.2.1')}</a>
          {' · '}
          <a href={doc(CAT11_DOCS_2569.committeePdf)} class="text-green-700 hover:underline">{t('คำสั่ง 2569 (PDF)', 'FY2569 order (PDF)')}</a>
        </p>
      </div>
      <div class="rounded-xl border border-gray-100 bg-white p-5">
        <h3 class="text-sm font-bold text-gray-900">{t('โครงสร้างคณะกรรมการ 2569', 'FY2569 governance structure')}</h3>
        <ul class="mt-3 space-y-2 text-sm" role="list">
          {groups.map((g) => (
            <li class="list-none rounded-lg border border-gray-100 bg-gray-50/50 px-3 py-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-medium">{isTh ? g.labelTh : g.labelEn}</span>
                {g.memberCount != null && <span class="text-xs font-semibold text-green-800">{g.memberCount} {t('คน', 'ppl')}</span>}
              </div>
              {g.combinedGroup && <span class="text-xs text-green-700">{t('(รวมกลุ่ม)', '(combined)')}</span>}
              <span class="mt-1 block text-xs text-gray-600">{g.categoryCodes.join(', ')}</span>
            </li>
          ))}
        </ul>
      </div>
      <details class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t(`ฐานประวัติ FY${CAT1_YEAR}`, `FY${CAT1_YEAR} historical baseline`)}
        </summary>
        <div class="mt-3 space-y-2 text-sm text-gray-800">
          <p>
            {t(
              `ลงนาม ${baselineAuth.dateBE} โดย ${baselineAuth.signedByRoleTh} · ${baselineFoundation.organizationCount} หน่วยงาน`,
              `Signed ${baselineAuth.dateBE} by ${baselineAuth.signedByRoleEn} · ${baselineFoundation.organizationCount} orgs`,
            )}
          </p>
          <ul class="space-y-1" role="list">
            {baselineGroups.map((g) => (
              <li>
                {isTh ? g.labelTh : g.labelEn}
                {g.combinedGroup ? ` (${t('รวมกลุ่ม', 'combined')})` : ''}
              </li>
            ))}
          </ul>
          <p class="text-xs">
            <a href={doc(COMMITTEE_EVIDENCE.orderPdf)} class="text-green-700 hover:underline">{t('คำสั่งแต่งตั้ง (RAE order)', 'Appointment order (RAE order)')}</a>
          </p>
        </div>
      </details>
      <div class="rounded-xl border border-dashed border-amber-200 bg-amber-50/50 p-4" data-cat1-status="MISSING">
        <p class="text-sm font-medium text-amber-900">{t('1.2.2 ความเข้าใจบทบาท', '1.2.2 Role understanding')}</p>
        <p class="mt-1 text-xs text-amber-800">{isTh ? gap.noteTh : gap.noteEn}</p>
        <p class="mt-2 text-xs">
          <a href={path('/indicators/1.2.2/')} class="text-amber-900 hover:underline">{t('ดูช่องหลักฐาน 1.2.2', 'View 1.2.2 evidence gap')}</a>
        </p>
      </div>
    </section>
  );
})()}
