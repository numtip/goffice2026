---
import pagesMeta from '../../data/about/pages.json';
import documentsData from '../../data/about/documents.json';
import aboutDocuments from '../../data/about/about-documents.json';
import { getLocale, getLocalizedPath } from '../../i18n/utils';

interface Props {
  isTh: boolean;
  order?: string[];
}

type PageDocMap = Record<string, { primaryDocumentId?: string | null; documents: string[]; targets?: { th: string; en: string }[] } | undefined>;

const { isTh } = Astro.props;
const locale = getLocale(Astro.url);
const allDocs = documentsData.documents;

const order = Astro.props.order ?? ['about-policy', 'about-goals', 'about-scope', 'about-committee', 'about-action-plan', 'about-feedback'];

const cards = order
  .map((pageId) => {
    const meta = pagesMeta.pages.find((p) => p.id === pageId);
    const pageDocs = (aboutDocuments.pages as PageDocMap)[pageId];
    const primaryId = pageDocs?.primaryDocumentId;
    const doc = primaryId ? allDocs.find((d) => d.id === primaryId) : null;
    if (!meta) return null;
    return {
      pageId,
      title: isTh ? meta.titleTh : meta.titleEn,
      description: isTh ? meta.descriptionTh : meta.descriptionEn,
      href: getLocalizedPath(locale, meta.route.replace(/\/$/, '') || '/about'),
      docTitle: doc ? (isTh ? doc.titleTh : (doc.titleEn ?? doc.titleTh)) : '',
      docYear: doc?.documentYear ?? null,
      docPages: doc?.pageCount ?? null,
      signed: doc?.signed ?? false,
    };
  })
  .filter((c) => c !== null);

const labels = {
  heading: isTh ? 'เอกสารนโยบายและหลักฐาน' : 'Policy documents and evidence',
  docLabel: isTh ? 'เอกสาร' : 'Document',
  pages: isTh ? 'หน้า' : 'pages',
  signed: isTh ? 'ลงนาม' : 'Signed',
  view: isTh ? 'เปิดหน้า' : 'Open page',
};
---

<section aria-labelledby="about-hub-docs">
  <h2 id="about-hub-docs" class="text-xl font-semibold tracking-tight text-gray-900 mb-3">{labels.heading}</h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {cards.map((card) => (
      <li>
        <a
          href={card.href}
          class="group block h-full rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:border-green-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
        >
          <span class="flex items-center justify-between gap-2">
            <span class="text-base font-semibold tracking-tight text-gray-900">{card.title}</span>
            <span class="text-sm text-green-700 transition-transform group-hover:translate-x-0.5">{labels.view} →</span>
          </span>
          {card.docTitle && (
            <span class="mt-1 block text-sm text-gray-600">{card.docTitle}</span>
          )}
          <span class="mt-3 flex flex-wrap gap-2 text-xs">
            {card.docYear && (
              <span class="rounded-full bg-blue-50 px-2 py-0.5 text-blue-900">พ.ศ. {card.docYear}</span>
            )}
            {card.docPages && (
              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-gray-700">
                {card.docPages} {labels.pages}
              </span>
            )}
            {card.signed && (
              <span class="rounded-full bg-green-50 px-2 py-0.5 text-green-900">{labels.signed}</span>
            )}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
