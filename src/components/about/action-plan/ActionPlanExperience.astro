---
import actionPlan from '../../../data/generated/action-plan-2569.json';
import ActionPlanActivityCard from './ActionPlanActivityCard.astro';
import actionPlanScript from '../../../scripts/action-plan-v2.mjs?url';

interface Props {
  isTh: boolean;
}

const { isTh } = Astro.props;
const { summary, categories, months, source, titleTh } = actionPlan;

const timelineActual = Object.fromEntries(months.map((m) => [m.id, 0]));
const timelinePlanned = summary.timelinePlanned as Record<string, number>;
for (const cat of categories) {
  for (const act of cat.activities) {
    for (const a of act.actualMonths) {
      timelineActual[a.monthId] = (timelineActual[a.monthId] ?? 0) + 1;
    }
  }
}
const maxPlan = Math.max(...Object.values(summary.timelinePlanned), 1);
const maxActual = Math.max(...Object.values(timelineActual), 1);

function searchBlob(catTitle: string, activity: (typeof categories)[0]['activities'][0]) {
  return [activity.activityTh, catTitle, activity.frequency, activity.responsible]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();
}

const labels = {
  summaryTitle: isTh ? 'ภาพรวมแผนปฏิบัติการ 2569' : 'FY2569 action plan overview',
  categories: isTh ? 'หมวด' : 'Categories',
  plannedMarks: isTh ? 'จุดวางแผนรายเดือน (/)' : 'Monthly plan marks (/)',
  withActual: isTh ? 'กิจกรรมที่มีผล/วันที่ในแฟ้ม' : 'Activities with actual/result in workbook',
  timelineTitle: isTh ? 'ไทม์ไลน์รายปี (Gantt)' : 'Annual timeline (Gantt)',
  categoriesTitle: isTh ? '7 หมวด 24 ประเด็น 65 ตัวชี้วัด' : '7 categories, 24 issues and 65 indicators',
  downloadTitle: isTh ? 'ดาวน์โหลดไฟล์ Excel ต้นฉบับ' : 'Download original Excel workbook',
  downloadHint: isTh
    ? 'ไฟล์เดียวกับที่ใช้สร้างข้อมูลบนหน้านี้ — ไม่มีการแก้ไขเนื้อหา'
    : 'Same file used to generate this page — content unchanged.',
  downloadBtn: isTh ? 'ดาวน์โหลด green-office-action-plan-2569.xlsx' : 'Download green-office-action-plan-2569.xlsx',
  monthCount: isTh ? 'กิจกรรม' : 'activities',
  indicatorCount: isTh ? 'ตัวชี้วัด' : 'indicators',
  filterLabel: isTh ? 'กรองหมวด' : 'Filter category',
  filterAll: isTh ? 'ทั้งหมด' : 'All',
  searchLabel: isTh ? 'ค้นหากิจกรรม' : 'Search activities',
  searchPlaceholder: isTh
    ? 'ชื่อกิจกรรม หมวด ความถี่ ผู้รับผิดชอบ…'
    : 'Activity, category, frequency, responsible…',
  resultCount: isTh ? 'แสดง {n} กิจกรรม' : 'Showing {n} activities',
  emptySearch: isTh ? 'ไม่พบกิจกรรมที่ตรงกับตัวกรองหรือคำค้น' : 'No activities match your filter or search.',
  categoryNav: isTh ? 'ไปยังหมวด' : 'Jump to category',
  print: isTh ? 'พิมพ์แผน' : 'Print plan',
  langNotice: isTh
    ? ''
    : 'Activity descriptions remain in Thai as in the source workbook.',
  ganttPlan: isTh ? 'แผน (จำนวนกิจกรรมที่วางแผนในเดือน)' : 'Plan (activities scheduled per month)',
  ganttResult: isTh ? 'ผล (รายการจากแฟ้มงานในเดือน)' : 'Result (workbook entries per month)',
  legendPlan: isTh ? 'แผน' : 'Plan',
  legendResult: isTh ? 'ผล' : 'Result',
  legendTitle: isTh ? 'สัญลักษณ์ของแผนรายปี' : 'Annual plan legend',
  legendPlanDetail: isTh ? 'กิจกรรมที่วางแผนไว้ในเดือนนั้น' : 'activities planned for that month',
  legendResultDetail: isTh
    ? 'ผล/วันที่จริงที่บันทึกจากแฟ้มงานในเดือนนั้น'
    : 'actual results/dates recorded from the workbook that month',
  legendNone: isTh ? 'ไม่มีกิจกรรมในเดือนนั้น' : 'no activity that month',
  legendHint: isTh
    ? 'แถบสีแสดงสถานะของแต่ละเดือน: เขียว = มีแผน น้ำเงิน = มีผลลัพธ์ในแฟ้มงาน เทา = ไม่มีกิจกรรมในเดือนนั้น'
    : 'Bar colors show each month\u2019s status: green = planned, blue = result recorded in the workbook, gray = no activity that month.',
  timelineExplain: isTh
    ? 'ไทม์ไลน์นี้แสดงจำนวนกิจกรรมตลอด 12 เดือน: แถวบนคือจำนวนกิจกรรมที่วางแผนในแต่ละเดือน ส่วนแถวล่างคือจำนวนรายการผล/วันที่ที่บันทึกจริงจากแฟ้มงานของเดือนนั้น'
    : 'This timeline shows activity counts across the 12 months: the top row is how many activities are planned each month, the bottom row is how many actual results/dates were recorded from the workbook that month.',
  categoriesExplain: isTh
    ? 'หน้าแผนปฏิบัติการนี้ครอบคลุม 7 หมวด 24 ประเด็น 65 ตัวชี้วัด สำหรับหน่วยงานขอต่ออายุการรับรองหรือขอยกระดับการรับรอง (หมวดที่ 7 ใช้สำหรับการต่ออายุ/ยกระดับเท่านั้น) — ทุกกิจกรรมจัดอยู่ในหมวดใดหมวดหนึ่งตามโครงสร้างของแผน'
    : 'This action plan covers 7 categories, 24 issues and 65 indicators, for renewal or certification-level upgrade (Category 7 applies to renewal/upgrade only) — every activity belongs to one of these categories.',
  activitiesExplain: isTh
    ? 'การ์ดกิจกรรมแต่ละใบแสดงรหัสตัวชี้วัด (ถ้ามี) หมายเลขงาน ความถี่ ผู้รับผิดชอบ และแถบแผน/ผลรายเดือน'
    : 'Each activity card shows the indicator code (if any), task number, frequency, responsible person, and a monthly plan/result strip.',
};

const summaryCards = [
  { label: labels.categories, value: String(summary.categoryCount) },
  { label: labels.indicatorCount, value: String(categories.reduce((s, c) => s + (c.indicatorCount ?? 0), 0)) },
  { label: labels.plannedMarks, value: String(summary.plannedMonthMarks) },
  { label: labels.withActual, value: String(summary.activitiesWithActualMonths) },
];
---

<section
  id="action-plan-root"
  class="not-prose space-y-10"
  data-action-plan-root
  aria-labelledby="action-plan-hero"
>
  <div id="action-plan-hero" class="rounded-xl border border-green-100 bg-gradient-to-br from-green-50 to-white p-6">
    <p class="text-sm font-medium text-green-800">{isTh ? 'ปีงบประมาณ' : 'Fiscal year'} {summary.fiscalYear}</p>
    <h2 class="mt-1 text-2xl font-bold text-gray-900">{labels.summaryTitle}</h2>
    <p class="mt-2 max-w-3xl text-gray-700 whitespace-pre-line">{titleTh}</p>
    {!isTh && labels.langNotice && (
      <p class="mt-3 text-sm text-gray-600 border-t border-green-100 pt-3">{labels.langNotice}</p>
    )}
  </div>

  <section aria-labelledby="ap-summary-cards">
    <h2 id="ap-summary-cards" class="sr-only">{labels.summaryTitle}</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {summaryCards.map((card) => (
        <li class="rounded-lg border border-gray-200 bg-white p-4 text-center shadow-sm">
          <p class="text-2xl font-bold text-green-700">{card.value}</p>
          <p class="mt-1 text-xs text-gray-600 sm:text-sm">{card.label}</p>
        </li>
      ))}
    </ul>
  </section>

  <div class="ap-no-print space-y-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end">
      <div class="min-w-[10rem] flex-1">
        <label for="ap-search" class="block text-sm font-medium text-gray-700">{labels.searchLabel}</label>
        <input
          type="search"
          id="ap-search"
          name="ap-search"
          autocomplete="off"
          placeholder={labels.searchPlaceholder}
          class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600/30"
        />
      </div>
      <div class="min-w-[10rem]">
        <label for="ap-category-filter" class="block text-sm font-medium text-gray-700">{labels.filterLabel}</label>
        <select
          id="ap-category-filter"
          name="ap-category-filter"
          class="mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600/30"
        >
          <option value="all">{labels.filterAll}</option>
          {categories.map((cat) => (
            <option value={cat.id}>
              {isTh ? `หมวด ${cat.number}` : `Category ${cat.number}`}: {cat.titleTh.slice(0, 40)}
              {cat.titleTh.length > 40 ? '…' : ''}
            </option>
          ))}
        </select>
      </div>
      <button
        type="button"
        id="ap-print"
        class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
      >
        {labels.print}
      </button>
    </div>
    <p id="ap-result-count" class="text-sm text-gray-600" data-template={labels.resultCount} role="status">
      {labels.resultCount.replace('{n}', String(summary.activityCount))}
    </p>
    <p id="ap-empty" class="rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-900" hidden>
      {labels.emptySearch}
    </p>
  </div>

  <nav class="ap-no-print" aria-label={labels.categoryNav}>
    <ul class="flex flex-wrap gap-2">
      {categories.map((cat) => (
        <li>
          <a
            href={`#${cat.id}`}
            class="inline-block rounded-full border border-green-200 bg-green-50 px-3 py-1 text-sm text-green-900 hover:bg-green-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
          >
            {isTh ? `หมวด ${cat.number}` : `Cat. ${cat.number}`}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <section aria-labelledby="ap-timeline">
    <h2 id="ap-timeline" class="text-lg font-semibold text-gray-900 mb-2">{labels.timelineTitle}</h2>
    <fieldset class="mb-3 rounded-md bg-gray-50 px-3 py-2">
      <legend class="sr-only">{labels.legendTitle}</legend>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-gray-600">
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 shrink-0 rounded-sm bg-green-600" aria-hidden="true"></span>
          <span><span class="font-medium text-gray-800">{labels.legendPlan}</span> — {labels.legendPlanDetail}</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 shrink-0 rounded-sm bg-blue-600" aria-hidden="true"></span>
          <span><span class="font-medium text-gray-800">{labels.legendResult}</span> — {labels.legendResultDetail}</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="inline-block h-3 w-3 shrink-0 rounded-sm bg-gray-300" aria-hidden="true"></span>
          <span>{labels.legendNone}</span>
        </li>
      </ul>
      <p class="mt-1.5 text-xs text-gray-500">{labels.legendHint}</p>
    </fieldset>
    <p class="mb-3 flex items-start gap-2 text-sm text-gray-600">
      <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{labels.timelineExplain}</span>
    </p>
    <div class="ap-gantt-summary overflow-x-auto print:overflow-visible">
      <div class="min-w-0 print:min-w-0" role="table" aria-label={labels.timelineTitle}>
        <div class="grid grid-cols-[5rem_repeat(12,minmax(1.5rem,1fr))] gap-px text-[10px] sm:text-xs">
          <div class="p-1 font-medium text-gray-500" role="columnheader"></div>
          {months.map((m) => (
            <div class="p-1 text-center font-medium text-gray-700" role="columnheader">{m.labelTh}</div>
          ))}
          <div class="flex items-center p-1 font-medium text-green-800" role="rowheader">{labels.ganttPlan}</div>
          {months.map((m) => {
            const count = timelinePlanned[m.id] ?? 0;
            const pct = Math.round((count / maxPlan) * 100);
            return (
              <div class="flex h-8 items-end bg-gray-50 p-0.5" role="cell">
                <div
                  class="w-full rounded-sm bg-green-600"
                  style={`height: ${Math.max(pct, count > 0 ? 12 : 0)}%`}
                  title={`${m.labelTh}: ${count}`}
                >
                  <span class="sr-only">{m.labelTh} {count}</span>
                </div>
              </div>
            );
          })}
          <div class="flex items-center p-1 font-medium text-blue-800" role="rowheader">{labels.ganttResult}</div>
          {months.map((m) => {
            const count = timelineActual[m.id] ?? 0;
            const pct = Math.round((count / maxActual) * 100);
            return (
              <div class="flex h-8 items-end bg-gray-50 p-0.5" role="cell">
                <div
                  class="w-full rounded-sm bg-blue-600"
                  style={`height: ${count > 0 ? Math.max(pct, 20) : 0}%`}
                  title={`${m.labelTh}: ${count}`}
                >
                  <span class="sr-only">{m.labelTh} {count}</span>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="ap-categories">
    <h2 id="ap-categories" class="text-lg font-semibold text-gray-900 mb-2">{labels.categoriesTitle}</h2>
    <p class="mb-3 text-sm text-gray-600">{labels.categoriesExplain}</p>
    <p class="mb-4 flex items-start gap-2 rounded-md bg-gray-50 px-3 py-2 text-sm text-gray-600">
      <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{labels.activitiesExplain}</span>
    </p>
    <div class="space-y-3">
      {categories.map((cat, idx) => (
        <details
          id={cat.id}
          class="ap-category group rounded-lg border border-gray-200 bg-white open:shadow-sm"
          data-ap-category-section={cat.id}
          open={idx === 0}
        >
          <summary class="cursor-pointer list-none px-4 py-3 font-semibold text-gray-900 marker:content-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600">
            <span class="flex items-center justify-between gap-2">
              <span>
                {isTh ? `หมวด ${cat.number}` : `Category ${cat.number}`}: {cat.titleTh}
              </span>
              <span class="text-sm font-normal text-gray-500">{cat.indicatorCount} {labels.indicatorCount}</span>
            </span>
          </summary>
          <div class="border-t border-gray-100 px-4 py-4 space-y-4">
            {cat.activities.map((activity) => (
              <ActionPlanActivityCard
                activity={activity}
                months={months}
                isTh={isTh}
                categoryId={cat.id}
                categoryTitleTh={cat.titleTh}
                searchBlob={searchBlob(cat.titleTh, activity)}
              />
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="rounded-lg border border-gray-200 bg-gray-50 p-6" aria-labelledby="ap-download">
    <h2 id="ap-download" class="text-lg font-semibold text-gray-900">{labels.downloadTitle}</h2>
    <p class="mt-2 text-sm text-gray-600">{labels.downloadHint}</p>
    <a
      href={source.publicDownloadPath}
      class="mt-4 inline-flex items-center justify-center rounded-md bg-green-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-green-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700"
      download
    >
      {labels.downloadBtn}
    </a>
  </section>
</section>

<script type="module" src={actionPlanScript}></script>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::after {
    content: '+';
    float: right;
    font-weight: 700;
    color: rgb(21 128 61);
  }
  details[open] summary::after {
    content: '−';
  }

  @media print {
    .ap-no-print {
      display: none !important;
    }
    #action-plan-root {
      max-width: none;
    }
    .ap-gantt-summary,
    .ap-gantt-row {
      overflow: visible !important;
    }
    .ap-category,
    .ap-activity {
      break-inside: avoid;
      page-break-inside: avoid;
    }
    details.ap-category > summary::after {
      display: none;
    }
  }
</style>
