---
interface MonthEntry {
  id: string;
  labelTh: string;
}

interface ActualMonth {
  monthId: string;
  value: string;
}

interface Activity {
  id: string;
  indicatorCode: string | null;
  taskNumber: string | null;
  activityTh: string;
  frequency: string | null;
  responsible: string | null;
  plannedMonths: string[];
  actualMonths: ActualMonth[];
}

interface Props {
  activity: Activity;
  months: MonthEntry[];
  isTh: boolean;
  categoryId: string;
  categoryTitleTh: string;
  searchBlob: string;
}

const { activity, months, isTh, categoryId, searchBlob } = Astro.props;
const monthLabel = (id: string) => months.find((m) => m.id === id)?.labelTh ?? id;

const plannedSet = new Set(activity.plannedMonths);
const actualByMonth = new Map(activity.actualMonths.map((a) => [a.monthId, a.value]));
---

<article
  class="ap-activity rounded-lg border border-gray-200 bg-white p-4 shadow-sm"
  data-ap-activity
  data-ap-category={categoryId}
  data-ap-search={searchBlob}
  aria-labelledby={`act-${activity.id}`}
>
  <header class="mb-3 space-y-1">
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
      {activity.indicatorCode && (
        <span class="rounded bg-green-50 px-2 py-0.5 font-medium text-green-800">{activity.indicatorCode}</span>
      )}
      {activity.taskNumber && (
        <span class="rounded bg-gray-100 px-2 py-0.5">{activity.taskNumber}</span>
      )}
    </div>
    <h4 id={`act-${activity.id}`} class="text-base font-semibold text-gray-900 whitespace-pre-line">
      {activity.activityTh}
    </h4>
  </header>

  <dl class="grid gap-2 text-sm sm:grid-cols-2">
    {activity.frequency && (
      <div>
        <dt class="font-medium text-gray-600">{isTh ? 'ความถี่' : 'Frequency'}</dt>
        <dd class="text-gray-800 whitespace-pre-line">{activity.frequency}</dd>
      </div>
    )}
    {activity.responsible && (
      <div>
        <dt class="font-medium text-gray-600">{isTh ? 'ผู้รับผิดชอบ' : 'Responsible'}</dt>
        <dd class="text-gray-800 whitespace-pre-line">{activity.responsible}</dd>
      </div>
    )}
  </dl>

  <div class="mt-4">
    <p class="text-xs font-medium uppercase tracking-wide text-gray-500 mb-2">
      {isTh ? 'แผน / ผล (ม.ค.–ธ.ค.)' : 'Plan / result (Jan–Dec)'}
    </p>
    <div
      class="ap-gantt-row grid grid-cols-12 gap-0.5 rounded border border-gray-100 bg-gray-50 p-1"
      role="img"
      aria-label={isTh ? 'แผนและผลรายเดือน' : 'Monthly plan and result'}
    >
      {months.map((m) => {
        const planned = plannedSet.has(m.id);
        const actual = actualByMonth.get(m.id);
        return (
          <div
            class:list={[
              'relative h-6 rounded-sm',
              planned ? 'bg-green-500' : 'bg-gray-200',
              actual ? 'ring-2 ring-blue-600 ring-inset' : '',
            ]}
            title={
              [
                m.labelTh,
                planned ? (isTh ? 'แผน' : 'Plan') : '',
                actual ? `${isTh ? 'ผล' : 'Result'}: ${actual}` : '',
              ]
                .filter(Boolean)
                .join(' — ')
            }
          >
            <span class="sr-only">
              {m.labelTh}
              {planned ? (isTh ? ' มีแผน' : ' planned') : ''}
              {actual ? `: ${actual}` : ''}
            </span>
          </div>
        );
      })}
    </div>
    <ul class="mt-2 grid grid-cols-4 gap-1 sm:grid-cols-6 md:grid-cols-12 text-center text-[10px] text-gray-500" aria-hidden="true">
      {months.map((m) => (
        <li>{m.labelTh}</li>
      ))}
    </ul>
  </div>

  {activity.actualMonths.length > 0 && (
    <div class="mt-3 rounded-md bg-blue-50 px-3 py-2 text-sm text-blue-900">
      <p class="font-medium">{isTh ? 'ผล/วันที่จากแฟ้มงาน' : 'Actual / result (workbook)'}</p>
      <ul class="mt-1 list-disc pl-5">
        {activity.actualMonths.map((a) => (
          <li>
            {monthLabel(a.monthId)}: {a.value}
          </li>
        ))}
      </ul>
    </div>
  )}
</article>
