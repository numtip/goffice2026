---
interface MonthEntry {
  id: string;
  labelTh: string;
}

interface ActualMonth {
  monthId: string;
  value: string;
}

interface Activity {
  id: string;
  indicatorCode: string | null;
  taskNumber: string | null;
  activityTh: string;
  frequency: string | null;
  responsible: string | null;
  plannedMonths: string[];
  actualMonths: ActualMonth[];
}

interface Props {
  activity: Activity;
  months: MonthEntry[];
  isTh: boolean;
  categoryId: string;
  categoryTitleTh: string;
  searchBlob: string;
}

const { activity, months, isTh, categoryId, searchBlob } = Astro.props;
const monthLabel = (id: string) => months.find((m) => m.id === id)?.labelTh ?? id;

const plannedSet = new Set(activity.plannedMonths);
const actualByMonth = new Map(activity.actualMonths.map((a) => [a.monthId, a.value]));
---

<article
  class="ap-activity rounded-lg border border-gray-200 bg-white p-4 shadow-sm"
  data-ap-activity
  data-ap-category={categoryId}
  data-ap-search={searchBlob}
  aria-labelledby={`act-${activity.id}`}
>
  <header class="mb-3 space-y-1">
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
      {activity.indicatorCode && (
        <span class="rounded bg-green-50 px-2 py-0.5 font-medium text-green-800">{activity.indicatorCode}</span>
      )}
      {activity.taskNumber && (
        <span class="rounded bg-gray-100 px-2 py-0.5">{activity.taskNumber}</span>
      )}
    </div>
    <h4 id={`act-${activity.id}`} class="text-base font-semibold text-gray-900 whitespace-pre-line">
      {activity.activityTh}
    </h4>
  </header>

  <dl class="grid gap-2 text-sm sm:grid-cols-2">
    {activity.frequency && (
      <div>
        <dt class="font-medium text-gray-600">{isTh ? 'ความถี่' : 'Frequency'}</dt>
        <dd class="text-gray-800 whitespace-pre-line">{activity.frequency}</dd>
      </div>
    )}
    {activity.responsible && (
      <div>
        <dt class="font-medium text-gray-600">{isTh ? 'ผู้รับผิดชอบ' : 'Responsible'}</dt>
        <dd class="text-gray-800 whitespace-pre-line">{activity.responsible}</dd>
      </div>
    )}
  </dl>

  <div class="mt-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
      <p class="text-xs font-medium uppercase tracking-wide text-gray-500">
        {isTh ? 'แผน / ผลรายเดือน (ม.ค.–ธ.ค.)' : 'Monthly plan / result (Jan–Dec)'}
      </p>
      <p class="flex items-center gap-3 text-[10px] text-gray-500">
        <span class="flex items-center gap-1">
          <span class="inline-block h-2.5 w-2.5 rounded-sm bg-green-500" aria-hidden="true"></span>
          {isTh ? 'แผน' : 'Plan'}
        </span>
        <span class="flex items-center gap-1">
          <span class="inline-block h-2.5 w-2.5 rounded-sm bg-white ring-2 ring-inset ring-blue-600" aria-hidden="true"></span>
          {isTh ? 'ผล' : 'Result'}
        </span>
      </p>
    </div>
    <p class="sr-only">
      {isTh
        ? 'ตารางเดือนมกราคมถึงธันวาคม: เซลล์เขียว = มีแผนในเดือนนั้น กรอบน้ำเงิน = มีผลลัพธ์จากแฟ้มงาน'
        : 'Month grid January to December: green = planned that month, blue outline = has a result from the workbook'}
    </p>
    <div
      class="ap-gantt-row grid grid-cols-12 gap-0.5 rounded border border-gray-100 bg-gray-50 p-1"
      role="img"
      aria-label={isTh ? 'แผนและผลรายเดือน' : 'Monthly plan and result'}
    >
      {months.map((m) => {
        const planned = plannedSet.has(m.id);
        const actual = actualByMonth.get(m.id);
        return (
          <div
            class:list={[
              'relative h-6 rounded-sm',
              planned ? 'bg-green-500' : 'bg-gray-200',
              actual ? 'ring-2 ring-blue-600 ring-inset' : '',
            ]}
            title={
              [
                m.labelTh,
                planned ? (isTh ? 'แผน' : 'Plan') : '',
                actual ? `${isTh ? 'ผล' : 'Result'}: ${actual}` : '',
              ]
                .filter(Boolean)
                .join(' — ')
            }
          >
            <span class="sr-only">
              {m.labelTh}
              {planned ? (isTh ? ' มีแผน' : ' planned') : ''}
              {actual ? `: ${actual}` : ''}
            </span>
          </div>
        );
      })}
    </div>
    <ul class="mt-2 grid grid-cols-4 gap-1 sm:grid-cols-6 md:grid-cols-12 text-center text-[10px] text-gray-500" aria-hidden="true">
      {months.map((m) => (
        <li>{m.labelTh}</li>
      ))}
    </ul>
  </div>

  {activity.actualMonths.length > 0 && (
    <div class="mt-3 rounded-md border border-blue-100 bg-blue-50 px-3 py-2.5 text-sm text-blue-900">
      <p class="flex items-center gap-1.5 font-medium">
        <svg class="h-4 w-4 shrink-0 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2m-6 4h8m-8 4h8m-8 4h5" />
        </svg>
        {isTh ? 'ผล/วันที่จากแฟ้มงาน' : 'Actual / result (workbook)'}
      </p>
      <ul class="mt-1.5 list-disc space-y-1 pl-5">
        {activity.actualMonths.map((a) => (
          <li>
            <span class="font-semibold text-blue-950">{monthLabel(a.monthId)}</span>: {a.value}
          </li>
        ))}
      </ul>
      <p class="mt-1.5 border-t border-blue-100 pt-1.5 text-xs text-blue-700">
        {isTh ? 'ค่าจริงและวันที่ดึงมาจากแฟ้มงานต้นฉบับโดยตรง (ไม่มีการแก้ไข)' : 'Values and dates are taken directly from the source workbook, unchanged.'}
      </p>
    </div>
  )}
</article>
