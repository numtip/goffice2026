---
interface Props {
  label: string;
  value: string | number;
  unit?: string;
  trend?: 'up' | 'down' | 'stable';
  trendLabel?: string;
  href?: string;
  color?: 'green' | 'yellow' | 'red';
}

const { label, value, unit = '', trend, trendLabel, href } = Astro.props;

const trendSymbol: Record<string, string> = { up: '\u2191', down: '\u2193', stable: '\u2192' };
const trendColors: Record<string, string> = {
  up: 'text-green-500',
  down: 'text-red-500',
  stable: 'text-gray-400',
};
---

<div class="bg-white rounded-stitch-lg border border-outline-variant/20 p-5 shadow-sm">
  <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1.5">{label}</p>
  <p class="text-3xl font-bold text-on-surface leading-none tracking-tight tabular-nums">
    {value}<span class="text-base text-on-surface-variant font-medium ml-1">{unit}</span>
    {trend && (
      <span class={"text-base font-semibold ml-1.5 " + (trendColors[trend] || 'text-gray-400')} title={trendLabel || trend} aria-label={trendLabel || trend}>
        {trendSymbol[trend] || ''}
      </span>
    )}
  </p>
  {href && (
    <a href={href} class="text-xs font-medium text-primary underline underline-offset-2 mt-2.5 inline-block hover:text-primary-container transition-colors">
      View details &rarr;
    </a>
  )}
</div>
