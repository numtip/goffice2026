---
import ChartLegend from './ChartLegend.astro';
import EChart from './EChart.astro';
import { buildNormalizedSeries, buildNormalizedOption } from '../../utils/chart-option';

interface Props {
  title: string;
  resources: {
    id: string;
    label: string;
    color: string;
    baselineTotal: number | null;
    currentTotal: number | null;
    index?: number | null;
  }[];
  baselineLabel: string;
  currentLabel: string;
  locale?: 'th' | 'en';
}

const {
  title, resources,
  baselineLabel, currentLabel, locale = 'th',
} = Astro.props;

const th = locale === 'th';
const unavailable = '—';

const series = buildNormalizedSeries(resources);

const option = buildNormalizedOption({
  series,
  locale,
  baselineLabel,
  currentLabel,
  ariaDescription: `${title}. ${baselineLabel} = 100.`,
});

const rows = series.labels.map((label, i) => [
  label,
  series.values[i] == null ? unavailable : String(series.values[i]),
]);
---

<div class="bg-white rounded-stitch-lg border border-outline-variant/20 p-5 shadow-sm mb-6">
  <h3 class="text-sm font-semibold text-on-surface mb-3">{title}</h3>

  <ChartLegend
    items={[
      { color: '#006c49', label: currentLabel, symbol: 'square' },
      { color: '#707974', label: `${baselineLabel} = 100`, symbol: 'dash' },
    ]}
    class="mb-3 flex flex-wrap gap-3"
  />

  <EChart
    option={option}
    tooltipMeta={{ locale, unit: '', emptyLabel: th ? 'ไม่มีข้อมูล' : 'Missing' }}
    ariaLabel={title}
    height={Math.max(200, resources.length * 44 + 60)}
    columns={[
      { label: th ? 'ทรัพยากร' : 'Resource' },
      { label: th ? 'ดัชนี (ปีฐาน = 100)' : 'Index (baseline = 100)', align: 'right' },
    ]}
    rows={rows}
    tableSummary={th
      ? 'วิธีคำนวณ: (รวมช่วงเทียบเคียง 2569 ÷ รวมช่วงเทียบเคียง 2568) × 100 · ค่าที่ต่ำกว่า 100 = การใช้ทรัพยากรลดลง (ดีขึ้น) · — = ไม่พร้อมใช้งาน'
      : 'Method: (FY2569 common-period sum ÷ FY2568 same-period sum) × 100 · Below 100 = reduced consumption (improvement) · — = unavailable'}
  />
</div>
