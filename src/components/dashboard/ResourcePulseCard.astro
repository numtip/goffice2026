---
import type { PhaseACopy, PhaseAResourcePulse } from '../../utils/dashboard-phase-a-vm';

interface Props {
  card: PhaseAResourcePulse;
  locale: 'th' | 'en';
  /** Optional VM copy (grid passes vm.copy). Falls back to minimal localized labels when omitted. */
  copy?: Pick<PhaseACopy, 'monthsUnit' | 'of12' | 'provenanceLabel'>;
}

const { card, locale } = Astro.props;
const th = locale === 'th';

const copy = Astro.props.copy ?? {
  monthsUnit: th ? 'เดือน' : 'months',
  of12: th ? 'จาก 12' : 'of 12',
  provenanceLabel: th ? 'ที่มา' : 'Source',
};

// State chip: amber = in progress, neutral = pending (never red-as-error).
const chipClass =
  card.displayStatus === 'in_progress'
    ? 'border-amber-200/80 bg-amber-50 text-amber-700'
    : 'border-neutral-200 bg-neutral-100 text-neutral-500';
const dotClass = card.displayStatus === 'in_progress' ? 'bg-amber-500' : 'bg-neutral-400';

// Provenance cue: the VM already embeds the label for in_progress entries;
// normalize to avoid duplication ("ที่มา: ที่มา: …").
const stripSource = th ? /^ที่มา\s*[:：]\s*/ : /^Source\s*:\s*/i;
const provenanceLine =
  card.displayStatus === 'in_progress'
    ? `${copy.provenanceLabel}: ${card.provenance.replace(stripSource, '')}`
    : card.provenance;

// Genuine FY2569 sparkline only (energy/water); null for pending resources — never a fake one.
const spark = card.sparkline;
let sparkPoints = '';
let sparkAreaPoints = '';
let sparkEndX = 0;
let sparkEndY = 0;
const hasSparkline = spark != null && spark.length >= 2;
if (hasSparkline) {
  const w = 150;
  const h = 36;
  const pad = 3;
  const values = spark as number[];
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  const stepX = w / (values.length - 1 || 1);
  const pts = values.map((v, i) => {
    const x = i * stepX;
    const y = h - pad - ((v - min) / range) * (h - pad * 2);
    return { x, y, s: `${x.toFixed(1)},${y.toFixed(1)}` };
  });
  sparkPoints = pts.map((p) => p.s).join(' ');
  sparkAreaPoints = `0,${h} ${sparkPoints} ${w},${h}`;
  sparkEndX = pts[pts.length - 1].x;
  sparkEndY = pts[pts.length - 1].y;
}

// Pending cards render '—' (totalDisplay) with no unit — never '0'.
const showUnit = card.total !== null && card.unit.length > 0;
---

<a
  href={card.ctaHref}
  class="resource-pulse-card group relative flex h-full min-w-0 flex-col overflow-hidden rounded-stitch-lg border border-outline-variant/30 bg-surface-container-lowest p-5 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-white"
>
  <!-- Per-resource accent top bar -->
  <div
    class="absolute inset-x-0 top-0 h-[3px]"
    style={`background:linear-gradient(90deg, ${card.accent} 0%, ${card.accent}59 100%)`}
    aria-hidden="true"
  ></div>

  <!-- Header: icon + name + state chip -->
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border"
        style={`background-color:${card.accent}12; border-color:${card.accent}30;`}
        aria-hidden="true"
      >
        <img
          src={card.iconUrl}
          alt=""
          class="h-6 w-6 object-contain"
          loading="lazy"
          decoding="async"
          width={64}
          height={64}
        />
      </div>
      <h3 class="min-w-0 truncate text-sm font-bold tracking-tight text-on-surface">{card.name}</h3>
    </div>
    <span
      class={`inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-[10px] font-semibold ${chipClass}`}
    >
      <span class={`h-1.5 w-1.5 rounded-full ${dotClass}`} aria-hidden="true"></span>
      {card.statusLabel}
    </span>
  </div>

  <!-- Big total (tabular-nums) -->
  <div class="mt-4 flex min-w-0 items-baseline gap-1.5">
    <span class="text-3xl font-bold leading-none tracking-tight tabular-nums text-on-surface">
      {card.totalDisplay}
    </span>
    {showUnit && (
      <span class="text-sm font-medium tabular-nums text-on-surface-variant">{card.unit}</span>
    )}
  </div>

  <!-- x/12 months -->
  <p class="mt-2 text-xs font-medium tabular-nums text-on-surface-variant">
    {card.monthsCount} {copy.monthsUnit} {copy.of12}
  </p>

  <!-- Genuine sparkline (energy/water only) -->
  {hasSparkline ? (
    <div class="mt-4">
      <svg
        class="w-full"
        width="100%"
        height="36"
        viewBox="0 0 150 36"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon points={sparkAreaPoints} fill={card.accent} opacity="0.08" />
        <polyline
          fill="none"
          stroke={card.accent}
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          points={sparkPoints}
        />
        <circle cx={sparkEndX} cy={sparkEndY} r="2.5" fill={card.accent} />
      </svg>
    </div>
  ) : (
    <div class="flex-1"></div>
  )}

  <!-- Provenance cue -->
  <p class="mt-4 line-clamp-2 min-w-0 break-words text-[10px] leading-relaxed text-outline/80">
    {provenanceLine}
  </p>

  <!-- CTA -->
  <span class="mt-3 inline-flex items-center gap-1 self-start text-xs font-semibold text-primary">
    {card.ctaLabel}
    <svg
      class="pulse-arrow h-3.5 w-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m12 5 7 7-7 7" />
    </svg>
  </span>
</a>

<style>
  .resource-pulse-card {
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out, border-color 0.2s ease-out;
  }
  .pulse-arrow {
    transition: transform 0.2s ease-out;
  }
  @media (prefers-reduced-motion: no-preference) {
    .resource-pulse-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(11, 28, 48, 0.08);
      border-color: rgb(191 201 195 / 0.6);
    }
    .resource-pulse-card:hover .pulse-arrow {
      transform: translateX(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .resource-pulse-card,
    .pulse-arrow {
      transition: none;
    }
  }
</style>
