---
import CommandHero from '../CommandHero.astro';
import ResourcePulseGrid from '../ResourcePulseGrid.astro';
import PerformanceExplorer from '../PerformanceExplorer.astro';
import CategoryProgressOverview from '../../categories/CategoryProgressOverview.astro';
import JourneyLinks from '../../ui/JourneyLinks.astro';
import VisitExecutiveInsights from './VisitExecutiveInsights.astro';
import VisitCategorySummaryGrid from './VisitCategorySummaryGrid.astro';
import VisitTraceabilityStrip from './VisitTraceabilityStrip.astro';
import VisitActivitiesSection from './VisitActivitiesSection.astro';
import type { VisitDashboardVM, VisitLocale } from '../../../utils/visit-dashboard-vm';
import { closingBannerImageUrl } from '../../../utils/wow2-images';

interface Props {
  locale: VisitLocale;
  vm: VisitDashboardVM;
  pageTitle: string;
  pageDescription: string;
}

const { locale, vm, pageTitle, pageDescription } = Astro.props;
const th = locale === 'th';
const yearLabel = th ? 'ปี 2569' : 'FY2569';
---

<div class="visit-dashboard p-4 max-w-6xl mx-auto" data-page="visit-dashboard">
  <!-- Presentation toolbar (client-side ?present=1) -->
  <div
    id="visit-presentation-toolbar"
    class="visit-hide-in-present mb-4 flex flex-wrap items-center justify-end gap-2 rounded-stitch-lg border border-outline-variant/20 bg-surface-container/50 px-3 py-2"
    hidden
  >
    <span class="text-[10px] font-semibold uppercase tracking-wider text-on-surface-variant mr-auto">
      {th ? 'โหมดนำเสนอ' : 'Presentation'}
    </span>
    <button
      type="button"
      id="visit-presentation-toggle"
      class="rounded-full border border-primary/30 px-3 py-1.5 text-xs font-semibold text-primary hover:bg-primary/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      aria-pressed="false"
    >
      {th ? 'สลับโหมดนำเสนอ' : 'Toggle presentation mode'}
    </button>
    <button
      type="button"
      id="visit-fullscreen-toggle"
      class="rounded-full border border-outline-variant/30 px-3 py-1.5 text-xs font-semibold text-on-surface-variant hover:border-primary/30 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
    >
      {th ? 'เต็มจอ' : 'Fullscreen'}
    </button>
  </div>

  <header class="visit-section dashboard-section mb-6">
    <p class="text-[10px] font-bold uppercase tracking-[0.25em] text-primary mb-1">
      {th ? 'แดชบอร์ดสำหรับการเยี่ยมชมผู้บริหาร' : 'Executive Visit Dashboard'}
    </p>
    <h1 class="text-xl font-bold text-on-surface tracking-tight md:text-2xl">{pageTitle}</h1>
    <p class="mt-1 text-sm text-on-surface-variant max-w-3xl">{pageDescription}</p>
  </header>

  <!-- 1. Executive overview -->
  <CommandHero locale={locale} vm={vm.phaseA} />

  <!-- 2. Six resource KPI cards -->
  <ResourcePulseGrid locale={locale} vm={vm.phaseA} />

  <!-- 3. Executive highlights / attention / next actions -->
  <VisitExecutiveInsights locale={locale} insights={vm.insights} />

  <!-- 4. Resource trends — monthly small-multiples only; deeper views linked -->
  {vm.explorerResources.length > 0 && (
    <section class="visit-section dashboard-section mb-8" data-semantic-track="performance">
      <PerformanceExplorer
        title={th ? 'แนวโน้มรายเดือน (ทุกทรัพยากร)' : 'Monthly Performance Trends (All Resources)'}
        description={th
          ? 'กราฟรายเดือนปี 2569 แยกตามทรัพยากร — ช่องว่าง = เดือนที่ยังไม่มีข้อมูล (ไม่นับเป็น 0)'
          : 'FY2569 monthly trends by resource — gaps = months with no data yet (never treated as 0).'}
        resources={vm.explorerResources}
        yearLabel={yearLabel}
        locale={locale}
      />
      <p class="mt-3 text-xs text-on-surface-variant">
        {th
          ? 'เปรียบเทียบปีต่อปีและดัชนีฐาน — '
          : 'For same-period YoY and baseline index comparisons — '}
        <a href={vm.links.fullDashboard} class="text-primary font-semibold hover:underline">
          {th ? 'ดูแดชบอร์ดภาพรวมเต็มรูปแบบ' : 'open the full executive dashboard'}
        </a>
      </p>
    </section>
  )}

  <!-- 5. Criteria progress (65 indicators) -->
  <div data-semantic-track="progress">
    <CategoryProgressOverview locale={locale} />
  </div>

  <!-- 6. Seven category summary -->
  <VisitCategorySummaryGrid locale={locale} categories={vm.progress.categories} />

  <!-- 7. Performance → indicator → evidence → action story -->
  <VisitTraceabilityStrip locale={locale} traceability={vm.traceability} links={vm.links} />

  <!-- 8. Selected activities -->
  <VisitActivitiesSection
    locale={locale}
    activities={vm.selectedActivities}
    activitiesHref={vm.links.activities}
  />

  <!-- 9. Summary / CTA -->
  <section class="visit-section dashboard-section mt-8 rounded-stitch-lg overflow-hidden relative min-h-[220px] flex items-center">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src={closingBannerImageUrl}
        alt=""
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        width="2048"
        height="1152"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#001a12]/85 via-[#002b1e]/70 to-[#003527]/60" />
    </div>
    <div class="relative z-10 w-full p-8 md:p-10 text-center">
      <p class="text-lg md:text-xl font-bold text-white tracking-tight mb-2">
        Green Office 2026
      </p>
      <p class="text-sm text-white/80 mb-2 max-w-2xl mx-auto leading-relaxed">
        {th ? 'แสดงผล · วัดผล · พิสูจน์ · พัฒนา' : 'Show · Measure · Prove · Improve'}
      </p>
      <p class="text-xs text-white/60 mb-6 max-w-xl mx-auto">
        {th
          ? 'ไม่ใช่คะแนนประเมินอย่างเป็นทางการ — ข้อมูลปี 2569 อยู่ระหว่างบันทึก'
          : 'Not an official assessment score — FY2569 data entry is in progress.'}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={vm.links.evidence}
          class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/15 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white hover:bg-white/25 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          {th ? 'คลังหลักฐาน' : 'Evidence Library'}
        </a>
        <a
          href={vm.links.categories}
          class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white/90 hover:text-white hover:bg-white/15 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          {th ? 'หมวดเกณฑ์' : 'Categories'}
        </a>
        <a
          href={vm.links.fullDashboard}
          class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 text-xs font-semibold uppercase tracking-wider text-white/90 hover:text-white hover:bg-white/15 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        >
          {th ? 'แดชบอร์ดเต็ม' : 'Full Dashboard'}
        </a>
      </div>
    </div>
  </section>

  <div class="visit-hide-in-present mt-6">
    <JourneyLinks current="dashboard" locale={locale} />
  </div>
</div>

<script>
  import '../../../scripts/visit-presentation.ts';
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .dashboard-section {
      opacity: 0;
      transform: translateY(16px);
      animation: visit-section-reveal 0.5s ease-out forwards;
    }
    @keyframes visit-section-reveal {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
