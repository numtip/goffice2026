---
export interface LegendItem {
  color: string;
  label: string;
  symbol?: 'square' | 'line' | 'dash' | 'circle';
}

interface Props {
  items: LegendItem[];
  class?: string;
  ariaLabel?: string;
}

const { items, class: cls = '', ariaLabel } = Astro.props;
---

<div class={`chart-legend ${cls}`} role="list" aria-label={ariaLabel ?? 'Chart legend'}>
  {items.map((item) => (
    <span
      class="inline-flex items-center gap-1.5 rounded-full border border-outline-variant/20 bg-surface-container/50 px-2.5 py-1 text-[11px] font-medium text-on-surface-variant"
      role="listitem"
    >
      {item.symbol === 'line' ? (
        <svg class="h-1.5 w-5 shrink-0" aria-hidden="true" viewBox="0 0 20 4">
          <line x1="0" y1="2" x2="20" y2="2" stroke={item.color} stroke-width="2" stroke-linecap="round" />
        </svg>
      ) : item.symbol === 'dash' ? (
        <svg class="h-1.5 w-5 shrink-0" aria-hidden="true" viewBox="0 0 20 4">
          <line x1="0" y1="2" x2="20" y2="2" stroke={item.color} stroke-width="2" stroke-dasharray="3 3" stroke-linecap="round" />
        </svg>
      ) : item.symbol === 'circle' ? (
        <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full ring-1 ring-inset ring-outline-variant/30" style={`background-color: ${item.color}`} aria-hidden="true"></span>
      ) : (
        <span class="inline-block h-3 w-3 shrink-0 rounded-sm ring-1 ring-inset ring-outline-variant/30" style={`background-color: ${item.color}`} aria-hidden="true"></span>
      )}
      <span class="uppercase tracking-wide">{item.label}</span>
    </span>
  ))}
</div>
