---
import EChart from './EChart.astro';
import { buildCategoryScoreOption, categoryStatusTexts } from '../../utils/chart-option';

interface Props {
  title: string;
  description?: string;
  categories: {
    code: string;
    label: string;
    score: number;
    maxScore?: number;
    trend?: 'up' | 'down' | 'stable';
    href: string;
    statusText?: string;
  }[];
  maxScore?: number;
  locale?: 'th' | 'en';
}

const {
  title, description, categories,
  maxScore: maxScoreProp, locale = 'th',
} = Astro.props;

const th = locale === 'th';

const maxScore = maxScoreProp ?? Math.max(...categories.map((c) => c.score), 100);
const withMax = categories.map((c) => ({ ...c, maxScore: c.maxScore ?? maxScore }));

const option = buildCategoryScoreOption({
  categories: withMax,
  locale,
  ariaDescription: description ?? `${title}. ${th ? 'คะแนนประเมินรายหมวด' : 'Category assessment scores'}.`,
});

const rows = withMax.map((cat) => [
  { text: cat.label, href: cat.href },
  cat.score,
  Math.round((cat.score / maxScore) * 100),
  cat.trend ? (cat.trend === 'up' ? '\u2191' : cat.trend === 'down' ? '\u2193' : '\u2192') : '-',
]);
---
<div class="bg-white rounded-stitch-lg border border-outline-variant/20 p-5 shadow-sm mb-6">
  <h3 class="text-sm font-semibold text-on-surface mb-1">{title}</h3>
  {description && <p class="text-xs text-outline-variant mb-3">{description}</p>}

  <EChart
    option={option}
    tooltipMeta={{ locale, unit: '', emptyLabel: th ? 'ไม่มีข้อมูล' : 'Missing', statusTexts: categoryStatusTexts(withMax) }}
    ariaLabel={title}
    height={Math.max(220, categories.length * 44 + 60)}
    columns={[
      { label: th ? 'หมวดหมู่' : 'Category' },
      { label: th ? 'คะแนน' : 'Score', align: 'right' },
      { label: '%', align: 'right' },
      { label: th ? 'แนวโน้ม' : 'Trend', align: 'right' },
    ]}
    rows={rows}
    tableSummary={th ? 'เลือกหมวดหมู่ในตารางเพื่อไปยังหน้ารายละเอียด' : 'Select a category in the table to open its detail page'}
  />
</div>
