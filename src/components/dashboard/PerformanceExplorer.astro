---
/**
 * PerformanceExplorer.astro (GO-DASH-V2-B-A)
 * ==========================================
 * Multi-metric monthly explorer — small multiples (one chart per resource).
 * Compares genuine FY-current monthly consumption with per-resource Y-axis
 * units, plus an accessible HTML table fallback.
 *
 * Data contract:
 *   - Values come from generated JSON only (via the Phase-A VM / metric map).
 *   - Missing months are `null` — never converted to 0.
 *   - Raw consumption values (not normalized) — each panel keeps its unit.
 */
import EChart from './EChart.astro';
import { buildExplorerSingleOption } from '../../utils/chart-option';

interface Props {
  title: string;
  description?: string;
  resources: {
    id: string;
    label: string;
    color: string;
    months: (number | null)[];
    unit: string;
  }[];
  yearLabel: string;
  locale?: 'th' | 'en';
}

const {
  title,
  description,
  resources,
  yearLabel,
  locale = 'th',
} = Astro.props;

const th = locale === 'th';

const monthAbbr = th
  ? ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.']
  : ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

const panels = resources.map((r) => {
  const covered = r.months.filter((v) => v !== null).length;
  const coverageLabel = th ? `${covered}/12 เดือน` : `${covered}/12 months`;
  const ariaDescription = `${r.label}. ${yearLabel}. ${coverageLabel}. ${description ?? title}.`;
  return {
    ...r,
    covered,
    coverageLabel,
    option: buildExplorerSingleOption({
      resource: r,
      locale,
      yearLabel,
      ariaDescription,
    }),
  };
});

// Accessible table fallback: rows = resources, columns = months.
const columns = [
  { label: th ? 'ทรัพยากร' : 'Resource' },
  { label: th ? 'หน่วย' : 'Unit' },
  { label: th ? 'ครอบคลุม' : 'Coverage', align: 'right' as const },
  ...monthAbbr.map((m) => ({ label: m, align: 'right' as const })),
];

const rows = panels.map((r) => [
  r.label,
  r.unit,
  r.coverageLabel,
  ...r.months.map((v) => (v === null ? '—' : String(v))),
]);

const summaryParts = panels.map(
  (r) => `${r.label}: ${r.coverageLabel}, ${r.unit}`,
);
const textSummary = th
  ? `สรุปแนวโน้มรายเดือน ${yearLabel}: ${summaryParts.join('; ')}. ช่องว่าง = ไม่มีข้อมูล.`
  : `Monthly trend summary ${yearLabel}: ${summaryParts.join('; ')}. Gaps = no data.`;
---

<div class="bg-white rounded-stitch-lg border border-outline-variant/20 p-5 shadow-sm mb-6">
  <h3 class="text-sm font-semibold text-on-surface mb-1">{title}</h3>
  {description && <p class="text-xs text-outline-variant mb-3">{description}</p>}

  <p class="sr-only">{textSummary}</p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-2">
    {panels.map((panel) => (
      <article
        class="rounded-md border border-outline-variant/15 bg-surface-container/30 p-3 min-w-0"
        aria-label={`${panel.label} — ${yearLabel}`}
      >
        <div class="flex items-center justify-between gap-2 mb-2 min-w-0">
          <h4 class="text-xs font-semibold text-on-surface truncate flex items-center gap-1.5 min-w-0">
            <span
              class="w-1.5 h-1.5 rounded-full shrink-0"
              style={`background-color:${panel.color}`}
              aria-hidden="true"
            ></span>
            <span class="truncate">{panel.label}</span>
          </h4>
          <span
            class="text-[10px] tabular-nums text-on-surface-variant shrink-0 whitespace-nowrap"
            title={th ? 'จำนวนเดือนที่มีข้อมูล' : 'Months with data'}
          >
            {panel.coverageLabel}
          </span>
        </div>
        <EChart
          option={panel.option}
          tooltipMeta={{
            locale,
            unit: panel.unit,
            emptyLabel: th ? 'ไม่มีข้อมูล' : 'Missing',
            compactAxis: true,
          }}
          ariaLabel={`${panel.label} — ${yearLabel} — ${panel.coverageLabel}`}
          height={180}
          noTable
        />
      </article>
    ))}
  </div>

  <details class="mt-3">
    <summary class="text-xs text-outline cursor-pointer hover:text-primary select-none rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">
      {th ? 'ตารางข้อมูล' : 'Data table'}
    </summary>
    <p class="text-[10px] text-on-surface-variant mt-2 mb-1">
      {th ? `ตารางข้อมูลรายเดือน ${yearLabel} จำแนกตามทรัพยากร` : `Monthly data table ${yearLabel} by resource`}
    </p>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-xs text-left border-collapse">
        <thead class="border-b border-outline-variant/30">
          <tr>
            {columns.map((col) => (
              <th
                scope="col"
                class:list={['py-1.5 px-2 font-semibold text-on-surface', col.align === 'right' ? 'text-right' : '']}
              >
                {col.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-outline-variant/10 hover:bg-surface-container/50">
              {row.map((cell, ci) => (
                <td
                  class:list={[
                    'py-1.5 px-2 text-on-surface-variant',
                    columns[ci]?.align === 'right' ? 'text-right tabular-nums' : 'font-medium text-on-surface',
                  ]}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>
