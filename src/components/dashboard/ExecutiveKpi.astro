---
import { statusBadgeClass } from '../../utils/data-status';

interface Props {
  label: string;
  value: string;
  unit?: string;
  subtext?: string;
  trendLabel?: string;
  trendColor?: string;
  status?: string;
  size?: 'lg' | 'md';
}

const {
  label,
  value,
  unit,
  subtext,
  trendLabel: trendLbl,
  trendColor = 'text-gray-400',
  status,
  size = 'md',
} = Astro.props;

const valueClass = size === 'lg' ? 'text-5xl md:text-6xl' : 'text-3xl md:text-4xl';
const unitClass = size === 'lg' ? 'text-2xl' : 'text-lg';
---

<div class="bg-white rounded-stitch-lg border border-outline-variant/20 p-5 shadow-sm">
  <p class="text-xs font-semibold text-outline mb-1.5 uppercase tracking-wider">{label}</p>
  <p class={`${valueClass} font-bold leading-none tracking-tight`}>
    <span class="bg-gradient-to-r from-primary to-primary-container bg-clip-text text-transparent tabular-nums">{value}</span>
    {unit && <span class={`${unitClass} text-on-surface-variant font-medium ml-1`}>{unit}</span>}
  </p>
  {trendLbl && (
    <p class={`text-xs font-semibold mt-1.5 tabular-nums ${trendColor}`}>{trendLbl}</p>
  )}
  {status && (
    <span class={`inline-flex items-center mt-2 px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide ${statusBadgeClass(status as any)}`}>
      {status}
    </span>
  )}
  {subtext && (
    <p class="text-[11px] text-on-surface-variant mt-2.5 leading-relaxed">{subtext}</p>
  )}
</div>
