---
import {
  buildCat2DomainSnapshot,
  contractForDomain,
  domainForIndicator,
  MISSING_CAT2_INDICATORS,
  THIN_CAT2_INDICATORS,
  resolveDomainFactValue,
  type Cat2Domain,
  CAT2_YEAR,
} from '../../utils/category2-presentation';
import progressRegistry from '../../data/progress/indicator-progress-2569.json';
import feedback2569 from '../../data/category2/feedback-2569.json';
import { progressStatusLabel, evidenceStatusLabel } from '../../utils/category-progress-vm';

interface Props {
  indicatorCode: string;
  locale: 'th' | 'en';
}

const { indicatorCode, locale } = Astro.props;
const isEn = locale === 'en';

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const domain = domainForIndicator(indicatorCode);
const isMissing = (MISSING_CAT2_INDICATORS as readonly string[]).includes(indicatorCode);
const isThin = (THIN_CAT2_INDICATORS as readonly string[]).includes(indicatorCode);

const domainLabel: Record<Cat2Domain, { th: string; en: string }> = {
  training: { th: 'การอบรมให้ความรู้ (2.1)', en: 'Training and knowledge (2.1)' },
  communication: { th: 'การรณรงค์และประชาสัมพันธ์ (2.2)', en: 'Campaigns and PR (2.2)' },
  feedback: { th: 'ช่องทางข้อเสนอแนะ (2.2.4)', en: 'Feedback channels (2.2.4)' },
};

const snapshot = domain ? buildCat2DomainSnapshot(domain) : null;
const sources = domain ? contractForDomain(domain).records.map((r) => r.sourceRef).filter(Boolean) : [];
const uniqueSources = [...new Set(sources)];
const sourceCount = uniqueSources.length;
const verificationStatus = domain
  ? [...new Set(contractForDomain(domain).records.map((r) => r.verification?.status).filter(Boolean))]
  : [];
const pendingScanCount = domain
  ? contractForDomain(domain).records.filter((r) => r.availability === 'filename_folder_only').length
  : 0;

const fy2569Progress = (progressRegistry.items as Array<{
  indicator: string;
  progressStatus: string;
  evidenceStatus: string;
  notes?: string;
  source?: { type: string; ref: string | null };
}>).find((i) => i.indicator === indicatorCode);

const fy2569Gap = (feedback2569.gaps as Array<{ indicator: string; status: string; note: string }>).find(
  (g) => g.indicator === indicatorCode,
);

const FY2569_PARTIAL: Record<string, { available: { th: string; en: string }; missing: { th: string; en: string }; next: { th: string; en: string } }> = {
  '2.2.3': {
    available: {
      th: 'โฟลเดอร์ Data2569 มีแบบสอบถามความพึงพอใจ Big Cleaning Day (สถานะ NEEDS_DISPOSITION / offline) — ไม่ใช่หลักฐานร้อยละความเข้าใจ',
      en: 'Data2569 folder holds a Big Cleaning Day satisfaction survey (NEEDS_DISPOSITION / offline) — not understanding-% evidence',
    },
    missing: {
      th: 'ยังไม่มีแบบสอบถาม/จำนวนผู้ตอบ/ร้อยละความเข้าใจเฉพาะปี 2569 — ห้ามตีความความพึงพอใจเป็นความเข้าใจ',
      en: 'No FY2569 understanding questionnaire, respondent count, or percentage — do not treat satisfaction as understanding',
    },
    next: {
      th: 'รอการตัดสินใจ PO ก่อน map ไฟล์ความพึงพอใจ; หรือรับหลักฐานวัดความเข้าใจปี 2569 โดยตรง',
      en: 'Await PO disposition before any satisfaction mapping; or ingest a dedicated FY2569 understanding measure',
    },
  },
  '2.2.4': {
    available: {
      th: 'มีไฟล์แนวทางใน Data2569 แต่ SHA-256 ตรงกับปี 2568 ทุกไบต์ — ระงับไม่รับเป็นหลักฐานปี 2569',
      en: 'Data2569 has a guideline PDF, but SHA-256 is byte-identical to FY2568 — held; not accepted as FY2569 currency',
    },
    missing: {
      th: 'ยังไม่มีช่องทางรับเรื่องปี 2569 ที่ลงวันที่ใหม่ และยังไม่มีบันทึกวงจรปรับปรุง',
      en: 'No 2569-dated intake channel artifact and no FY2569 improvement-loop log',
    },
    next: {
      th: 'รับไฟล์แนวทาง/ช่องทางที่ลงปี 2569 (ไม่ใช่สำเนาปี 2568) พร้อมหลักฐานการปิดลูป',
      en: 'Ingest a 2569-dated channel guideline (not an FY2568 copy) plus improvement-loop evidence',
    },
  },
};
const partial = FY2569_PARTIAL[indicatorCode];
---

<div
  class="rounded-xl border border-green-100 bg-green-50/30 p-5"
  aria-labelledby="cat2-contract-context"
  data-cat2-contract-context
  data-indicator-code={indicatorCode}
>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 id="cat2-contract-context" class="text-sm font-semibold text-gray-900">
      {isEn ? `FY${CAT2_YEAR} contract context` : `บริบทข้อมูลสัญญา ปี ${CAT2_YEAR}`}
    </h2>
    {
      domain && (
        <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[11px] font-medium text-green-800">
          {t(domainLabel[domain])}
        </span>
      )
    }
  </div>

  {
    fy2569Progress && (
      <div class="mb-3 rounded-lg border border-emerald-200 bg-emerald-50/50 p-3" data-cat2-fy2569-progress>
        <p class="text-xs font-semibold text-emerald-900">
          {isEn ? 'FY2569 operational progress (not an official score)' : 'ความคืบหน้าการดำเนินงานปี 2569 (ไม่ใช่คะแนนประเมิน)'}
        </p>
        <dl class="mt-2 space-y-1 text-xs">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-emerald-800/80">{isEn ? 'Progress' : 'ความคืบหน้า'}</dt>
            <dd class="font-medium text-emerald-900">{progressStatusLabel(fy2569Progress.progressStatus, locale)}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-emerald-800/80">{isEn ? 'Evidence' : 'หลักฐาน'}</dt>
            <dd class="font-medium text-emerald-900">{evidenceStatusLabel(fy2569Progress.evidenceStatus, locale)}</dd>
          </div>
        </dl>
        {fy2569Progress.notes && (
          <p class="mt-2 text-[11px] leading-relaxed text-emerald-900/80">{fy2569Progress.notes}</p>
        )}
      </div>
    )
  }

  {
    partial && (
      <div class="mb-3 rounded-lg border border-amber-200 bg-amber-50/60 p-3" data-cat2-fy2569-partial>
        <p class="text-xs font-semibold text-amber-900">
          {isEn ? `FY2569 partial status — ${indicatorCode}` : `สถานะบางส่วนปี 2569 — ${indicatorCode}`}
        </p>
        <ul class="mt-2 space-y-1.5 text-[11px] leading-relaxed text-amber-900">
          <li><span class="font-semibold">{isEn ? 'Available:' : 'มีอยู่:'}</span> {t(partial.available)}</li>
          <li><span class="font-semibold">{isEn ? 'Missing:' : 'ยังขาด:'}</span> {t(partial.missing)}</li>
          <li><span class="font-semibold">{isEn ? 'Next:' : 'ถัดไป:'}</span> {t(partial.next)}</li>
        </ul>
        {fy2569Gap && (
          <p class="mt-2 text-[10px] text-amber-800/80">
            {isEn ? `Gap contract: ${fy2569Gap.status}` : `สัญญาช่องว่าง: ${fy2569Gap.status}`} — {fy2569Gap.note}
          </p>
        )}
      </div>
    )
  }

  {
    isMissing ? (
      <div class="rounded-lg border border-amber-100 bg-amber-50/50 p-3" data-cat2-missing-notice>
        <p class="text-sm font-medium text-amber-800">
          {isEn
            ? `Indicator ${indicatorCode}: FY2568 dedicated evidence is not available`
            : `ตัวชี้วัด ${indicatorCode}: ยังไม่มีหลักฐานเฉพาะปี 2568`}
        </p>
        <p class="mt-1 text-xs leading-relaxed text-amber-700">
          {isEn
            ? 'No questionnaire, respondent count (≥4) or percentage exists in the FY2568 source set; 2.2.3.pdf is narrative-only. Recorded as MISSING_DEDICATED_EVIDENCE and never filled in.'
            : 'ไม่มีแบบสอบถาม จำนวนผู้ตอบ (≥4) หรือร้อยละในชุดแหล่งข้อมูลปี 2568; 2.2.3.pdf มีเพียงเนื้อหาบรรยาย ถูกบันทึกเป็น MISSING_DEDICATED_EVIDENCE และไม่เติมข้อมูล'}
        </p>
      </div>
    ) : snapshot ? (
      <>
        {
          isThin && (
            <div class="mb-3 rounded-lg border border-amber-100 bg-amber-50/50 p-3" data-cat2-thin-notice>
              <p class="text-sm font-medium text-amber-800">
                {isEn ? 'Evidence is THIN (single verified narrative file)' : 'หลักฐานอยู่ในระดับ THIN (ไฟล์บรรยายที่ตรวจสอบแล้วเพียงไฟล์เดียว)'}
              </p>
              <p class="mt-1 text-xs leading-relaxed text-amber-700">
                {isEn
                  ? '2.2.2 currently has one verified narrative PDF. BigCleaningDay and significance-acknowledgment scans remain pending candidates (not promoted) until OCR/human verification.'
                  : '2.2.2 ปัจจุบันมี PDF บรรยายที่ตรวจสอบแล้วหนึ่งไฟล์ สแกน BigCleaningDay และใบลงนามความสำคัญยังเป็นผู้สมัครที่รอการตรวจ (ไม่ถูกเลื่อนระดับ) จนกว่าจะผ่าน OCR/การตรวจสอบโดยมนุษย์'}
              </p>
            </div>
          )
        }
        <ul class="space-y-1.5" role="list">
          {
            snapshot.facts.map((fact) => (
              <li class="flex items-baseline justify-between gap-3 text-xs">
                <span class="text-gray-500">{t(fact.label)}</span>
                <span class={`font-medium ${fact.kind === 'unavailable' ? 'text-gray-400' : fact.kind === 'status' ? 'text-amber-700' : 'text-gray-800'}`} data-cat2-domain-fact={fact.kind}>
                  {resolveDomainFactValue(fact.value, locale)}
                </span>
              </li>
            ))
          }
        </ul>
        <dl class="mt-3 space-y-1 border-t border-green-100 pt-2 text-xs">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Source files' : 'ไฟล์ต้นทาง'}</dt>
            <dd class="font-medium text-gray-700" data-cat2-source-count>{sourceCount}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Verification' : 'สถานะการตรวจสอบ'}</dt>
            <dd class="font-medium text-gray-700">
              {verificationStatus.length > 0 ? verificationStatus.join(', ') : '—'}
            </dd>
          </div>
          {
            pendingScanCount > 0 && (
              <div class="flex items-center justify-between gap-3">
                <dt class="text-gray-500">{isEn ? 'Scans pending' : 'สแกนที่รอตรวจ'}</dt>
                <dd class="font-medium text-amber-700" data-cat2-pending-scan-count>{pendingScanCount}</dd>
              </div>
            )
          }
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Contract status' : 'สถานะสัญญา'}</dt>
            <dd class="font-medium text-gray-700">{snapshot.status}</dd>
          </div>
        </dl>
      </>
    ) : (
      <p class="text-xs italic text-gray-400">
        {isEn ? 'No FY2568 contract domain maps to this indicator.' : 'ไม่มีโดเมนสัญญาข้อมูลปี 2568 สำหรับตัวชี้วัดนี้'}
      </p>
    )
  }

  {
    indicatorCode === '2.1.2' && (
      <div class="mt-3 rounded-lg border border-blue-100 bg-blue-50/40 p-3" data-cat2-forward-requirement>
        <p class="text-xs font-semibold text-blue-900">
          {isEn ? 'FY2569 forward requirement (PO B2)' : 'ข้อกำหนดไปข้างหน้าปี 2569 (PO B2)'}
        </p>
        <p class="mt-1 text-xs leading-relaxed text-blue-800">
          {isEn
            ? 'No new activity is added to the FY2569 plan. The FY2569 committee minutes must record named trainer assignments per course as the required 2.1.2 cross-evidence. This is a forward evidence requirement — not verified FY2569 evidence and not a historical claim.'
            : 'ไม่มีการเพิ่มกิจกรรมใหม่ในแผนปี 2569 บันทึกรายงานการประชุมคณะกรรมการปี 2569 ต้องระบุชื่อวิทยากรผู้รับผิดชอบแต่ละหลักสูตร เพื่อใช้เป็นหลักฐานอ้างอิง 2.1.2 ข้อกำหนดนี้เป็นไปข้างหน้าเท่านั้น — ไม่ใช่หลักฐานปี 2569 ที่ตรวจสอบแล้ว และไม่ใช่ข้ออ้างย้อนหลัง'}
        </p>
      </div>
    )
  }
</div>
