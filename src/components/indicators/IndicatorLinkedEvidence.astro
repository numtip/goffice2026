---
import { withBase } from '../../utils/with-base';
import { getLocalizedPath } from '../../i18n/utils';
import {
  describeEvidencePublication,
  publicSourceLabel,
  type EvidenceItem,
} from '../../utils/evidence-traceability';
import { pubLabel, SHAREPOINT_LINK_PENDING } from '../../utils/publication-states';

interface Props {
  items: EvidenceItem[];
  locale?: 'th' | 'en';
  headingId?: string;
}

const { items, locale = 'th', headingId = 'indicator-linked-evidence' } = Astro.props;

function itemTitle(item: EvidenceItem): string {
  return locale === 'th' ? (item.titleTh || item.title) : item.title;
}

function evidenceHref(id: string): string {
  return locale === 'en' ? getLocalizedPath('en', `/evidence/${id}/`) : withBase(`/evidence/${id}/`);
}

function hrefFn(path: string): string {
  return locale === 'en' ? getLocalizedPath('en', path) : withBase(path);
}

/** FY2569 = year 2569 (BE). Everything else is FY2568-era baseline reference. */
function isFy2569(item: EvidenceItem): boolean {
  return item.year === 2569;
}

const fy2569Items = items.filter(isFy2569);
const baselineItems = items.filter((i) => !isFy2569(i));

const verificationLabels: Record<string, { th: string; en: string; cls: string }> = {
  verified: { th: 'ตรวจสอบแล้ว', en: 'Verified', cls: 'bg-green-100 text-green-800' },
  pending: { th: 'รอตรวจสอบ', en: 'Pending review', cls: 'bg-amber-100 text-amber-800' },
  reviewed: { th: 'ตรวจแล้ว', en: 'Reviewed', cls: 'bg-blue-100 text-blue-800' },
  unresolved: { th: 'ยังไม่ตรวจสอบ', en: 'Unresolved', cls: 'bg-yellow-100 text-yellow-800' },
  rejected: { th: 'ไม่ผ่าน', en: 'Rejected', cls: 'bg-red-100 text-red-800' },
  deferred: { th: 'เลื่อน', en: 'Deferred', cls: 'bg-gray-100 text-gray-700' },
};

const pubBadgeCls: Record<string, string> = {
  placeholder: 'bg-amber-100 text-amber-800',
  'source-offline': 'bg-amber-100 text-amber-900',
  'public-static': 'bg-green-100 text-green-800',
  'metadata-internal': 'bg-slate-100 text-slate-800',
  sharepoint: 'bg-indigo-100 text-indigo-800',
};

function verStatus(item: EvidenceItem): string {
  return item.verification?.status || 'unresolved';
}

function label(th: string, en: string): string {
  return locale === 'th' ? th : en;
}
---

{
  items.length > 0 && (
    <section aria-labelledby={headingId} data-testid="indicator-linked-evidence">
      <h2 id={headingId} class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
        {locale === 'th'
          ? `หลักฐานที่เชื่อมโยง (${items.length})`
          : `Linked Evidence (${items.length})`}
      </h2>

      {
        fy2569Items.length > 0 && (
          <div data-linked-evidence-fy2569>
            <h3 class="text-xs font-semibold text-emerald-700 uppercase tracking-wider mb-2">
              {locale === 'th' ? `หลักฐานปี 2569 (${fy2569Items.length})` : `FY2569 Evidence (${fy2569Items.length})`}
            </h3>
            <ul class="space-y-3" role="list">
              {fy2569Items.map((item) => {
                const ver = verificationLabels[verStatus(item)] || verificationLabels.unresolved;
                const pub = describeEvidencePublication(item, locale, hrefFn);
                const sourceLabel = publicSourceLabel(item, locale);
                const fileName = item.path?.split('/').pop();
                return (
                  <li class="rounded-lg border border-emerald-100 bg-white p-4 shadow-sm">
                    <a
                      href={evidenceHref(item.id)}
                      class="text-sm font-semibold text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                    >
                      {itemTitle(item)}
                    </a>
                    {sourceLabel && (
                      <p class="mt-1 text-xs text-gray-600">{sourceLabel}</p>
                    )}
                    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                      {item.year && (
                        <span class="rounded-full bg-purple-100 px-2 py-0.5 font-medium text-purple-700">
                          {item.year}
                        </span>
                      )}
                      {item.fileType && (
                        <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-medium text-emerald-700">
                          {item.fileType}
                        </span>
                      )}
                      <span class:list={['rounded-full px-2 py-0.5 font-medium', ver.cls]}>
                        {locale === 'th' ? ver.th : ver.en}
                      </span>
                      <span class:list={['rounded-full px-2 py-0.5 font-medium', pubBadgeCls[pub.kind]]}>
                        {pub.label}
                      </span>
                    </div>
                    <div class="mt-3 space-y-2 text-xs text-gray-700">
                      {pub.documentHref && fileName && (
                        <p>
                          <a
                            href={pub.documentHref}
                            class="font-medium text-green-800 underline decoration-green-400 underline-offset-2 hover:text-green-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                          >
                            {label('เปิดไฟล์ต้นฉบับ', 'Open source file')}: {fileName}
                          </a>
                        </p>
                      )}
                      {pub.sharePointUrl && (
                        <p>
                          <a
                            href={pub.sharePointUrl}
                            rel="noopener noreferrer"
                            class="font-medium text-indigo-800 underline decoration-indigo-400 underline-offset-2 hover:text-indigo-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-700 focus-visible:ring-offset-2 rounded"
                          >
                            {label('เปิดบน SharePoint', 'Open on SharePoint')}
                          </a>
                        </p>
                      )}
                      {pub.sharePointPending && !pub.sharePointUrl && (
                        <p class="text-blue-700">{pubLabel(SHAREPOINT_LINK_PENDING, locale)}</p>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }

      {
        baselineItems.length > 0 && (
          <details class="mt-4 rounded-lg border border-gray-200 bg-gray-50/40 p-3" data-linked-evidence-fy2568>
            <summary class="cursor-pointer text-xs font-semibold text-gray-600 hover:text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
              {locale === 'th'
                ? `เอกสารอ้างอิงปีฐาน 2568 (${baselineItems.length})`
                : `FY2568 Baseline Reference (${baselineItems.length})`}
            </summary>
            <div class="mt-3">
              <p class="mb-2 text-[11px] text-gray-400">
                {locale === 'th'
                  ? 'เอกสารปีฐาน 2568 สำหรับการเปรียบเทียบ — ไม่ใช่ผลการดำเนินงานปี 2569'
                  : 'FY2568 baseline documents for comparison only — not FY2569 results'}
              </p>
              <ul class="space-y-3" role="list">
                {baselineItems.map((item) => {
                  const ver = verificationLabels[verStatus(item)] || verificationLabels.unresolved;
                  const pub = describeEvidencePublication(item, locale, hrefFn);
                  const sourceLabel = publicSourceLabel(item, locale);
                  const fileName = item.path?.split('/').pop();
                  return (
                    <li class="rounded-lg border border-gray-100 bg-white p-4 shadow-sm">
                      <a
                        href={evidenceHref(item.id)}
                        class="text-sm font-semibold text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                      >
                        {itemTitle(item)}
                      </a>
                      {sourceLabel && (
                        <p class="mt-1 text-xs text-gray-600">{sourceLabel}</p>
                      )}
                      <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                        {item.year && (
                          <span class="rounded-full bg-purple-100 px-2 py-0.5 font-medium text-purple-700">
                            {item.year}
                          </span>
                        )}
                        {item.fileType && (
                          <span class="rounded-full bg-emerald-100 px-2 py-0.5 font-medium text-emerald-700">
                            {item.fileType}
                          </span>
                        )}
                        <span class:list={['rounded-full px-2 py-0.5 font-medium', ver.cls]}>
                          {locale === 'th' ? ver.th : ver.en}
                        </span>
                        <span class:list={['rounded-full px-2 py-0.5 font-medium', pubBadgeCls[pub.kind]]}>
                          {pub.label}
                        </span>
                      </div>
                      <div class="mt-3 space-y-2 text-xs text-gray-700">
                        {pub.documentHref && fileName && (
                          <p>
                            <a
                              href={pub.documentHref}
                              class="font-medium text-green-800 underline decoration-green-400 underline-offset-2 hover:text-green-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                            >
                              {label('เปิดไฟล์ต้นฉบับ', 'Open source file')}: {fileName}
                            </a>
                          </p>
                        )}
                        {pub.sharePointUrl && (
                          <p>
                            <a
                              href={pub.sharePointUrl}
                              rel="noopener noreferrer"
                              class="font-medium text-indigo-800 underline decoration-indigo-400 underline-offset-2 hover:text-indigo-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-700 focus-visible:ring-offset-2 rounded"
                            >
                              {label('เปิดบน SharePoint', 'Open on SharePoint')}
                            </a>
                          </p>
                        )}
                        {pub.sharePointPending && !pub.sharePointUrl && (
                          <p class="text-blue-700">{pubLabel(SHAREPOINT_LINK_PENDING, locale)}</p>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        )
      }
    </section>
  )
}
