---
/**
 * 1.4.2 Legal Compliance Journey — FY2568 historical baseline.
 * Row assessments from 1.4 register; narrative from 1.4.2; no "100% compliant" claim.
 */
import {
  buildLegalSummary,
  buildLegalRegisterExplorer,
  buildLegalAnomalies,
  buildComplianceEvaluation,
  buildComplianceTopicBreakdown,
  truncateLegalText,
  formatBeDate,
  CAT1_YEAR,
} from '../../utils/category1-legal-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const summary = buildLegalSummary();
const evaluation = buildComplianceEvaluation();
const rows = buildLegalRegisterExplorer();
const needsReviewRows = rows.filter((r) => r.isNeedsReview);
const compliantRows = rows.filter((r) => !r.isNeedsReview);
const topicBreakdown = buildComplianceTopicBreakdown();
const anomalies = buildLegalAnomalies();

const assessmentStatusLabel = (row: (typeof rows)[0]) => {
  if (row.isNeedsReview) return t('ต้องทบทวน', 'Needs review');
  if (row.assessmentStatus === 'compliant') return t('ทะเบียน √ (ไม่ใช่คำตัดสินสุดท้าย)', 'Register √ (not final verdict)');
  return t('ไม่ระบุ', 'Unmarked');
};
const assessmentStatusClass = (row: (typeof rows)[0]) => {
  if (row.isNeedsReview) return 'bg-amber-100 text-amber-950 ring-2 ring-amber-400';
  if (row.assessmentStatus === 'compliant') return 'bg-emerald-50 text-emerald-900 ring-1 ring-emerald-200';
  return 'bg-gray-100 text-gray-700 ring-1 ring-gray-200';
};
---

<div class="cat14-journey space-y-6" data-cat1-legal-compliance data-view="1.4.2">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat142-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.4.2 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.4.2 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat142-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('การประเมินความสอดคล้องของกฎหมาย', 'Legal compliance evaluation')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        'การประเมินรายข้อม derive จากเครื่องหมาย √ ในทะเบียน 1.4 — 1.4.2 เป็น narrative เท่านั้น ไม่มีตารางรายข้อ',
        'Row assessments derive from √ marks in the 1.4 register — 1.4.2 is narrative-only with no row table',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-amber-100 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat142-overview-title">
    <h2 id="cat142-overview-title" class="text-base font-bold text-amber-950">{t('ภาพรวม (ไม่ใช่คะแนน)', 'Overview (not a score)')}</h2>
    <ol class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        [
          { v: summary.assessmentCount, th: 'การประเมินรายข้อ', en: 'Row assessments' },
          { v: summary.registerMarkedCompliant, th: 'ทะเบียน √ ในแหล่ง', en: 'Register √ in source' },
          { v: summary.needsReviewCount, th: 'ต้องทบทวน', en: 'Needs review' },
          { v: summary.requirementsWithEvidence, th: 'มีข้อความหลักฐาน', en: 'With evidence text' },
        ].map((item) => (
          <li class="list-none rounded-stitch border border-amber-200/60 bg-white/80 p-4">
            <p class="text-xs text-amber-900/80">{t(item.th, item.en)}</p>
            <p class="mt-1 font-bold num-tabular text-3xl text-amber-950">{item.v}</p>
          </li>
        ))
      }
    </ol>
    {
      evaluation && (
        <div class="mt-4 rounded-lg border border-amber-200 bg-white p-4">
          <p class="text-sm font-semibold text-on-surface">
            {t('ผลการประเมินเชิงกระบวนการ (1.4.2)', 'Process evaluation (1.4.2)')}:
            <span class="ml-1 inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-900">
              {t('บางส่วน — สัมภาษณ์ยังไม่พร้อม', 'Partial — interview unavailable')}
            </span>
          </p>
          <p class="mt-2 text-xs text-on-surface-variant">
            {t('ผู้ตรวจสอบ', 'Reviewer')}: {evaluation.reviewer}
            {evaluation.compiler && ` · ${t('ผู้จัดทำ', 'Compiler')}: ${evaluation.compiler}`}
          </p>
          {evaluation.reviewDatesNote && (
            <p class="mt-1 text-[11px] text-amber-900" role="note">{evaluation.reviewDatesNote}</p>
          )}
        </div>
      )
    }
    <p class="mt-3 text-xs font-medium text-amber-950" role="note">
      {t(
        'ห้ามตีความว่า “สอดคล้อง 100%” — มีข้อต้องทบทวน ข้อขัดแย้งในแหล่ง และข้อสัมภาษณ์ที่ยังไม่มี',
        'Do not interpret as “100% compliant” — needs-review rows, source conflicts, and missing interview remain',
      )}
    </p>
  </section>

  {
    anomalies.length > 0 && (
      <section class="rounded-xl border border-rose-100 bg-rose-50/40 p-5 shadow-sm sm:p-6" aria-labelledby="cat142-conflicts-title">
        <h2 id="cat142-conflicts-title" class="text-base font-bold text-rose-950">{t('ข้อขัดแย้งในแหล่ง (ยังไม่สรุป)', 'Unresolved source conflicts')}</h2>
        <ul class="mt-3 space-y-2" role="list">
          {
            anomalies.map((a) => (
              <li class="list-none rounded-lg border border-rose-200/80 bg-white/70 p-3 text-sm text-rose-950">
                <span class="font-mono text-xs font-bold">{a.id}</span>
                <p class="mt-1 text-xs leading-relaxed">{a.detail}</p>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    needsReviewRows.length > 0 && (
      <section class="rounded-xl border-2 border-amber-400 bg-amber-50 p-5 shadow-sm sm:p-6" aria-labelledby="cat142-review-title">
        <h2 id="cat142-review-title" class="text-base font-bold text-amber-950">
          {t('ต้องทบทวน (แยกจากสถานะ √ ในทะเบียน)', 'Needs review (separate from register √)')}
        </h2>
        <ul class="mt-3 space-y-3" role="list">
          {
            needsReviewRows.map((row) => (
              <li class="list-none rounded-lg border border-amber-300 bg-white p-4" data-cat142-needs-review>
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <p class="font-mono text-sm font-bold text-amber-950">{row.registerId} · {row.id}</p>
                    <p class="mt-1 text-sm text-on-surface">{truncateLegalText(row.sourceLaw, 160)}</p>
                  </div>
                  <span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-bold ${assessmentStatusClass(row)}`}>
                    {assessmentStatusLabel(row)}
                  </span>
                </div>
                <p class="mt-2 text-xs text-amber-950" role="note">
                  {t(
                    'TDS วัดได้ 702 mg/l เทียบมาตรฐาน ≤500 (28 ส.ค. 2568) — ทะเบียนยังใส่ √ แต่ระบบบันทึก needs_review',
                    'TDS measured 702 mg/l vs standard ≤500 (28 Aug 2568) — register shows √ but system records needs_review',
                  )}
                </p>
                {
                  row.evidenceNote && (
                    <details class="mt-2">
                      <summary class="cursor-pointer text-xs font-medium text-green-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
                        {t('ข้อความหลักฐานในแหล่ง', 'Evidence text in source')}
                      </summary>
                      <p class="mt-1 text-xs leading-relaxed text-on-surface-variant">{truncateLegalText(row.evidenceNote, 400)}</p>
                    </details>
                  )
                }
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat142-topic-title">
    <h2 id="cat142-topic-title" class="text-base font-bold text-on-surface">{t('สรุปตามหัวข้อ', 'Topic-level breakdown')}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <caption class="sr-only">{t('สรุปการประเมินตามหัวข้อ', 'Assessments by topic')}</caption>
        <thead class="border-b border-gray-200 text-xs uppercase tracking-wide text-on-surface-variant">
          <tr>
            <th scope="col" class="px-2 py-2">{t('หัวข้อ', 'Topic')}</th>
            <th scope="col" class="px-2 py-2">{t('รวม', 'Total')}</th>
            <th scope="col" class="px-2 py-2">{t('ทะเบียน √', 'Register √')}</th>
            <th scope="col" class="px-2 py-2">{t('ต้องทบทวน', 'Review')}</th>
            <th scope="col" class="px-2 py-2">{t('ไม่มีข้อความหลักฐาน', 'No evidence text')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {
            topicBreakdown.map((topic) => (
              <tr class={topic.hasSummaryConflict ? 'bg-amber-50/50' : ''}>
                <td class="px-2 py-2 font-medium">
                  {topic.topicTitle}
                  {
                    topic.hasSummaryConflict && (
                      <span class="mt-1 block text-[10px] font-medium text-amber-900">
                        {t('สรุป 1.4.1 ขัดกับ √ ทะเบียน', '1.4.1 summary vs register √')}
                      </span>
                    )
                  }
                </td>
                <td class="px-2 py-2 num-tabular">{topic.total}</td>
                <td class="px-2 py-2 num-tabular">{topic.compliant}</td>
                <td class="px-2 py-2 num-tabular">{topic.needsReview}</td>
                <td class="px-2 py-2 num-tabular">{topic.withoutEvidenceNote}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat142-explorer-title">
    <h2 id="cat142-explorer-title" class="text-base font-bold text-on-surface">{t('สำรวจการประเมินความสอดคล้อง', 'Compliance explorer')}</h2>
    <div class="mt-4 space-y-3" data-cat142-filters>
      <fieldset class="min-w-0">
        <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">{t('สถานะ', 'Status')}</legend>
        <div class="flex flex-wrap gap-1.5">
          <label class="cat14-chip"><input type="radio" name="cat142-status" id="cat142-st-all" value="all" checked class="sr-only" /><span>{t('ทั้งหมด', 'All')}</span></label>
          <label class="cat14-chip"><input type="radio" name="cat142-status" id="cat142-st-ok" value="ok" class="sr-only" /><span>{t('ทะเบียน √', 'Register √')}</span></label>
          <label class="cat14-chip"><input type="radio" name="cat142-status" id="cat142-st-review" value="review" class="sr-only" /><span>{t('ต้องทบทวน', 'Needs review')}</span></label>
          <label class="cat14-chip"><input type="radio" name="cat142-status" id="cat142-st-noev" value="noev" class="sr-only" /><span>{t('ไม่มีข้อความหลักฐาน', 'No evidence text')}</span></label>
        </div>
      </fieldset>
    </div>
    <p class="mt-2 text-[11px] text-on-surface-variant" data-cat142-filter-status aria-live="polite">
      {t(`แสดง ${rows.length} จาก ${rows.length} ข้อ`, `Showing ${rows.length} of ${rows.length} assessments`)}
    </p>

    <ul class="mt-4 space-y-2" role="list" data-cat142-explorer-list>
      {
        rows.map((row) => (
          <li
            class="cat142-row rounded-lg border border-gray-100 bg-gray-50/40 p-3"
            data-cat142-row
            data-status={row.isNeedsReview ? 'review' : 'ok'}
            data-has-evidence={row.hasEvidence ? 'yes' : 'no'}
          >
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="font-mono text-xs font-bold text-on-surface">{row.registerId} · {row.topic}</p>
                <p class="mt-0.5 text-sm text-on-surface">{truncateLegalText(row.sourceLaw, 140)}</p>
              </div>
              <span class={`inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ${assessmentStatusClass(row)}`}>
                {assessmentStatusLabel(row)}
              </span>
            </div>
            <p class="mt-2 text-xs text-on-surface-variant">
              {
                row.hasEvidence && row.evidenceNote
                  ? truncateLegalText(row.evidenceNote, 160)
                  : t('ไม่มีข้อความหลักฐานในแหล่ง', 'No evidence text in source')
              }
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <h2 class="text-base font-bold text-green-950">{t('เชื่อมโยง', 'Related views')}</h2>
    <div class="mt-3 flex flex-wrap gap-3">
      <a href={path('/indicators/1.4.1/')} class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2">
        {t('← 1.4.1 ทะเบียนกฎหมาย', '← 1.4.1 Legal register')}
      </a>
      <a href={path('/indicators/1.3.1/')} class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2">
        {t('← 1.3.1 ประเด็นสิ่งแวดล้อม', '← 1.3.1 Environmental aspects')}
      </a>
    </div>
  </section>
</div>

<style>
  .cat14-journey:has(#cat142-st-ok:checked) [data-cat142-row]:not([data-status='ok']),
  .cat14-journey:has(#cat142-st-review:checked) [data-cat142-row]:not([data-status='review']),
  .cat14-journey:has(#cat142-st-noev:checked) [data-cat142-row]:not([data-has-evidence='no']) {
    display: none;
  }
</style>

<script>
  const root = document.querySelector('[data-cat1-legal-compliance]');
  if (root instanceof HTMLElement) {
    const host = root;
    const rows = [...host.querySelectorAll('[data-cat142-row]')];
    const status = host.querySelector('[data-cat142-filter-status]');
    const filters = host.querySelector('[data-cat142-filters]');
    const total = rows.length;
    const isEn = document.documentElement.lang === 'en';

    function syncStatus() {
      const visible = rows.filter((el) => getComputedStyle(el).display !== 'none').length;
      if (status) {
        status.textContent = isEn
          ? `Showing ${visible} of ${total} assessments`
          : `แสดง ${visible} จาก ${total} ข้อ`;
      }
    }

    filters?.addEventListener('change', () => requestAnimationFrame(syncStatus));
  }
</script>
