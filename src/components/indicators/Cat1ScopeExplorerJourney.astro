---
/**
 * 1.1.1 Scope Explorer — Where we operate (FY2568 historical baseline).
 */
import {
  buildScopeView,
  CAT1_YEAR,
  CAT11_DOCS,
} from '../../utils/category1-foundation-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const scope = buildScopeView();
const internalSum = scope.floor1Sqm + scope.floor2Sqm + scope.floor3Sqm;
---

<div class="cat11-journey space-y-6" data-cat11-scope data-view="1.1.1">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat111-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.1.1 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.1.1 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat111-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('ขอบเขตการจัดการสิ่งแวดล้อม — Where we operate', 'Environmental management scope — Where we operate')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        'ข้อมูลปี 2568 เป็นฐานประวัติ — ไม่ใช่คะแนนสำนักงานสีเขียว',
        'FY2568 historical baseline — not an official Green Office score',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat111-pulse-title" data-cat11-area-pulse>
    <h2 id="cat111-pulse-title" class="text-base font-bold text-on-surface">{t('ภาพรวมพื้นที่', 'Area overview')}</h2>
    <dl class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <dt class="text-xs text-on-surface-variant">{t('รวมขอบเขตรับรอง', 'Total certified scope')}</dt>
        <dd class="mt-1 num-tabular text-3xl font-bold text-primary">{scope.totalSqm.toLocaleString()} <span class="text-sm font-normal">m²</span></dd>
      </div>
      <div class="rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <dt class="text-xs text-on-surface-variant">{t('ภายนอกอาคาร', 'External')}</dt>
        <dd class="mt-1 num-tabular text-2xl font-bold text-on-surface">{scope.externalSqm.toLocaleString()} <span class="text-sm font-normal">m²</span></dd>
      </div>
      <div class="rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <dt class="text-xs text-on-surface-variant">{t('ภายในอาคาร (รวม 3 ชั้น)', 'Internal (3 floors)')}</dt>
        <dd class="mt-1 num-tabular text-2xl font-bold text-on-surface">{internalSum.toLocaleString()} <span class="text-sm font-normal">m²</span></dd>
      </div>
    </dl>
    <p class="mt-3 text-[11px] text-on-surface-variant" aria-live="polite">
      {t(
        `ตรวจสอบ: ${scope.externalSqm} + ${internalSum} = ${scope.totalSqm} m²`,
        `Check: ${scope.externalSqm} + ${internalSum} = ${scope.totalSqm} m²`,
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat111-floor-title" data-cat11-floor-breakdown>
    <h2 id="cat111-floor-title" class="text-base font-bold text-on-surface">{t('แยกตามชั้น / พื้นที่', 'Floor & area breakdown')}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-on-surface-variant">
            <th scope="col" class="px-3 py-2">{t('พื้นที่', 'Area')}</th>
            <th scope="col" class="px-3 py-2 text-right">m²</th>
          </tr>
        </thead>
        <tbody>
          {
            scope.areas.map((a) => (
              <tr class="border-b border-gray-100">
                <td class="px-3 py-2.5">
                  <span class="font-medium text-on-surface">{t(a.labelTh, a.labelEn)}</span>
                  {a.includes && (
                    <p class="mt-0.5 text-[11px] text-on-surface-variant">{a.includes.join(' · ')}</p>
                  )}
                </td>
                <td class="px-3 py-2.5 text-right num-tabular font-semibold">{a.areaSqm.toLocaleString()}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat111-org-title" data-cat11-organizations>
    <h2 id="cat111-org-title" class="text-base font-bold text-on-surface">
      {t(`หน่วยงานในขอบเขต (${scope.organizationCount})`, `Organizations in scope (${scope.organizationCount})`)}
    </h2>
    <ul class="mt-4 space-y-3" role="list">
      {
        scope.organizations.map((org) => (
          <li class="rounded-lg border border-green-100 bg-green-50/30 p-3">
            <p class="text-sm font-medium text-on-surface">{t(org.nameTh, org.nameEn)}</p>
            {org.tableAliases.length > 0 && (
              <p class="mt-1 text-[11px] text-on-surface-variant">
                {t('ชื่อในตารางห้อง:', 'Room table alias:')} {org.tableAliases.join(', ')}
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-xs leading-relaxed text-on-surface-variant">
      {t(
        'ครอบคลุมกิจกรรมภายในและภายนอกตามขอบเขตที่ประกาศ — ไม่ขยายกิจกรรมเกินข้อความในแหล่ง',
        'Covers internal and external activities within declared scope — activities are not inferred beyond source wording',
      )}
    </p>
  </section>

  {
    scope.fy2567FeedbackAddressed && (
      <section class="rounded-xl border border-blue-100 bg-blue-50/40 p-5 shadow-sm sm:p-6" aria-labelledby="cat111-feedback-title">
        <h2 id="cat111-feedback-title" class="text-base font-bold text-blue-950">
          {t('ปรับปรุงจากผลประเมินปี 2567', 'FY2567 assessment feedback addressed')}
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-blue-900">{t(scope.contextNoteTh, scope.contextNoteEn)}</p>
      </section>
    )
  }

  <section class="rounded-xl border border-amber-100 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat111-room-gap-title">
    <h2 id="cat111-room-gap-title" class="text-base font-bold text-amber-950">{t('หลักฐานห้อง/กิจกรรม', 'Room & activity evidence')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-amber-900">
      <span class="font-semibold">{t('สถานะ:', 'Status:')} </span>
      {t('บางส่วน (PARTIAL)', 'Partial (PARTIAL)')}
    </p>
    <p class="mt-1 text-xs leading-relaxed text-amber-800">{t(scope.roomInventoryNoteTh, scope.roomInventoryNoteEn)}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat111-cross-title">
    <h2 id="cat111-cross-title" class="text-base font-bold text-on-surface">{t('เชื่อมโยง', 'Cross-links')}</h2>
    <p class="mt-2 text-sm">
      <a href={path('/indicators/1.7.2/')} class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('1.7.2 การทบทวนฝ่ายบริหาร — มติขอบเขต 9,873 m²', '1.7.2 Management review — scope decision 9,873 m²')}
      </a>
    </p>
    <details class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50/80 p-3">
      <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('แหล่งอ้างอิง', 'Source evidence')}
      </summary>
      <ul class="mt-2 space-y-1 text-xs text-on-surface-variant" role="list">
        <li>{scope.sourceRef}</li>
        <li>
          <a href={withBase(CAT11_DOCS.scopePdf)} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded" target="_blank" rel="noopener noreferrer">
            1.1.1 (9-3-69).pdf
          </a>
        </li>
      </ul>
    </details>
  </section>
</div>
