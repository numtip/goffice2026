---
/**
 * 1.6.1 GHG Reduction Plan Journey — FY2568 PARTIAL plan status; no invented activities.
 */
import {
  buildReductionPlan,
  buildPerformanceGapDisclaimer,
  buildProjectPortfolio,
  ghgImpactPresentation,
  planElementStatusLabel,
  CAT1_YEAR,
  CAT16_DOCS,
} from '../../utils/category1-projects-presentation';
import { buildGhgPerformance } from '../../utils/category1-ghg-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const plan = buildReductionPlan();
const gapDisclaimer = buildPerformanceGapDisclaimer();
const perf = buildGhgPerformance();
const projects = buildProjectPortfolio();

function statusRing(status: string): string {
  if (status === 'supported') return 'ring-green-300 bg-green-50 text-green-900';
  if (status === 'partial') return 'ring-amber-300 bg-amber-50 text-amber-950';
  return 'ring-gray-300 bg-gray-50 text-gray-700';
}
---

<div class="cat16-journey space-y-6" data-cat1-projects-plan data-view="1.6.1">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat161-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.6.1 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.6.1 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat161-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('แผนการดำเนินงานลดก๊าซเรือนกระจก', 'GHG reduction action plan')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        'สรุปจากสัญญาข้อมูล projects.json และแหล่ง 1.6.1 — ไม่ใช่คะแนนสำนักงานสีเขียว',
        'Summary from projects.json contract and 1.6.1 sources — not an official Green Office score',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat161-pulse-title">
    <h2 id="cat161-pulse-title" class="text-base font-bold text-amber-950">{t('สถานะแผน', 'Plan readiness')}</h2>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-950 ring-1 ring-amber-400">
        {t('PARTIAL — ไม่ครบทุกองค์ประกอบ', 'PARTIAL — not all elements verified locally')}
      </span>
      <span class="text-xs text-amber-900">{plan.title}</span>
    </div>
    <p class="mt-2 text-sm leading-relaxed text-amber-900">{plan.period}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat161-elements-title">
    <h2 id="cat161-elements-title" class="text-base font-bold text-on-surface">
      {t('องค์ประกอบที่รองรับ vs บางส่วน', 'Supported vs partial elements')}
    </h2>
    <ul class="mt-4 space-y-3" role="list">
      {
        plan.elements.map((el) => (
          <li class={`rounded-lg border p-3 ring-1 ${statusRing(el.status)}`}>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <span class="text-sm font-semibold">{t(el.labelTh, el.labelEn)}</span>
              <span class="shrink-0 rounded-full bg-white/80 px-2 py-0.5 text-[11px] font-medium ring-1 ring-inherit">
                {planElementStatusLabel(el.status, locale)}
              </span>
            </div>
            <p class="mt-1.5 text-xs leading-relaxed">{t(el.detailTh, el.detailEn)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat161-policy-title">
    <h2 id="cat161-policy-title" class="text-base font-bold text-on-surface">
      {t('เชื่อมโยงนโยบายและเป้าหมาย', 'Policy & target linkage')}
    </h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-on-surface" role="list">
      <li>
        {t(
          'อ้างอิงนโยบายสำนักงานสีเขียว FY2568 (ลงนาม 25 มี.ค. 2568) ข้อ 8 — รณรงค์ลด GHG',
          'References FY2568 Green Office policy (signed 25 Mar 2568) §8 — continuous GHG reduction campaign',
        )}
      </li>
      <li>
        <a
          href={path('/indicators/1.1.3/')}
          class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
        >
          {t('เป้าหมายสิ่งแวดล้อม 1.1.3', 'Environmental targets 1.1.3')}
        </a>
        {t(' (ฐานปี 2567)', ' (FY2567 base)')}
      </li>
    </ul>
    {
      plan.activitiesSourceStatus === 'external-not-in-repo' && (
        <details class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50/80 p-3">
          <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t('ตารางกิจกรรมรายละเอียด — ไม่พร้อมใน repo', 'Detailed activity schedule — not in repo')}
          </summary>
          <p class="mt-2 text-xs leading-relaxed text-on-surface-variant">
            {t(
              `แหล่ง 1.6.1 อ้างไฟล์แนบ ERP (${plan.activitiesSourceRef}) ซึ่งไม่ได้เก็บใน repository — จึงไม่แสดงรายการกิจกรรมที่สร้างขึ้นเอง`,
              `1.6.1 cites an ERP attachment (${plan.activitiesSourceRef}) not stored in the repository — activity details are not invented here`,
            )}
          </p>
        </details>
      )
    }
  </section>

  <section class="rounded-xl border border-rose-100 bg-rose-50/40 p-5 sm:p-6" aria-labelledby="cat161-gap-title" data-cat16-gap-disclaimer>
    <h2 id="cat161-gap-title" class="text-base font-bold text-rose-950">{t('ความสัมพันธ์กับ 1.5.2', 'Relationship to 1.5.2')}</h2>

    <dl class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
      <div class="rounded-lg border border-rose-200 bg-white/70 p-3">
        <dt class="text-xs text-rose-800">{t('เป้าหมายลด GHG ปี 2568', 'FY2568 GHG reduction target')}</dt>
        <dd class="mt-1 text-lg font-bold text-rose-950">−{perf.targetReductionPct}%</dd>
      </div>
      <div class="rounded-lg border border-rose-200 bg-white/70 p-3">
        <dt class="text-xs text-rose-800">{t('ผลจริง FY2568', 'FY2568 actual')}</dt>
        <dd class="mt-1 text-lg font-bold text-rose-950">+{perf.actualChangePct}% <span class="text-xs font-normal text-rose-700">{t('(เพิ่มขึ้น)', '(increase)')}</span></dd>
      </div>
      <div class="rounded-lg border border-rose-200 bg-white/70 p-3">
        <dt class="text-xs text-rose-800">{t('สถานะ', 'Status')}</dt>
        <dd class="mt-1 text-lg font-bold text-rose-950">{t('ยังไม่บรรลุ', 'Not met')}</dd>
      </div>
    </dl>

    <p class="mt-3 text-sm leading-relaxed text-rose-900">{isEn ? gapDisclaimer.en : gapDisclaimer.th}</p>

    <h3 class="mt-4 text-sm font-bold text-rose-950">{t('โครงการ 1.6 กับช่องว่าง GHG', '1.6 projects vs the GHG gap')}</h3>
    <ul class="mt-2 space-y-2" role="list">
      {
        projects.map((project) => {
          const impact = ghgImpactPresentation(project.ghgImpactStatus, locale);
          return (
            <li class="rounded-lg border border-rose-200 bg-white/70 p-3">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <p class="text-sm font-semibold text-rose-950">{project.title}</p>
                <span class={`inline-flex shrink-0 items-center rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${impact.badgeClass}`}>
                  {impact.label}
                </span>
              </div>
              <p class="mt-1 text-xs leading-relaxed text-rose-800">{impact.description}</p>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-4 rounded-lg border border-dashed border-rose-300 bg-rose-50 p-3">
      <p class="text-xs font-semibold text-rose-950">{t('รายงานการทบทวนฝ่ายบริหาร (1.7.2)', 'Management review report (1.7.2)')}</p>
      <p class="mt-1 text-xs leading-relaxed text-rose-900">
        {t(
          'การประชุมครั้งที่ 1/2568 (7 มี.ค. 2568) เห็นชอบแผนการดำเนินงาน 2568 (Big Cleaning รายเดือน, ตรวจร่องรอยสัตว์พาหะ, ความเข้มแสงสว่าง) แต่ไม่ได้อ้างชื่อโครงการ 1.6 และไม่ได้ทบทวนผล GHG +4.81% อย่างชัดเจน — ยังไม่สามารถแสดงการปิดช่องว่าง GHG จากโครงการได้',
          'MR#1 (7 Mar 2568) approved the FY2568 plan (monthly Big Cleaning, pest-trace inspection, lighting checks) but does not name 1.6 projects nor explicitly review the +4.81% GHG result — the projects cannot yet be shown to close the GHG gap',
        )}
      </p>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('แหล่งอ้างอิง', 'Sources')}</h2>
    <ul class="mt-3 space-y-1 text-sm" role="list">
      <li>
        <a href={CAT16_DOCS.plan161} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded break-all">
          {t('1.6.1 หลักฐานแผน (PDF)', '1.6.1 Plan evidence (PDF)')}
        </a>
      </li>
      <li>
        <a href={CAT16_DOCS.master} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded break-all">
          {t('ประกอบข้อ 1.6 (DOCX)', 'ประกอบข้อ 1.6 master (DOCX)')}
        </a>
      </li>
    </ul>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={path('/indicators/1.5.2/')}
        class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('← 1.5.2 ผลการปล่อย GHG', '← 1.5.2 GHG performance')}
      </a>
      <a
        href={path('/indicators/1.7.1/')}
        class="inline-flex min-h-11 items-center rounded-stitch bg-primary px-4 py-2.5 text-sm font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('ไปที่ 1.7.1 การทบทวนฝ่ายบริหาร', 'Continue to 1.7.1 management review')}
      </a>
    </div>
    <p class="mt-2 text-[10px] text-on-surface-variant">
      {t(
        'FY2568 ไม่ได้เชื่อมโครงการ 1.6 กับการปิดช่องว่าง GHG +4.81% อย่างชัดเจนในรายงานการทบทวน',
        'FY2568 sources do not explicitly link 1.6 projects to closing the +4.81% GHG gap in management review',
      )}
    </p>
  </section>
</div>
