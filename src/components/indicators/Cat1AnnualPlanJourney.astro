---
/**
 * 1.1.4 Annual Action Plan Journey — How we execute (shared proj-plan-1 with 1.6.1).
 */
import {
  buildAnnualPlanView,
  CAT1_YEAR,
  CAT11_DOCS,
} from '../../utils/category1-foundation-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const plan = buildAnnualPlanView();

const readinessItems = [
  {
    id: 'written',
    labelTh: 'แผนลายลักษณ์อักษร',
    labelEn: 'Written plan',
    ok: plan.writtenPlan,
  },
  {
    id: 'categories',
    labelTh: `ครอบคลุม ${plan.categoryCoverage} หมวด`,
    labelEn: `Covers ${plan.categoryCoverage} categories`,
    ok: plan.categoryCoverage === 7,
  },
  {
    id: 'approval',
    labelTh: `อนุมัติผู้บริหาร ${plan.approvingOrganizationCount} หน่วยงาน`,
    labelEn: `Approved by ${plan.approvingOrganizationCount} organizations' management`,
    ok: plan.executiveApproved,
  },
  {
    id: 'planned-actual',
    labelTh: 'แผน vs ผล — แยกสถานะ',
    labelEn: 'Planned vs actual — separate states',
    ok: plan.plannedVsActualSeparate,
  },
];
---

<div class="cat11-journey space-y-6" data-cat11-plan data-view="1.1.4" data-proj-plan-id={plan.id}>
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat114-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.1.4 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.1.4 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat114-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('แผนดำเนินงานประจำปี — How we execute', 'Annual action plan — How we execute')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        `เอกสารแผนเดียวกับ 1.6.1 (${plan.id}) — ไม่ใช่คะแนนสำนักงานสีเขียว`,
        `Same plan document as 1.6.1 (${plan.id}) — not an official Green Office score`,
      )}
    </p>
  </section>

  <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat114-readiness-title" data-cat11-plan-readiness>
    <h2 id="cat114-readiness-title" class="text-base font-bold text-amber-950">{t('ความพร้อมของแผน', 'Plan readiness')}</h2>
    <ul class="mt-4 space-y-2" role="list">
      {
        readinessItems.map((item) => (
          <li class={`flex flex-wrap items-center justify-between gap-2 rounded-lg border p-3 ${item.ok ? 'border-green-200 bg-green-50/40' : 'border-gray-200 bg-gray-50'}`}>
            <span class="text-sm font-medium text-on-surface">{t(item.labelTh, item.labelEn)}</span>
            <span class="text-xs font-semibold uppercase tracking-wide">
              {item.ok ? t('รองรับ', 'Supported') : t('ไม่ครบ', 'Incomplete')}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-sm text-amber-900">{plan.period}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat114-coverage-title" data-cat11-plan-categories>
    <h2 id="cat114-coverage-title" class="text-base font-bold text-on-surface">{t('ครอบคลุม 7 หมวด', 'Seven-category coverage')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
      {t(
        'แผนประจำปี FY2568 ครอบคลุมกิจกรรมทุกหมวดตามเกณฑ์ — รายละเอียดตารางใน PDF เป็นภาพ',
        'FY2568 annual plan covers all Green Office categories — table detail is image-only in PDF',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat114-schedule-title" data-cat11-plan-schedule>
    <h2 id="cat114-schedule-title" class="text-base font-bold text-on-surface">{t('กำหนดเวลา / ความถี่', 'Timing & frequency')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
      {t(
        `ระยะเวลาดำเนินงาน ${plan.durationYears} ปี — คอลัมน์แผนและผลแยกกันในแหล่ง (ไม่แสดงรายการที่สร้างขึ้นเอง)`,
        `${plan.durationYears}-year execution scope — planned and actual columns are separate in source (rows not invented here)`,
      )}
    </p>
    {
      plan.activitiesSourceStatus === 'external-not-in-repo' && (
        <details class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50/80 p-3">
          <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t('ตารางกิจกรรม ERP — ไม่พร้อมใน repo', 'ERP activity schedule — not in repo')}
          </summary>
          <p class="mt-2 text-xs leading-relaxed text-on-surface-variant">{plan.activitiesSourceRef}</p>
        </details>
      )
    }
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat114-truth-title" data-cat11-plan-truthfulness>
    <h2 id="cat114-truth-title" class="text-base font-bold text-on-surface">{t('ความจริงของแผน vs ผล', 'Plan vs actual truthfulness')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{t(plan.planTableNoteTh, plan.planTableNoteEn)}</p>
    <p class="mt-2 text-xs font-semibold text-amber-900">
      {t('สถานะตารางแผน:', 'Plan table status:')} {plan.planTableStatus.replace('_', ' ')}
    </p>
  </section>

  <section class="rounded-xl border border-primary/20 bg-primary/5 p-5 shadow-sm sm:p-6" aria-labelledby="cat114-cta-title">
    <h2 id="cat114-cta-title" class="text-base font-bold text-on-surface">{t('ขั้นถัดไป', 'Next step')}</h2>
    <p class="mt-2 text-sm">
      <a href={path('/indicators/1.6.1/')} class="inline-flex items-center font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('→ 1.6.1 แผนลด GHG (เอกสารเดียวกัน)', '→ 1.6.1 GHG reduction plan (same document)')}
      </a>
    </p>
    <p class="mt-2 text-sm">
      <a href={path('/indicators/1.1.3/')} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded">
        {t('← 1.1.3 เป้าหมายที่แผนอ้างอิง', '← 1.1.3 targets referenced by plan')}
      </a>
    </p>
  </section>

  <details class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-5">
    <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
      {t('แหล่งอ้างอิง', 'Source evidence')}
    </summary>
    <ul class="mt-3 space-y-1 text-xs text-on-surface-variant" role="list">
      <li>{plan.sourceRef}</li>
      {plan.coSourceRef && <li>{plan.coSourceRef}</li>
      <li>
        <a href={withBase(CAT11_DOCS.planPdf)} class="text-primary hover:underline" target="_blank" rel="noopener noreferrer">
          1.1.4 (9-3-69).pdf
        </a>
      </li>
    </ul>
  </details>
</div>
