---
/**
 * 1.7.2 Management Review Meeting Journey — FY2568 frequency, Meeting #1 decisions, Meeting #2 gap.
 */
import {
  buildFrequencyPlan,
  buildMeeting,
  buildDecisions,
  buildMeetingOneAgendaTopics,
  buildUpstreamCoverage,
  buildPdcaLinks,
  buildPresentationGaps,
  buildAdditionalGaps,
  CAT1_YEAR,
  MR_EVIDENCE,
} from '../../utils/category1-management-review-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

function coverageLabel(status: string): { th: string; en: string } {
  switch (status) {
    case 'explicitly_reviewed':
      return { th: 'ทบทวนอย่างชัดเจน', en: 'Explicitly reviewed' };
    case 'referenced_only':
      return { th: 'อ้างอิงเท่านั้น', en: 'Referenced only' };
    default:
      return { th: 'ไม่พบในแหล่ง', en: 'Not found in source' };
  }
}

const frequency = buildFrequencyPlan();
const meeting1 = buildMeeting('mr-meeting-1');
const meeting2 = buildMeeting('mr-meeting-2');
const decisions = buildDecisions('mr-meeting-1');
const agendaTopics = buildMeetingOneAgendaTopics();
const coverage = buildUpstreamCoverage();
const pdcaLinks = buildPdcaLinks();
const gaps = [...buildPresentationGaps(), ...buildAdditionalGaps()];
---

<div class="cat17-journey space-y-6" data-cat1-management-review-meeting data-view="1.7.2">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.7.2 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.7.2 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat172-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('วาระการประชุมและการทบทวนฝ่ายบริหาร', 'Management review meetings & decisions')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        'Decision & PDCA Story จากแหล่ง 1.7.2 — ไม่ใช่คะแนนสำนักงานสีเขียว',
        'Decision & PDCA story from source 1.7.2 — not an official Green Office score',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-freq-title">
    <h2 id="cat172-freq-title" class="text-base font-bold text-on-surface">{t('ความถี่การประชุม', 'Meeting frequency')}</h2>
    <p class="mt-2 text-sm text-on-surface">
      {t(
        `แผน ${frequency.plannedPerYear} ครั้ง/ปี (${frequency.plannedMonths.join(' + ')})`,
        `Plan: ${frequency.plannedPerYear} meetings/year (${frequency.plannedMonths.join(' + ')})`,
      )}
    </p>
    <ul class="mt-3 space-y-2 text-sm" role="list">
      <li class="flex flex-wrap items-center gap-2">
        <span class="font-medium">{meeting1.meetingNumber}</span>
        <span>{meeting1.dateBE}</span>
        <span class="inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-900 ring-1 ring-green-300">
          content-verified
        </span>
      </li>
      <li class="flex flex-wrap items-center gap-2">
        <span class="font-medium">{meeting2.meetingNumber}</span>
        <span>{meeting2.dateBE}</span>
        <span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-950 ring-1 ring-amber-300">
          occurrence_supported
        </span>
      </li>
    </ul>
    <p class="mt-3 text-xs text-on-surface-variant">
      {t(
        'ไม่อ้างว่ามี 2 ครั้งที่ verified ครบทุกด้าน — ครั้งที่ 2 มีเพียงหลักฐานภาพถ่าย',
        'Does not claim two fully verified meetings — Meeting #2 is photo evidence only',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-agenda-title">
    <h2 id="cat172-agenda-title" class="text-base font-bold text-on-surface">
      {t(`วาระทบทวน — ${meeting1.meetingNumber}`, `Review coverage — ${meeting1.meetingNumber}`)}
    </h2>
    <details class="mt-3" open>
      <summary class="cursor-pointer text-sm font-semibold text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('หัวข้อที่พบในรายงานการประชุม', 'Topics found in meeting minutes')}
      </summary>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-on-surface" role="list">
        {agendaTopics.map((topic) => (
          <li>{isEn ? topic.labelEn : topic.labelTh}</li>
        ))}
      </ol>
    </details>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-decisions-title" data-cat17-decision-timeline>
    <h2 id="cat172-decisions-title" class="text-base font-bold text-on-surface">
      {t('ไทม์ไลน์มติ (Meeting #1)', 'Decision timeline (Meeting #1)')}
    </h2>
    <ol class="mt-4 space-y-4" role="list">
      {decisions.map((d, idx) => (
        <li class="rounded-lg border border-gray-100 bg-gray-50/60 p-4">
          <p class="text-xs font-semibold text-on-surface-variant">
            {t(`มติที่ ${idx + 1}`, `Decision ${idx + 1}`)} · {d.decisionType}
          </p>
          <p class="mt-1 text-sm leading-relaxed text-on-surface">{isEn ? d.textEn : d.text}</p>
          {d.pdcaTarget && (
            <p class="mt-2 text-xs text-primary">
              PDCA → {d.pdcaTarget}
            </p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-coverage-title" data-cat17-coverage-matrix>
    <h2 id="cat172-coverage-title" class="text-base font-bold text-on-surface">
      {t('เมทริกซ์การครอบคลุม upstream CAT1', 'Upstream CAT1 coverage matrix')}
    </h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-xs text-on-surface-variant">
            <th class="py-2 pr-4 font-semibold">{t('โดเมน', 'Domain')}</th>
            <th class="py-2 pr-4 font-semibold">{t('สถานะ', 'Status')}</th>
            <th class="py-2 font-semibold">{t('หมายเหตุ', 'Note')}</th>
          </tr>
        </thead>
        <tbody>
          {coverage.map((row) => {
            const lbl = coverageLabel(row.status);
            return (
              <tr class="border-b border-gray-100">
                <td class="py-2 pr-4 font-medium">{row.domain}</td>
                <td class="py-2 pr-4">
                  <span class="inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-on-surface ring-1 ring-gray-200">
                    {isEn ? lbl.en : lbl.th}
                  </span>
                </td>
                <td class="py-2 text-xs text-on-surface-variant">
                  {isEn ? row.noteEn || '—' : row.noteTh || '—'}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat172-pdca-title" data-cat17-pdca-links>
    <h2 id="cat172-pdca-title" class="text-base font-bold text-on-surface">
      {t('Review → Decision → Updated management control', 'Review → Decision → Updated management control')}
    </h2>
    <ul class="mt-3 space-y-3" role="list">
      {pdcaLinks.map((link) => (
        <li class="rounded-lg border border-green-100 bg-green-50/30 p-3">
          <a
            href={path(`/indicators/${link.to}/`)}
            class="text-sm font-semibold text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
          >
            {isEn ? link.labelEn : link.labelTh}
          </a>
          <p class="mt-1 text-xs text-on-surface-variant">{isEn ? link.noteEn : link.noteTh}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rounded-xl border border-amber-100 bg-amber-50/40 p-5 shadow-sm sm:p-6" aria-labelledby="cat172-m2-title" data-cat17-meeting2-panel>
    <h2 id="cat172-m2-title" class="text-base font-bold text-amber-950">
      {t(`การประชุม ${meeting2.meetingNumber}`, `Meeting ${meeting2.meetingNumber}`)}
    </h2>
    <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-semibold text-amber-900">{t('วันที่', 'Date')}</dt>
        <dd class="text-amber-950">{meeting2.dateBE}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-amber-900">{t('เวลา / ห้อง', 'Time / room')}</dt>
        <dd class="text-amber-950">{meeting2.startTime}–{meeting2.endTime} · {meeting2.room}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-amber-900">{t('หลักฐาน', 'Evidence')}</dt>
        <dd class="text-amber-950">{t('ภาพถ่าย (photo)', 'Photo caption')}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold text-amber-900">{t('วาระ / รายงาน / มติ / quorum', 'Agenda / minutes / decisions / quorum')}</dt>
        <dd class="text-amber-950">not_locally_verified</dd>
      </div>
    </dl>
    <p class="mt-3 text-xs text-amber-900">
      {t('ไม่สร้างเนื้อหาจากภาพถ่าย — มติที่บันทึก: 0', 'No content fabricated from photos — recorded decisions: 0')}
    </p>
  </section>

  <section class="rounded-xl border border-amber-100 bg-amber-50/30 p-5 shadow-sm sm:p-6" aria-labelledby="cat172-gaps-title" data-cat17-gaps-panel>
    <h2 id="cat172-gaps-title" class="text-base font-bold text-amber-950">{t('ช่องว่างที่เปิดเผย', 'Disclosed gaps')}</h2>
    <ul class="mt-3 space-y-2 text-sm leading-relaxed text-amber-950" role="list">
      {gaps.map((g) => (
        <li>
          <span class="font-semibold">{g.indicator}</span> ({g.status}): {isEn ? g.noteEn : g.noteTh}
        </li>
      ))}
    </ul>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('แหล่งหลักฐาน', 'Source evidence')}</h2>
    <ul class="mt-3 space-y-1 text-sm" role="list">
      <li>
        <a href={MR_EVIDENCE.minutesDocx} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t('1.7.2 วาระ/ประชุม (DOCX)', '1.7.2 Agenda/minutes (DOCX)')}
        </a>
      </li>
      <li>
        <a href={MR_EVIDENCE.minutesPdf} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t('1.7.2 วาระ/ประชุม (PDF)', '1.7.2 Agenda/minutes (PDF)')}
        </a>
      </li>
    </ul>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={path('/indicators/1.7.1/')}
        class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('← 1.7.1 องค์ประชุม', '← 1.7.1 Quorum')}
      </a>
      <a
        href={path('/categories/cat1/')}
        class="inline-flex min-h-11 items-center rounded-stitch bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('กลับหมวด 1', 'Back to Category 1')}
      </a>
    </div>
  </section>
</div>
