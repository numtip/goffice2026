---
import {
  buildCat1DomainSnapshot,
  contractForDomain,
  domainForIndicator,
  MISSING_CAT1_INDICATORS,
  relatedIndicatorsFor,
  resolveDomainFactValue,
  type Cat1Domain,
  CAT1_YEAR,
} from '../../utils/category1-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  indicatorCode: string;
  locale: 'th' | 'en';
}

const { indicatorCode, locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const domain = domainForIndicator(indicatorCode);
const isMissing = (MISSING_CAT1_INDICATORS as readonly string[]).includes(indicatorCode);
const relations = relatedIndicatorsFor(indicatorCode);

const domainLabel: Record<Cat1Domain, { th: string; en: string }> = {
  'activities-aspects': { th: 'ขอบเขต (1.1.1)', en: 'Scope (1.1.1)' },
  laws: { th: 'กฎหมาย (1.4.1)', en: 'Laws (1.4.1)' },
  compliance: { th: 'ความสอดคล้อง (1.4.2)', en: 'Compliance (1.4.2)' },
  targets: { th: 'เป้าหมาย (1.1.3)', en: 'Targets (1.1.3)' },
  ghg: { th: 'ก๊าซเรือนกระจก (1.5.1 / 1.5.2)', en: 'GHG (1.5.1 / 1.5.2)' },
  projects: { th: 'โครงการและการลด (1.6)', en: 'Projects & reduction (1.6)' },
  'management-review': { th: 'การทบทวนฝ่ายบริหาร (1.7)', en: 'Management review (1.7)' },
  'environmental-aspects-2568': { th: 'ทะเบียนประเด็นสิ่งแวดล้อม (1.3)', en: 'Environmental aspects register (1.3)' },
};

const snapshot = domain ? buildCat1DomainSnapshot(domain) : null;
const sources = domain ? contractForDomain(domain).records.map((r) => r.sourceRef).filter(Boolean) : [];
const uniqueSources = [...new Set(sources)];
const sourceCount = uniqueSources.length;
const verificationStatus = domain
  ? [...new Set(contractForDomain(domain).records.map((r) => r.verification?.status).filter(Boolean))]
  : [];
---

<div
  class="rounded-xl border border-green-100 bg-green-50/30 p-5"
  aria-labelledby="cat1-contract-context"
  data-cat1-contract-context
  data-indicator-code={indicatorCode}
>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
    <h2 id="cat1-contract-context" class="text-sm font-semibold text-gray-900">
      {isEn ? `FY${CAT1_YEAR} contract context` : `บริบทข้อมูลสัญญา ปี ${CAT1_YEAR}`}
    </h2>
    {
      domain && (
        <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-[11px] font-medium text-green-800">
          {t(domainLabel[domain])}
        </span>
      )
    }
  </div>

  {
    isMissing ? (
      <div class="rounded-lg border border-amber-100 bg-amber-50/50 p-3" data-cat1-missing-notice>
        <p class="text-sm font-medium text-amber-800">
          {isEn
            ? `Indicator ${indicatorCode}: FY2568 assessment evidence is not available`
            : `ตัวชี้วัด ${indicatorCode}: ยังไม่มีหลักฐานการประเมินปี 2568`}
        </p>
        <p class="mt-1 text-xs leading-relaxed text-amber-700">
          {isEn
            ? 'No interview/training assessment record exists in the FY2568 source set. This item is recorded as unavailable and is not filled in.'
            : 'ไม่พบบันทึกการสัมภาษณ์/การอบรมประเมินในชุดแหล่งข้อมูลปี 2568 รายการนี้ถูกบันทึกว่าไม่พร้อมใช้งานและไม่ได้เติมข้อมูล'}
        </p>
      </div>
    ) : snapshot ? (
      <>
        <ul class="space-y-1.5" role="list">
          {
            snapshot.facts.map((fact) => (
              <li class="flex items-baseline justify-between gap-3 text-xs">
                <span class="text-gray-500">{t(fact.label)}</span>
                <span class={`font-medium ${fact.kind === 'unavailable' ? 'text-gray-400' : fact.kind === 'status' ? 'text-amber-700' : 'text-gray-800'}`} data-cat1-domain-fact={fact.kind}>
                  {resolveDomainFactValue(fact.value, locale)}
                </span>
              </li>
            ))
          }
        </ul>
        <dl class="mt-3 space-y-1 border-t border-green-100 pt-2 text-xs">
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Source files' : 'ไฟล์ต้นทาง'}</dt>
            <dd class="font-medium text-gray-700" data-cat1-source-count>{sourceCount}</dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Verification' : 'สถานะการตรวจสอบ'}</dt>
            <dd class="font-medium text-gray-700">
              {verificationStatus.length > 0 ? verificationStatus.join(', ') : '—'}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt class="text-gray-500">{isEn ? 'Contract status' : 'สถานะสัญญา'}</dt>
            <dd class="font-medium text-gray-700">{snapshot.status}</dd>
          </div>
        </dl>
      </>
    ) : (
      <p class="text-xs italic text-gray-400">
        {isEn ? 'No FY2568 contract domain maps to this indicator.' : 'ไม่มีโดเมนสัญญาข้อมูลปี 2568 สำหรับตัวชี้วัดนี้'}
      </p>
    )
  }

  {
    relations.length > 0 && (
      <div class="mt-3 border-t border-green-100 pt-2">
        <h3 class="mb-1.5 text-xs font-semibold text-gray-500 uppercase tracking-wider">
          {isEn ? 'Related indicators' : 'ตัวชี้วัดที่เกี่ยวข้อง'}
        </h3>
        <ul class="space-y-1" role="list">
          {
            relations.map((rel) => (
              <li>
                <a
                  href={path(`/indicators/${rel.to}/`)}
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
                >
                  <span>{rel.to}</span>
                  <span class="text-gray-400">·</span>
                  <span>{t(rel.label)}</span>
                </a>
                <p class="text-[11px] text-gray-400">{t(rel.reason)}</p>
              </li>
            ))
          }
        </ul>
      </div>
    )
  }
</div>
