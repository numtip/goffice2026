---
/**
 * 1.1.3 Environmental Target Board — What we aim to reduce.
 */
import {
  buildTargetBoard,
  CAT1_YEAR,
  CAT11_DOCS,
} from '../../utils/category1-foundation-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const targets = buildTargetBoard();

function formatPct(p: number): string {
  return p > 0 ? `+${p}%` : `${p}%`;
}
---

<div class="cat11-journey space-y-6" data-cat11-targets data-view="1.1.3">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat113-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.1.3 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.1.3 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat113-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('เป้าหมายสิ่งแวดล้อม — What we aim to reduce', 'Environmental targets — What we aim to reduce')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        'เป้าหมายสุดท้ายที่มีผลเทียบปีฐาน 2567 — ไม่ใช่คะแนนสำนักงานสีเขียว',
        'Final effective targets vs FY2567 baseline — not an official Green Office score',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat113-board-title" data-cat11-target-board>
    <h2 id="cat113-board-title" class="text-base font-bold text-on-surface">{t('เป้าหมาย 6 ด้าน', 'Six target domains')}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-on-surface-variant">
            <th scope="col" class="px-3 py-2">{t('ด้าน', 'Domain')}</th>
            <th scope="col" class="px-3 py-2 text-right">{t('เป้าหมาย', 'Target')}</th>
            <th scope="col" class="px-3 py-2 text-right">{t('ค่า (สัญญา)', 'Contract value')}</th>
            <th scope="col" class="px-3 py-2">{t('หน่วย', 'Unit')}</th>
          </tr>
        </thead>
        <tbody>
          {
            targets.map((row) => (
              <tr class="border-b border-gray-100">
                <td class="px-3 py-2.5 font-medium text-on-surface">{t(row.labelTh, row.labelEn)}</td>
                <td class="px-3 py-2.5 text-right num-tabular font-bold text-primary">{formatPct(row.targetPercent)}</td>
                <td class="px-3 py-2.5 text-right num-tabular">{row.value.toLocaleString(undefined, { maximumFractionDigits: 2 })}</td>
                <td class="px-3 py-2.5 text-xs text-on-surface-variant">{row.unit}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[11px] text-on-surface-variant">
      {t(`อ้างอิงปีฐาน: ${targets[0]?.comparisonBasis ?? 'FY2567'}`, `Comparison basis: ${targets[0]?.comparisonBasis ?? 'FY2567'}`)}
    </p>
  </section>

  {
    targets.filter((t) => t.amendmentNoteTh).map((row) => (
      <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat113-paper-amend" data-cat11-paper-amendment>
        <h2 id="cat113-paper-amend" class="text-base font-bold text-amber-950">{t('การแก้ไขเป้าหมายกระดาษ', 'Paper target amendment')}</h2>
        <p class="mt-2 text-sm font-semibold text-amber-950 num-tabular">−1% → −3%</p>
        <p class="mt-1 text-sm leading-relaxed text-amber-900">{isEn ? row.amendmentNoteEn : row.amendmentNoteTh}</p>
        <p class="mt-2 text-sm">
          <a href={path('/indicators/1.7.2/')} class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t('ดูมติใน 1.7.2', 'See decision in 1.7.2')}
          </a>
        </p>
      </section>
    ))
  }

  {
    targets.filter((t) => t.metricFamilyNoteTh).map((row) => (
      <section class="rounded-xl border border-gray-200 bg-gray-50/80 p-5 shadow-sm sm:p-6" aria-labelledby="cat113-ghg-metric" data-cat11-ghg-metric-family>
        <h2 id="cat113-ghg-metric" class="text-base font-bold text-on-surface">{t('GHG — ครอบครัวตัวชี้วัด', 'GHG — metric families')}</h2>
        <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">{isEn ? row.metricFamilyNoteEn : row.metricFamilyNoteTh}</p>
        <p class="mt-2 text-sm">
          <a href={path('/indicators/1.5.1/')} class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t('1.5.1 บัญชี GHG (ตัวชี้วัดแยก)', '1.5.1 GHG inventory (separate metric)')}
          </a>
          {' · '}
          <a href={path('/dashboard/ghg/')} class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
            {t('แดชบอร์ด GHG', 'GHG dashboard')}
          </a>
        </p>
      </section>
    ))
  }

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat113-cross-title">
    <h2 id="cat113-cross-title" class="text-base font-bold text-on-surface">{t('เชื่อมโยง', 'Cross-links')}</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm" role="list">
      <li>
        <a href={path('/indicators/1.5.2/')} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded">
          {t('1.5.2 วิเคราะห์ผล GHG', '1.5.2 GHG performance analysis')}
        </a>
      </li>
      <li>
        <a href={path('/indicators/1.6.1/')} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded">
          {t('1.6.1 แผนลด GHG (อ้างเป้าหมาย 1.1.3)', '1.6.1 GHG plan (links 1.1.3 targets)')}
        </a>
      </li>
    </ul>
    <details class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50/80 p-3">
      <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('แหล่งอ้างอิง', 'Source evidence')}
      </summary>
      <p class="mt-2 text-xs">
        <a href={withBase(CAT11_DOCS.targetsPdf)} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded" target="_blank" rel="noopener noreferrer">
          1.1.3 (9-3-69).pdf
        </a>
      </p>
    </details>
  </section>
</div>
