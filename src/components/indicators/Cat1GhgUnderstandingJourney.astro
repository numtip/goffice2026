---
/**
 * 1.5.3 GHG Understanding Journey — FY2568 evidence unavailable (truthful).
 * Dashboard and workbook data do NOT prove staff understanding.
 */
import { CAT1_YEAR } from '../../utils/category1-ghg-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}
---

<div class="cat15-journey space-y-6" data-cat1-ghg-understanding data-view="1.5.3" data-cat1-missing-evidence="1.5.3">
  <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat153-hero-title">
    <p class="text-xs font-semibold text-amber-800">
      {t(`ตัวชี้วัด 1.5.3 · FY${CAT1_YEAR}`, `Indicator 1.5.3 · FY${CAT1_YEAR}`)}
    </p>
    <h2 id="cat153-hero-title" class="mt-1 text-lg font-bold text-balance text-amber-950 sm:text-xl">
      {t('ความรู้ความเข้าใจด้านก๊าซเรือนกระจก', 'GHG knowledge & understanding')}
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-amber-900">
      {t(
        'ยังไม่มีหลักฐานการประเมินความรู้/การอบรมด้าน GHG สำหรับปี 2568 ในชุดแหล่งข้อมูล',
        'No FY2568 knowledge/training assessment evidence exists in the source set',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat153-req-title">
    <h2 id="cat153-req-title" class="text-base font-bold text-on-surface">{t('ข้อกำหนดตัวชี้วัด', 'Indicator requirement')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface">
      {t(
        'บุคลากรและผู้ที่เกี่ยวข้อง (Outsource) ต้องมีความรู้ความเข้าใจเกี่ยวกับก๊าซเรือนกระจกในภาพรวมของสำนักงาน',
        'Personnel and outsourced staff must understand the office-wide greenhouse gas profile',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat153-notproof-title">
    <h2 id="cat153-notproof-title" class="text-base font-bold text-on-surface">{t('สิ่งที่ไม่ใช่หลักฐานของ 1.5.3', 'What does NOT satisfy 1.5.3')}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-on-surface-variant" role="list">
      <li>
        {t(
          'แดชบอร์ด GHG (/dashboard/ghg/) — เป็นข้อมูลปริมาณ ไม่ใช่การประเมินความเข้าใจของบุคลากร',
          'GHG dashboard (/dashboard/ghg/) — emission quantities, not staff understanding assessment',
        )}
      </li>
      <li>
        {t(
          'ไฟล์คำนวณ GHG (1.5.1) — เป็นบัญชีปริมาณ ไม่ใช่หลักฐานการอบรมหรือสัมภาษณ์',
          'GHG workbook (1.5.1) — inventory data, not training or interview evidence',
        )}
      </li>
      <li>
        {t(
          'การตรวจสอบชุดข้อมูล (dataset verified) — ไม่เท่ากับการยืนยันความรู้ของบุคลากร',
          'Dataset verification — not equivalent to confirming staff knowledge',
        )}
      </li>
    </ul>
  </section>

  <section class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-5 sm:p-6" aria-labelledby="cat153-future-title">
    <h2 id="cat153-future-title" class="text-base font-bold text-on-surface">{t('ช่องหลักฐานในอนาคต', 'Future evidence slot')}</h2>
    <p class="mt-2 text-sm text-on-surface-variant">
      {t(
        'เมื่อมีหลักฐาน FY2568 เช่น แบบทดสอบ ใบลงทะเบียนอบรม หรือบันทึกสัมภาษณ์ที่เชื่อมกับตัวชี้วัด 1.5.3 โดยตรง จะเชื่อมที่นี่',
        'When FY2568 evidence exists — e.g. quiz, training register, or interview record explicitly linked to 1.5.3 — it will be connected here',
      )}
    </p>
    <p class="mt-3 text-xs font-medium text-amber-800" data-cat1-status="MISSING">
      {t('สถานะ: MISSING / ไม่พร้อมใช้งาน', 'Status: MISSING / unavailable')}
    </p>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a
        href={path('/indicators/1.5.1/')}
        class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('← 1.5.1 บัญชี GHG', '← 1.5.1 GHG inventory')}
      </a>
      <a
        href={path('/indicators/1.5.2/')}
        class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
      >
        {t('← 1.5.2 วิเคราะห์ผล', '← 1.5.2 Performance analysis')}
      </a>
    </div>
  </section>
</div>
