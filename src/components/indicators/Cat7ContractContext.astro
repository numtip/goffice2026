---
/**
 * Cat7ContractContext.astro — per-indicator FY2568 baseline context for
 * Category 7 (continuity). Data comes only from the canonical static contracts
 * in src/data/category7/*.json. Honest limitation notes are grounded in
 * GO-CAT7-PHASE-A; no score, no PASS claim, no FY2569 facts.
 *   7.1 = limited FY2568 request evidence + limitation.
 *   7.2 = explicit "no verified FY2568 execution evidence in reconciled source set".
 */
import {
  buildCat7IndicatorContext,
  claimsForIndicator,
  classificationLabel,
  contractForDomain,
  domainLabel,
  domainForIndicator,
  indicatorTitle,
  statusLabel,
  CAT7_YEAR,
  type Cat7Claim,
} from '../../utils/category7-presentation';

interface Props {
  indicatorCode: string;
  locale: 'th' | 'en';
}

const { indicatorCode, locale } = Astro.props;
const isEn = locale === 'en';

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const domain = domainForIndicator(indicatorCode);
const view = domain ? buildCat7IndicatorContext(indicatorCode) : null;
const claims = claimsForIndicator(indicatorCode) as Cat7Claim[];
const record = view?.record;

const STATUS_STYLE: Record<string, string> = {
  'baseline-eligible': 'bg-green-100 text-green-800',
  QUARANTINE: 'bg-red-100 text-red-800',
  YEAR_UNVERIFIED: 'bg-amber-100 text-amber-800',
};

const KIND_STYLE: Record<string, string> = {
  status: 'border-green-100 bg-green-50/60',
  gap: 'border-amber-200 bg-amber-50/70',
  quarantine: 'border-red-100 bg-red-50/50',
  unavailable: 'border-gray-100 bg-gray-50/60',
};
---

{
  domain && view && (
    <section class="mb-6 rounded-xl border border-gray-200 bg-white p-6" data-cat7-contract-context>
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">
          {isEn ? `FY${CAT7_YEAR} baseline context` : `บริบทข้อมูลฐานปี ${CAT7_YEAR}`}
        </h2>
        <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">
          {t(domainLabel(domain))}
        </span>
        <span
          class:list={[
            'rounded-full px-2 py-0.5 text-xs font-medium',
            view.status === 'evidence-gap' ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800',
          ]}
        >
          {view.status === 'evidence-gap'
            ? (isEn ? 'Evidence gap' : 'ช่องว่างหลักฐาน')
            : (isEn ? 'FY2569 awaiting update' : 'ปี 2569 รอการอัปเดต')}
        </span>
      </div>

      <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {view.facts.map((fact) => (
          <div
            class:list={['rounded-lg border px-3 py-2', KIND_STYLE[fact.kind] || 'border-gray-100 bg-gray-50/60']}
            data-cat7-continuity-fact={fact.code}
          >
            <dt class="text-xs text-gray-500">{t(fact.label)}</dt>
            <dd class="mt-0.5 text-sm leading-snug font-medium text-gray-800">{t(fact.value)}</dd>
          </div>
        ))}
        {record && record.verification?.basis && (
          <div class="rounded-lg border border-gray-100 bg-gray-50/60 px-3 py-2 sm:col-span-2">
            <dt class="text-xs text-gray-500">{isEn ? 'Verification basis' : 'พื้นฐานการตรวจสอบ'}</dt>
            <dd class="mt-0.5 text-sm leading-snug text-gray-700">{record.verification.basis}</dd>
          </div>
        )}
      </dl>

      {view.limitation && (
        <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50/60 px-3 py-2 text-xs leading-relaxed text-amber-900">
          <strong class="font-semibold">{isEn ? 'Limitations: ' : 'ข้อจำกัด: '}</strong>
          {t(view.limitation)}
        </p>
      )}

      {claims.length > 0 && (
        <div class="mt-4 border-t border-gray-100 pt-3">
          <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
            {isEn ? `Claim disposition · ${indicatorTitle(indicatorCode, locale)}` : `การจำแนกข้อเท็จจริง · ${indicatorTitle(indicatorCode, locale)}`}
          </h3>
          <ul class="space-y-2" role="list">
            {claims.map((claim) => (
              <li class="rounded-lg border border-gray-100 bg-white px-3 py-2" data-cat7-claim={claim.id}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-mono text-gray-500">
                    {claim.page} · {claim.year ?? (isEn ? 'no year' : 'ไม่ระบุปี')}
                  </span>
                  <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium', STATUS_STYLE[claim.status]]}>
                    {t(statusLabel(claim.status))}
                  </span>
                  <span class="rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600">
                    {t(classificationLabel(claim.classification))}
                  </span>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-gray-700">{t(claim.summary)}</p>
                {claim.note && (
                  <p class="mt-1 text-xs leading-relaxed text-gray-500">{t({ th: claim.note, en: claim.note })}</p>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t border-gray-100 pt-3 text-xs text-gray-500">
        <span>
          {isEn
            ? `${view.sourceCount} claim record(s), ${view.pendingScanCount} scan page group(s) pending verification`
            : `ข้อเท็จจริง ${view.sourceCount} รายการ · กลุ่มหน้าสแกนรอการตรวจสอบ ${view.pendingScanCount} กลุ่ม`}
        </span>
        {contractForDomain(domain).records.length === 0 && (
          <span>
            {isEn
              ? 'No FY2568 execution evidence in reconciled source set (EVIDENCE_GAP)'
              : 'ไม่มีหลักฐานการดำเนินงานปี 2568 ในชุดแหล่งข้อมูลที่ผ่านการกระทบยอด (EVIDENCE_GAP)'}
          </span>
        )}
      </div>
    </section>
  )
}
