---
/**
 * 1.2.2 Role Understanding Journey — FY2568 evidence unavailable (truthful).
 */
import { buildRoleUnderstandingGap, CAT1_YEAR } from '../../utils/category1-committee-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const gap = buildRoleUnderstandingGap();
---

<div class="cat12-journey space-y-6" data-cat12-role-understanding data-view="1.2.2" data-cat1-missing-evidence="1.2.2">
  <section class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm sm:p-6" aria-labelledby="cat122-hero-title">
    <p class="text-xs font-semibold text-amber-800">
      {t(`ตัวชี้วัด 1.2.2 · FY${CAT1_YEAR}`, `Indicator 1.2.2 · FY${CAT1_YEAR}`)}
    </p>
    <h2 id="cat122-hero-title" class="mt-1 text-lg font-bold text-balance text-amber-950 sm:text-xl">
      {t('ความเข้าใจบทบาทและหน้าที่', 'Role understanding assessment')}
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-amber-900" data-cat1-status="MISSING">
      {t('สถานะ: MISSING / NOT LOCALLY VERIFIED', 'Status: MISSING / NOT LOCALLY VERIFIED')}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat122-req-title">
    <h2 id="cat122-req-title" class="text-base font-bold text-on-surface">{t('ข้อกำหนดตัวชี้วัด', 'Indicator requirement')}</h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface">
      {t(
        'ร้อยละของคณะกรรมการหรือทีมงานที่มีความเข้าใจในบทบาทและหน้าที่ — จากการสุ่มสอบถาม/สัมภาษณ์',
        'Percentage of committee/working-team members who understand their roles — from random interview/sampling',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat122-source-title">
    <h2 id="cat122-source-title" class="text-base font-bold text-on-surface">{t('สิ่งที่พบในแหล่ง FY2568', 'What FY2568 sources contain')}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-on-surface-variant" role="list">
      <li>{t('PDF 1.2.1 หน้า 8: placeholder', '1.2.1 PDF p.8: placeholder')} <code class="text-xs">{gap.sourceStub}</code></li>
      <li>{t('ไม่มีขนาดตัวอย่าง (sample)', 'No sample size')}</li>
      <li>{t('ไม่มีผลลัพธ์หรือร้อยละ', 'No result or percentage')}</li>
    </ul>
    <p class="mt-3 text-xs text-amber-800">{t(gap.noteTh, gap.noteEn)}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat122-notproof-title">
    <h2 id="cat122-notproof-title" class="text-base font-bold text-on-surface">{t('สิ่งที่ไม่ใช่หลักฐานของ 1.2.2', 'What does NOT satisfy 1.2.2')}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-on-surface-variant" role="list">
      <li>{t('คำสั่งแต่งตั้งคณะกรรมการ (1.2.1)', 'Committee appointment order (1.2.1)')}</li>
      <li>{t('การเข้าร่วมประชุมหรือการอบรมทั่วไป', 'Meeting attendance or general training')}</li>
      <li>{t('รายงานการประชุมที่ซ้ำกับทบทวนนโยบาย (FY2569)', 'Meeting minutes duplicate of policy review (FY2569)')}</li>
    </ul>
  </section>

  <section class="rounded-xl border border-dashed border-gray-300 bg-gray-50/80 p-5 sm:p-6" aria-labelledby="cat122-needed-title">
    <h2 id="cat122-needed-title" class="text-base font-bold text-on-surface">{t('หลักฐานที่ต้องการ', 'Evidence needed')}</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-on-surface-variant" role="list">
      <li>{t('รายการตัวอย่างสุ่ม (sample list)', 'Random sample list')}</li>
      <li>{t('บันทึก/แบบสัมภาษณ์', 'Interview record or form')}</li>
      <li>{t('ตัวเศษ/ตัวส่วนและร้อยละที่คำนวณได้', 'Numerator/denominator and calculated percentage')}</li>
    </ul>
    <p class="mt-3 text-xs text-on-surface-variant">
      {t('การนำเสนอที่ยอมรับได้ ≠ หลักฐานครบ', 'Accepted presentation ≠ evidence complete')}
    </p>
    <a href={path('/about/committee/')} class="mt-3 inline-block text-sm text-green-700 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
      {t('/about/committee/ — ช่องหลักฐาน', '/about/committee/ — evidence context')} →
    </a>
  </section>
</div>
