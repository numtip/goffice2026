---
/**
 * 1.1.2 Policy & Leadership Commitment — What we commit to.
 */
import {
  buildPolicyApproval,
  buildPolicyCommitments,
  buildPolicyInterviewGap,
  POLICY_PRINCIPLE_LABELS,
  CAT1_YEAR,
  CAT11_DOCS,
  type PolicyPrinciple,
} from '../../utils/category1-foundation-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const approval = buildPolicyApproval();
const commitments = buildPolicyCommitments();
const interviewGap = buildPolicyInterviewGap();

const principles: PolicyPrinciple[] = [
  'continual_improvement',
  'resource_energy_waste',
  'legal_compliance',
  'awareness_participation',
];

function commitmentsForPrinciple(p: PolicyPrinciple) {
  return commitments.filter((c) => c.principle === p);
}
---

<div class="cat11-journey space-y-6" data-cat11-policy data-view="1.1.2">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat112-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.1.2 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.1.2 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat112-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('นโยบายสิ่งแวดล้อม — What we commit to', 'Environmental policy — What we commit to')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        `${commitments.length} ข้อนโยบายที่ตรวจสอบจากแหล่ง — ไม่ใช่คะแนนสำนักงานสีเขียว`,
        `${commitments.length} source-verified policy commitments — not an official Green Office score`,
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat112-chrono-title" data-cat11-policy-chronology>
    <h2 id="cat112-chrono-title" class="text-base font-bold text-on-surface">
      {t('ลำดับการนำนโยบาย', 'Policy leadership chronology')}
    </h2>
    <ol class="mt-4 space-y-4" role="list">
      <li class="list-none rounded-lg border border-green-200 bg-green-50/50 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-green-800">{t('ทบทวน (Reviewed)', 'Reviewed')}</p>
        <p class="mt-1 text-sm font-medium text-on-surface">
          {approval.reviewCommittee} · {t('ครั้งที่', 'Meeting')} {approval.reviewMeetingNumber}
        </p>
        <p class="mt-1 text-sm num-tabular text-on-surface-variant">{isEn ? approval.reviewDateBE.split(' / ')[1] : approval.reviewDateBE.split(' / ')[0]}</p>
        {approval.policyRetainedFromFY2567 && (
          <p class="mt-1 text-xs text-on-surface-variant">{t('มติคงนโยบายตามรอบ 2567', 'Policy retained from FY2567 cycle')}</p>
        )}
      </li>
      <li class="list-none flex justify-center text-on-surface-variant" aria-hidden="true">↓</li>
      <li class="list-none rounded-lg border border-primary/30 bg-primary/5 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">{t('อนุมัติ/ประกาศ (Approved/Signed)', 'Approved/Signed')}</p>
        <p class="mt-1 text-sm font-medium text-on-surface">{t(approval.signedByRoleTh, approval.signedByRoleEn)}</p>
        <p class="mt-1 text-sm num-tabular text-on-surface-variant">{isEn ? approval.announcementDateBE.split(' / ')[1] : approval.announcementDateBE.split(' / ')[0]}</p>
      </li>
      <li class="list-none flex justify-center text-on-surface-variant" aria-hidden="true">↓</li>
      <li class="list-none rounded-lg border border-gray-200 bg-gray-50/80 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-on-surface-variant">{t('ดำเนินการ/ติดตาม (Implemented/Monitored)', 'Implemented/Monitored')}</p>
        <p class="mt-1 text-sm text-on-surface-variant">
          {t(
            'เอกสารการประชุมและภาพถ่ายคณะกรรมการ — ไม่ใช่หลักฐานสัมภาษณ์',
            'Committee minutes and photos — not interview evidence',
          )}
        </p>
      </li>
    </ol>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat112-commitments-title" data-cat11-policy-commitments>
    <h2 id="cat112-commitments-title" class="text-base font-bold text-on-surface">
      {t('10 ข้อนโยบาย', '10 policy commitments')}
    </h2>
    {
      principles.map((p) => {
        const items = commitmentsForPrinciple(p);
        if (items.length === 0) return null;
        const label = POLICY_PRINCIPLE_LABELS[p];
        return (
          <div class="mt-5 first:mt-4">
            <h3 class="text-sm font-semibold text-primary">{t(label.th, label.en)}</h3>
            <ol class="mt-2 space-y-2" role="list">
              {items.map((c) => (
                <li class="flex gap-2 text-sm leading-relaxed text-on-surface">
                  <span class="shrink-0 font-medium num-tabular">{c.statementNumber}.</span>
                  <span>{t(c.textTh, c.textEn)}</span>
                </li>
              ))}
            </ol>
          </div>
        );
      })
    }
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat112-participation-title" data-cat11-policy-participation>
    <h2 id="cat112-participation-title" class="text-base font-bold text-on-surface">1.1.2 (4)</h2>
    <dl class="mt-3 space-y-3">
      <div class="rounded-lg border border-green-200 bg-green-50/40 p-3">
        <dt class="text-xs font-semibold text-green-900">{t('การมีส่วนร่วมเอกสาร (Documentary participation)', 'Documentary participation')}</dt>
        <dd class="mt-1 text-sm text-green-950">{t('รองรับ — รายงาน/ภาพการประชุมคณะกรรมการ', 'Supported — committee meeting records/photos')}</dd>
      </div>
      <div class="rounded-lg border border-amber-200 bg-amber-50/50 p-3">
        <dt class="text-xs font-semibold text-amber-950">{t('สัมภาษณ์ผู้บริหาร (Management interview)', 'Management interview')}</dt>
        <dd class="mt-1 text-sm font-semibold text-amber-950">{t('NOT COMPLETED — ไม่มีหลักฐาน', 'NOT COMPLETED — evidence unavailable')}</dd>
        <dd class="mt-1 text-xs text-amber-800">{t(interviewGap.noteTh, interviewGap.noteEn)}</dd>
      </div>
    </dl>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat112-cross-title">
    <h2 id="cat112-cross-title" class="text-base font-bold text-on-surface">{t('เชื่อมโยง', 'Cross-links')}</h2>
    <p class="mt-2 text-sm">
      <a href={path('/indicators/1.7.2/')} class="font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('1.7.2 — ทบทวนนโยบาย (มติคงนโยบาย)', '1.7.2 — Policy review (retention decision)')}
      </a>
    </p>
    <details class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50/80 p-3">
      <summary class="cursor-pointer text-sm font-medium text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
        {t('แหล่งอ้างอิง', 'Source evidence')}
      </summary>
      <p class="mt-2 text-xs">
        <a href={withBase(CAT11_DOCS.policyPdf)} class="text-primary hover:underline focus-visible:ring-2 focus-visible:ring-green-700 rounded" target="_blank" rel="noopener noreferrer">
          1.1.2 (9-3-69).pdf
        </a>
      </p>
    </details>
  </section>
</div>
