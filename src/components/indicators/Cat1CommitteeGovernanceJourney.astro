---
/**
 * 1.2.1 Committee Governance Journey — appointment, coverage, structure (FY2568).
 */
import {
  buildCommitteeFoundation,
  buildAppointmentAuthority,
  buildOrganizationCoverage,
  buildCommitteeGroups,
  COMMITTEE_EVIDENCE,
  CAT1_YEAR,
} from '../../utils/category1-committee-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);
const doc = (p: string) => withBase(p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const foundation = buildCommitteeFoundation();
const authority = buildAppointmentAuthority();
const orgs = buildOrganizationCoverage();
const groups = buildCommitteeGroups();
const orgSum = orgs.reduce((s, o) => s + o.personnelCount, 0);
---

<div class="cat12-journey space-y-6" data-cat12-governance data-view="1.2.1">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat121-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.2.1 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.2.1 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat121-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('การแต่งตั้งคณะกรรมการหรือทีมงานด้านสิ่งแวดล้อม', 'Appointment of Environmental Committee or Working Team')}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-on-surface-variant">
      {t(
        'แสดงอำนาจแต่งตั้ง การครอบคลุมหน่วยงาน และโครงสร้างคณะกรรมการ — ไม่ใช่คะแนนสำนักงานสีเขียว',
        'Shows appointment authority, organization coverage, and committee structure — not an official Green Office score',
      )}
    </p>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6" aria-labelledby="cat121-auth-title" data-cat12-appointment>
    <h2 id="cat121-auth-title" class="text-base font-bold text-on-surface">{t('อำนาจแต่งตั้ง', 'Appointment authority')}</h2>
    <ul class="mt-3 space-y-2 text-sm text-on-surface" role="list">
      <li>{t('คำสั่งลายลักษณ์อักษร', 'Written appointment')}: {authority.writtenAppointment ? '✓' : '—'}</li>
      <li>{t('ลงนามโดย', 'Signed by')}: {t(authority.signedByRoleTh, authority.signedByRoleEn)}</li>
      <li>{t('วันที่', 'Date')}: {authority.dateBE}</li>
    </ul>
    <p class="mt-3 text-xs text-on-surface-variant">{t(authority.orderRefNoteTh, authority.orderRefNoteEn)}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat121-cov-title" data-cat12-coverage>
    <h2 id="cat121-cov-title" class="text-base font-bold text-on-surface">{t('การครอบคลุมหน่วยงาน', 'Organization coverage')}</h2>
    <p class="mt-2 text-sm text-on-surface-variant">
      {t(
        `${foundation.organizationCount} หน่วยงาน · รวม ${foundation.personnelCoverageTotal} คน (${foundation.personnelCoverageNoteTh})`,
        `${foundation.organizationCount} organizations · ${foundation.personnelCoverageTotal} personnel total (${foundation.personnelCoverageNoteEn})`,
      )}
    </p>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
      {orgs.map((o) => (
        <li class="list-none rounded-lg border border-gray-100 bg-gray-50/50 px-3 py-2 text-sm">
          <span class="font-medium">{t(o.nameTh, o.nameEn)}</span>
          <span class="ml-2 num-tabular text-primary">{o.personnelCount}</span>
        </li>
      ))}
    </ul>
    <p class="mt-3 text-[11px] text-on-surface-variant" aria-live="polite">
      {t(`ตรวจสอบผลรวม: ${orgSum}`, `Sum check: ${orgSum}`)}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat121-groups-title" data-cat12-groups>
    <h2 id="cat121-groups-title" class="text-base font-bold text-on-surface">{t('โครงสร้างคณะกรรมการ', 'Governance groups')}</h2>
    <ul class="mt-4 space-y-3" role="list">
      {groups.map((g) => (
        <li class="list-none rounded-lg border border-gray-100 p-4">
          <p class="font-medium text-on-surface">{t(g.labelTh, g.labelEn)}</p>
          {g.chairRoleTh && (
            <p class="mt-1 text-xs text-on-surface-variant">{t(g.chairRoleTh, g.chairRoleEn ?? g.chairRoleTh)}</p>
          )}
          <p class="mt-1 text-xs text-primary">{g.categoryCodes.join(' · ')}</p>
          {g.combinedGroup && (
            <p class="mt-1 text-xs font-medium text-green-800">{t('หมวด 1 + 7 รวมกลุ่ม', 'Categories 1 + 7 combined')}</p>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat121-evidence-title">
    <h2 id="cat121-evidence-title" class="text-base font-bold text-on-surface">{t('หลักฐานต้นทาง', 'Source evidence')}</h2>
    <ul class="mt-3 space-y-2 text-sm" role="list">
      <li>
        <a href={doc(COMMITTEE_EVIDENCE.fy2568Pdf)} class="text-green-700 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t('1.2.1 PDF (FY2568)', '1.2.1 PDF (FY2568)')}
        </a>
      </li>
      <li>
        <a href={doc(COMMITTEE_EVIDENCE.orderPdf)} class="text-green-700 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">
          {t('คำสั่งแต่งตั้ง (RAE order)', 'Appointment order (RAE order)')}
        </a>
      </li>
    </ul>
  </section>

  <section class="rounded-xl border border-primary/20 bg-primary/5 p-5 sm:p-6" aria-labelledby="cat121-cta-title">
    <h2 id="cat121-cta-title" class="text-base font-bold text-on-surface">{t('รายละเอียดบุคลากรและโครงสร้าง', 'People & structure detail')}</h2>
    <p class="mt-2 text-sm text-on-surface-variant">
      {t(
        'รายชื่อและโครงสร้างเต็มอยู่ที่ศูนย์ About — ไม่ทำซ้ำในหน้าตัวชี้วัด',
        'Full roster and structure live on the About center — not duplicated inline here',
      )}
    </p>
    <a
      href={path('/about/committee/')}
      class="mt-3 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
    >
      {t('ไปที่ /about/committee/', 'Go to /about/committee/')} →
    </a>
    <p class="mt-4 text-xs text-on-surface-variant">
      {t('เชื่อมโยง', 'Links')}:
      <a href={path('/indicators/1.1.4/')} class="ml-1 text-green-700 hover:underline">1.1.4</a>
      ·
      <a href={path('/indicators/1.7.2/')} class="ml-1 text-green-700 hover:underline">1.7.2</a>
    </p>
  </section>
</div>
