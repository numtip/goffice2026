---
/** 1.5.2 GHG Performance Journey — FY2568 target analysis with pending FY2567 basis. */
import { buildGhgPerformance, buildGhgInventory, formatTco2e, GHG_PREVIOUS_YEAR, CAT1_YEAR } from '../../utils/category1-ghg-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props { locale: 'th' | 'en'; }
const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);
const t = (th: string, en: string) => isEn ? en : th;
const perf = buildGhgPerformance();
const inventory = buildGhgInventory();
const perfPdf = withBase('/documents/fy2568/cat1/1.5Green house gass/1.5.2 (9-3-69).pdf');
---

<div class="cat15-journey space-y-6" data-cat1-ghg-performance data-view="1.5.2">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat152-hero-title">
    <p class="text-xs font-semibold text-primary">{t(`ตัวชี้วัด 1.5.2 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.5.2 · FY${CAT1_YEAR} Historical Baseline`)}</p>
    <h2 id="cat152-hero-title" class="mt-1 text-lg font-bold text-on-surface sm:text-xl">{t('วิเคราะห์ผลก๊าซเรือนกระจกเทียบเป้าหมาย', 'GHG performance vs target analysis')}</h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">{t('ยอดรายงาน FY2568 ยืนยันแล้ว แต่ฐานเปรียบเทียบ FY2567 ยังรอการตรวจสอบ จึงยังไม่เผยแพร่เปอร์เซ็นต์เปลี่ยนแปลงหรือผลผ่าน/ไม่ผ่านเป้าหมาย', 'The FY2568 reported total is verified, but the FY2567 comparison basis is still pending verification; no change percentage or target pass/fail verdict is published yet.')}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('เป้าหมายปี 2568', 'FY2568 target')}</h2>
    <p class="mt-2 text-sm text-on-surface">{t(`ลดการปล่อยก๊าซเรือนกระจก ${perf.targetReductionPct.toFixed(2)}% เทียบปี ${GHG_PREVIOUS_YEAR}`, `Reduce GHG emissions by ${perf.targetReductionPct.toFixed(2)}% vs FY${GHG_PREVIOUS_YEAR}`)}</p>
  </section>

  <section class="rounded-xl border border-amber-200 bg-amber-50/40 p-5 sm:p-6" aria-labelledby="cat152-result-title">
    <h2 id="cat152-result-title" class="text-base font-bold text-amber-950">{t('ผลการดำเนินงาน', 'Actual results')}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-left text-sm"><thead><tr class="border-b border-amber-200 text-xs text-amber-900"><th class="py-2 pr-4 font-semibold">{t('รายการ', 'Item')}</th><th class="py-2 pr-4 font-semibold">{t('ค่า', 'Value')}</th></tr></thead><tbody>
        <tr class="border-b border-amber-100"><td class="py-2 pr-4">{t(`ปี ${CAT1_YEAR} — ยอดรายงานทางการ`, `FY${CAT1_YEAR} — official reported total`)}</td><td class="py-2 pr-4 num-tabular font-medium">{formatTco2e(inventory.totalTCO2e)} tCO₂e</td></tr>
        <tr class="border-b border-amber-100"><td class="py-2 pr-4">{t(`ปี ${GHG_PREVIOUS_YEAR} — ฐานเปรียบเทียบ`, `FY${GHG_PREVIOUS_YEAR} — comparison baseline`)}</td><td class="py-2 pr-4 num-tabular font-medium">—</td></tr>
        <tr class="border-b border-amber-100"><td class="py-2 pr-4">{t('เปลี่ยนแปลงสัมบูรณ์', 'Absolute change')}</td><td class="py-2 pr-4 num-tabular font-medium">—</td></tr>
        <tr><td class="py-2 pr-4">{t('เปลี่ยนแปลง (%) / ผลเทียบเป้า', 'Percent change / target verdict')}</td><td class="py-2 pr-4 num-tabular font-medium">—</td></tr>
      </tbody></table>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-2"><span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-950 ring-1 ring-amber-300">{t('รอตรวจสอบฐาน FY2567', 'FY2567 basis pending')}</span></div>
    <p class="mt-3 text-xs leading-relaxed text-amber-900">{perf.note}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('การตีความ', 'Interpretation')}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-on-surface" role="list">
      <li>{t(`FY${CAT1_YEAR} ใช้ยอดรายงานทางการ ${formatTco2e(inventory.totalTCO2e)} tCO₂e จากแบบฟอร์มลงนาม`, `FY${CAT1_YEAR} uses the official reported ${formatTco2e(inventory.totalTCO2e)} tCO₂e from the signed form.`)}</li>
      <li>{t('เป้าหมายลด 1.00% มีหลักฐาน แต่ยังไม่มีฐาน FY2567 ที่ตรวจสอบภายใต้สัญญาแหล่งข้อมูลปัจจุบัน จึงไม่ตัดสินว่าบรรลุหรือไม่บรรลุ', 'The 1.00% reduction target is documented, but a verified FY2567 basis under the current source contract is not yet available, so no met/not-met verdict is made.')}</li>
      <li>{t('ค่า +4.82% เดิมถูกยกเลิกจากการนำเสนอจนกว่าจะ reconcile แหล่ง FY2567', 'The previous +4.82% figure is withdrawn from presentation until the FY2567 source is reconciled.')}</li>
    </ul>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('แหล่งอ้างอิง', 'Source')}</h2>
    <a href={perfPdf} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">{t('1.5.2 แบบฟอร์มสรุปและวิเคราะห์ผล (PDF)', '1.5.2 official summary & analysis form (PDF)')}</a>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={path('/indicators/1.5.1/')} class="inline-flex min-h-11 items-center rounded-stitch border border-green-700/30 bg-white px-4 py-2.5 text-sm font-semibold text-green-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2">{t('← 1.5.1 บัญชี GHG', '← 1.5.1 GHG inventory')}</a>
      <a href={path('/indicators/1.6.1/')} class="inline-flex min-h-11 items-center rounded-stitch bg-primary px-4 py-2.5 text-sm font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2">{t('ไปที่ 1.6.1 แผน/โครงการลด GHG', 'Continue to 1.6.1 reduction projects')}</a>
    </div>
  </section>
</div>
