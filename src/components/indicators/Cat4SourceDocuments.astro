---
/**
 * Cat4SourceDocuments.astro — "เอกสารต้นฉบับสำหรับการตรวจสอบ" (Original document for review)
 * Shared source-document section for Category 4 indicator groups (4.1, 4.2).
 * Data comes only from the deterministic FY2568 publication manifest, filtered to
 * the C1-approved file set defined by the Category 4 contracts (targets, measures,
 * sorting, data, wastewater, treatment-care) plus the canonical 10-03-69 annual
 * report DOCX, the promoted year tables, and the form XLSX per group.
 * The superseded 02-03-69 DOCX and the reader-friendly 10-03-69 PDF export are
 * honestly excluded from the per-issue lists (both disclosed in Cat4ContractContext
 * and the manifest source limitations).
 */
import fy2568Publication from '../../data/fy2568-publication.json';
import targetsContract from '../../data/category4/targets.json';
import measuresContract from '../../data/category4/measures.json';
import sortingContract from '../../data/category4/sorting.json';
import dataContract from '../../data/category4/data.json';
import wastewaterContract from '../../data/category4/wastewater.json';
import treatmentCareContract from '../../data/category4/treatment-care.json';
import { withBase } from '../../utils/with-base';

interface Props {
  issueCode: string; // '4.1' | '4.2'
  locale: 'th' | 'en';
}

const { issueCode, locale } = Astro.props;
const isEn = locale === 'en';

function t(th: string, en: string): string {
  return isEn ? en : th;
}

interface PublicationDoc {
  path: string;
  title: string;
  type: string;
  sizeBytes: number;
  sha256: string;
  url: string;
}

const publication = fy2568Publication as unknown as {
  categories: Record<string, { count: number; bytes: number; documents: PublicationDoc[] }>;
};

// C1-approved source paths derived from the C4 contracts (records).
const APPROVED_PATHS = new Set<string>();
for (const contract of [targetsContract, measuresContract, sortingContract, dataContract, wastewaterContract, treatmentCareContract]) {
  for (const rec of (contract as { records: { sourceRef?: string; relatedSources?: string[] }[] }).records ?? []) {
    if (rec.sourceRef) APPROVED_PATHS.add(rec.sourceRef);
    for (const rs of rec.relatedSources ?? []) APPROVED_PATHS.add(rs);
  }
}

// Canonical annual report (category report for both groups).
const ANNUAL_REPORT = 'หมวดที่ 4 รายงานผลการจัดการของเสีย  (10-03-69).docx';
// Form XLSX + promoted year tables (belong to the 4.1 waste-data group).
const ROOT_4_1_DOCS = [
  '4. หมวด 4 ข้อ 4.1(1) บันทึกปริมาณขยะ.xls  ปี 2568.xls 14-02-68.xlsx',
  'ปี 2566.pdf',
  'ปี 2567.pdf',
  'ปี 2568.pdf',
];

const GROUP_PREFIX: Record<string, string> = {
  '4.1': '4.1 การจัดการขยะ/',
  '4.2': '4.2 การจัดการน้ำเสีย/',
};

const prefix = GROUP_PREFIX[issueCode];
const prefixDocs = prefix
  ? (publication.categories.cat4?.documents ?? [])
      .filter((d) => d.path.startsWith(prefix) && APPROVED_PATHS.has(d.path))
      .sort((a, b) => a.path.localeCompare(b.path))
  : [];

const rootDocs = issueCode === '4.1'
  ? (publication.categories.cat4?.documents ?? []).filter((d) => ROOT_4_1_DOCS.includes(d.path))
  : [];

const docs = [
  ...prefixDocs,
  ...rootDocs,
  ...(publication.categories.cat4?.documents ?? []).filter((d) => d.path === ANNUAL_REPORT),
];

const typeLabel: Record<string, string> = {
  pdf: 'PDF',
  xlsx: 'Excel / XLSX',
  docx: 'Word / DOCX',
  txt: 'TXT',
};

// Editorial per-document description (th/en). Keyed by manifest path; grounded in
// the C4 contracts and the C1 disposition — never invented.
const DOC_DESCRIPTIONS: Record<string, { th: string; en: string }> = {
  '4. หมวด 4 ข้อ 4.1(1) บันทึกปริมาณขยะ.xls  ปี 2568.xls 14-02-68.xlsx': {
