---
/**
 * 1.3.1 Environmental Assessment Journey — FY2568 historical baseline.
 * Canonical metrics only from environmental-aspects-2568.json.
 * Motion: pulse count-up is progressive enhancement only.
 * Significance visual is static-first CSS/HTML (never gated on reveal).
 */
import {
  buildAspectExplorer,
  buildProjectLinkageView,
  buildSignificantIssueView,
  environmentalAspectsDataset,
  CAT1_YEAR,
} from '../../utils/category1-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(th: string, en: string): string {
  return isEn ? en : th;
}

const dataset = environmentalAspectsDataset();
const summary = dataset.summary;
const explorer = buildAspectExplorer();
const highIssues = buildSignificantIssueView().filter((si) => si.significance === 'H');
const projectLinks = buildProjectLinkageView();

const ioLabel: Record<string, { th: string; en: string }> = {
  input: { th: 'ทรัพยากร (Input)', en: 'Input (resource)' },
  output: { th: 'มลพิษ (Output)', en: 'Output (pollution)' },
};
const condLabel: Record<string, { th: string; en: string }> = {
  normal: { th: 'ปกติ', en: 'Normal' },
  abnormal: { th: 'ผิดปกติ', en: 'Abnormal' },
  emergency: { th: 'ฉุกเฉิน', en: 'Emergency' },
};
const dirLabel: Record<string, { th: string; en: string }> = {
  direct: { th: 'ทางตรง', en: 'Direct' },
  indirect: { th: 'ทางอ้อม', en: 'Indirect' },
};
const sigLabel: Record<string, { th: string; en: string }> = {
  L: { th: 'ต่ำ', en: 'Low' },
  M: { th: 'ปานกลาง', en: 'Moderate' },
  H: { th: 'สูง', en: 'High' },
};
const sigBadge: Record<string, string> = {
  L: 'bg-gray-100 text-gray-700',
  M: 'bg-amber-100 text-amber-800',
  H: 'bg-red-100 text-red-800',
};

const chainTh = 'กิจกรรม → Input / Output → ประเด็น → ทางตรง/อ้อม → ปกติ/ผิดปกติ/ฉุกเฉิน → การประเมิน → L/M/H';
const chainEn = 'Activity → Input/Output → Aspect → Direct/Indirect → N/A/E → Assessment → L/M/H';

const mapSteps = [
  { th: 'กิจกรรม', en: 'Activity' },
  { th: 'Input / Output', en: 'Input/Output' },
  { th: 'ประเด็น', en: 'Aspect' },
  { th: 'ทางตรง/อ้อม', en: 'Direct/Indirect' },
  { th: 'ปกติ/ผิดปกติ/ฉุกเฉิน', en: 'N/A/E' },
  { th: 'การประเมิน', en: 'Assessment' },
  { th: 'L/M/H', en: 'L/M/H' },
];

const pulseSteps = [
  { key: 'activities', value: summary.activityCount, th: 'กิจกรรม', en: 'Activities', note: t('ป้ายกิจกรรมในทะเบียน', 'Register activity labels') },
  { key: 'aspects', value: summary.aspectCount, th: 'ประเด็น', en: 'Aspects', note: t('ประเมินครบทุกประเด็น', 'All assessed aspects') },
  { key: 'significant', value: summary.significantCount, th: 'นัยสำคัญ (M/H)', en: 'Significant (M/H)', note: t('ต้องติดตาม', 'Requires follow-up') },
  { key: 'high', value: summary.bySignificance.H, th: 'ระดับสูง (H)', en: 'High (H)', note: t('ความสำคัญสูงสุด', 'Highest significance') },
];

const lShare = (summary.bySignificance.L / summary.aspectCount) * 100;
const mShare = (summary.bySignificance.M / summary.aspectCount) * 100;
const hShare = (summary.bySignificance.H / summary.aspectCount) * 100;

const sourceNote = t(
  `แหล่งข้อมูล: docs/ผลประเมินปัญหา2568.xlsx (ทะเบียน 1.3(2)/1.3(3) + ลำดับความสำคัญ 1.3(4) ฉบับ 29 สค68) — ปี ${CAT1_YEAR}`,
  `Source: docs/ผลประเมินปัญหา2568.xlsx (registers 1.3(2)/1.3(3) + priority 1.3(4) as of 29 สค68) — FY${CAT1_YEAR}`,
);
---

<div
  class="cat13-journey space-y-6"
  data-cat1-env-assessment
  data-view="1.3.1"
>
  <section class="landing-reveal rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-hero-title">
    <p class="text-xs font-semibold text-primary">
      {t(`ตัวชี้วัด 1.3.1 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.3.1 · FY${CAT1_YEAR} Historical Baseline`)}
    </p>
    <h2 id="cat13-hero-title" class="mt-1 text-lg font-bold text-balance text-on-surface sm:text-xl">
      {t('เส้นทางการประเมินประเด็นสิ่งแวดล้อม', 'Environmental Assessment Journey')}
    </h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(
        `ข้อมูลปี ${CAT1_YEAR} เป็นฐานประวัติสำหรับเปรียบเทียบปีถัดไป ไม่ใช่ผลการประเมินปีปัจจุบัน`,
        `FY${CAT1_YEAR} is the historical baseline for later comparison, not a current-year result`,
      )}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-pulse-title">
    <h2 id="cat13-pulse-title" class="text-base font-bold text-on-surface">
      {t('ชีพจัดการประเมิน', 'Assessment pulse')}
    </h2>
    <p class="mt-1 text-sm text-on-surface-variant">
      {t('จากกิจกรรมในขอบเขตสู่ประเด็นที่ต้องติดตาม', 'From in-scope activities to issues requiring follow-up')}
    </p>
    <ol class="landing-stagger mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4" data-cat1-assessment-pulse>
      {
        pulseSteps.map((step, index) => (
          <li class="landing-reveal landing-card-interactive list-none rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4 motion-reduce:transform-none">
            <p class="text-xs text-on-surface-variant">
              {index + 1}. {t(step.th, step.en)}
            </p>
            <p class="mt-1 font-bold num-tabular text-3xl text-primary" data-cat1-summary={step.key}>
              <span data-count-up={step.value}>{step.value}</span>
            </p>
            <p class="mt-1 text-[11px] leading-snug text-on-surface-variant">{step.note}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-4 flex flex-wrap gap-1.5 text-[11px]" data-cat1-canonical-summary>
      <span class="rounded-full bg-green-100 px-2.5 py-1 font-medium text-green-800">
        {`${summary.byInputOutput.input} ${t('Input', 'Input')}`}
      </span>
      <span class="rounded-full bg-emerald-100 px-2.5 py-1 font-medium text-emerald-800">
        {`${summary.byInputOutput.output} ${t('Output', 'Output')}`}
      </span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-700" data-cat1-summary="lmh">
        {`${summary.bySignificance.L} L · ${summary.bySignificance.M} M · ${summary.bySignificance.H} H`}
      </span>
      <span class="rounded-full bg-amber-100 px-2.5 py-1 font-medium text-amber-800" data-cat1-summary="significant">
        {`${summary.significantCount} ${t('นัยสำคัญ (M/H)', 'significant (M/H)')}`}
      </span>
    </div>
  </section>

  <section class="landing-reveal rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-map-title">
    <h2 id="cat13-map-title" class="text-base font-bold text-on-surface">
      {t('แผนที่การประเมิน', 'Environmental control map')}
    </h2>
    <p class="mt-1 text-xs text-on-surface-variant">{t(chainTh, chainEn)}</p>
    <ol class="landing-stagger mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-7">
      {
        mapSteps.map((step, index) => (
          <li class="landing-reveal flex items-center gap-2 rounded-stitch border border-outline-variant/20 bg-surface-container-lowest px-3 py-2">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-[11px] font-bold text-white" aria-hidden="true">
              {index + 1}
            </span>
            <span class="min-w-0 text-xs font-medium leading-snug text-on-surface">{t(step.th, step.en)}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-3 text-[11px] text-on-surface-variant">
      {`${summary.byDirectIndirect.direct} ${t('ทางตรง', 'direct')} · ${summary.byDirectIndirect.indirect} ${t('ทางอ้อม', 'indirect')} · ${summary.byCondition.normal} ${t('ปกติ', 'normal')} · ${summary.byCondition.abnormal} ${t('ผิดปกติ', 'abnormal')} · ${summary.byCondition.emergency} ${t('ฉุกเฉิน', 'emergency')}`}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-sig-title">
    <h2 id="cat13-sig-title" class="text-base font-bold text-on-surface">
      {t('การกระจายระดับความสำคัญ', 'Significance distribution')}
    </h2>
    <p class="mt-1 text-sm text-on-surface-variant">
      {t(`สัดส่วนจาก ${summary.aspectCount} ประเด็น — ไม่ใช่คะแนนทางการ`, `Share of ${summary.aspectCount} aspects — not an official score`)}
    </p>
    <ul class="mt-4 space-y-3" data-cat13-sig-visual role="list">
      {
        [
          { key: 'L', count: summary.bySignificance.L, share: lShare, th: 'ต่ำ', en: 'Low', fill: 'bg-gray-500' },
          { key: 'M', count: summary.bySignificance.M, share: mShare, th: 'ปานกลาง', en: 'Moderate', fill: 'bg-amber-500' },
          { key: 'H', count: summary.bySignificance.H, share: hShare, th: 'สูง', en: 'High', fill: 'bg-red-600' },
        ].map((band) => (
          <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-3 sm:grid-cols-[5.5rem_1fr_7rem]">
            <p class="min-w-0 text-sm leading-tight">
              <span class="font-bold text-on-surface">{band.key}</span>
              <span class="mt-0.5 block text-[11px] text-on-surface-variant">{t(band.th, band.en)}</span>
            </p>
            <div class="h-8 overflow-hidden rounded-stitch bg-gray-100 sm:h-10" aria-hidden="true">
              <div
                class:list={['cat13-sig-fill', 'h-full', 'min-w-[1.5rem]', band.fill]}
                style={`width: max(1.5rem, ${band.share}%)`}
              ></div>
            </div>
            <p class="text-right leading-tight">
              <span class="block font-bold num-tabular text-on-surface">{band.count}</span>
              <span class="block text-[11px] num-tabular text-on-surface-variant">{band.share.toFixed(1)}%</span>
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-xs text-on-surface-variant">
      {t(
        `L ${summary.bySignificance.L} (${lShare.toFixed(1)}%) · M ${summary.bySignificance.M} (${mShare.toFixed(1)}%) · H ${summary.bySignificance.H} (${hShare.toFixed(1)}%) · รวม ${summary.aspectCount} ประเด็น`,
        `L ${summary.bySignificance.L} (${lShare.toFixed(1)}%) · M ${summary.bySignificance.M} (${mShare.toFixed(1)}%) · H ${summary.bySignificance.H} (${hShare.toFixed(1)}%) · n = ${summary.aspectCount} aspects`,
      )}
    </p>

    <h3 class="mt-5 text-sm font-semibold text-on-surface">
      {t(`${summary.bySignificance.H} ประเด็นระดับสูง`, `${summary.bySignificance.H} high-significance issues`)}
    </h3>
    <ul class="mt-2 space-y-2" role="list" data-cat13-high-issues>
      {
        highIssues.map((si) => (
          <li class="rounded-lg border border-red-100 bg-red-50/40 p-3">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-on-surface">{si.aspect}</p>
                <p class="mt-0.5 text-xs text-on-surface-variant">{si.activity}{si.priorityRank != null && ` · ${t('ลำดับ', 'rank')} ${si.priorityRank}`}</p>
              </div>
              <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${sigBadge.H}`}>
                H · {t('สูง', 'High')}
              </span>
            </div>
            {
              si.control && (
                <p class="mt-2 text-xs leading-relaxed text-on-surface-variant">{si.control}</p>
              )
            }
            {
              si.project ? (
                <p class="mt-2 text-xs font-medium text-green-800">
                  {t('โครงการที่เชื่อมโยง', 'Linked project')}: {si.project.projectTitle}
                </p>
              ) : (
                <p class="mt-2 text-xs text-on-surface-variant">
                  {t(
                    'มีการควบคุมในแหล่งข้อมูล — ยังไม่มีการเชื่อมโยงโครงการใน projects.json',
                    'Control text in source — no project link in projects.json',
                  )}
                </p>
              )
            }
          </li>
        ))
      }
    </ul>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-explorer-title">
    <h2 id="cat13-explorer-title" class="text-base font-bold text-on-surface">
      {t('สำรวจทะเบียนประเด็น', 'Aspect register explorer')}
    </h2>
    <p class="mt-1 text-sm text-on-surface-variant">
      {t(
        `${summary.aspectCount} ประเด็นจาก ${summary.activityCount} กิจกรรม — ขยายรายการเพื่อดูคะแนน แหล่งที่มา และการควบคุม`,
        `${summary.aspectCount} aspects across ${summary.activityCount} activities — expand a row for score, source, and control`,
      )}
    </p>

    <div class="mt-4 space-y-3" data-cat13-filters>
      <fieldset class="min-w-0">
        <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">{t('Input / Output', 'Input / Output')}</legend>
        <div class="flex flex-wrap gap-1.5">
          <label class="cat13-chip"><input type="radio" name="cat13-io" id="cat13-io-all" value="all" checked class="sr-only" /><span>{t('ทั้งหมด', 'All')}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-io" id="cat13-io-input" value="input" class="sr-only" /><span>{`Input ${summary.byInputOutput.input}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-io" id="cat13-io-output" value="output" class="sr-only" /><span>{`Output ${summary.byInputOutput.output}`}</span></label>
        </div>
      </fieldset>
      <fieldset class="min-w-0">
        <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">{t('ทางตรง / อ้อม', 'Direct / Indirect')}</legend>
        <div class="flex flex-wrap gap-1.5">
          <label class="cat13-chip"><input type="radio" name="cat13-dir" id="cat13-dir-all" value="all" checked class="sr-only" /><span>{t('ทั้งหมด', 'All')}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-dir" id="cat13-dir-direct" value="direct" class="sr-only" /><span>{`${t('ทางตรง', 'Direct')} ${summary.byDirectIndirect.direct}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-dir" id="cat13-dir-indirect" value="indirect" class="sr-only" /><span>{`${t('ทางอ้อม', 'Indirect')} ${summary.byDirectIndirect.indirect}`}</span></label>
        </div>
      </fieldset>
      <fieldset class="min-w-0">
        <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">{t('สภาวะ (N/A/E)', 'Condition (N/A/E)')}</legend>
        <div class="flex flex-wrap gap-1.5">
          <label class="cat13-chip"><input type="radio" name="cat13-cond" id="cat13-cond-all" value="all" checked class="sr-only" /><span>{t('ทั้งหมด', 'All')}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-cond" id="cat13-cond-normal" value="normal" class="sr-only" /><span>{`${t('ปกติ', 'Normal')} ${summary.byCondition.normal}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-cond" id="cat13-cond-abnormal" value="abnormal" class="sr-only" /><span>{`${t('ผิดปกติ', 'Abnormal')} ${summary.byCondition.abnormal}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-cond" id="cat13-cond-emergency" value="emergency" class="sr-only" /><span>{`${t('ฉุกเฉิน', 'Emergency')} ${summary.byCondition.emergency}`}</span></label>
        </div>
      </fieldset>
      <fieldset class="min-w-0">
        <legend class="mb-1.5 text-[11px] font-semibold text-on-surface-variant">{t('ระดับนัยสำคัญ', 'Significance')}</legend>
        <div class="flex flex-wrap gap-1.5">
          <label class="cat13-chip"><input type="radio" name="cat13-sig" id="cat13-sig-all" value="all" checked class="sr-only" /><span>{t('ทั้งหมด', 'All')}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-sig" id="cat13-sig-L" value="L" class="sr-only" /><span>{`L ${summary.bySignificance.L}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-sig" id="cat13-sig-M" value="M" class="sr-only" /><span>{`M ${summary.bySignificance.M}`}</span></label>
          <label class="cat13-chip"><input type="radio" name="cat13-sig" id="cat13-sig-H" value="H" class="sr-only" /><span>{`H ${summary.bySignificance.H}`}</span></label>
        </div>
      </fieldset>
    </div>
    <p class="mt-2 text-[11px] text-on-surface-variant" data-cat13-filter-status aria-live="polite">
      {t(`แสดง ${summary.aspectCount} จาก ${summary.aspectCount} ประเด็น`, `Showing ${summary.aspectCount} of ${summary.aspectCount} aspects`)}
    </p>
    <p class="cat13-empty mt-2 hidden text-sm text-on-surface-variant" data-cat13-empty>
      {t('ไม่มีประเด็นที่ตรงกับตัวกรองนี้', 'No aspects match this filter')}
    </p>

    <div class="mt-4 space-y-4">
      {
        explorer.map((group) => (
          <section class="cat13-activity min-w-0" data-activity-id={group.activityId}>
            <h3 class="rounded-stitch bg-green-50 px-3 py-2 text-sm font-semibold text-green-900">
              {group.activity}
              <span class="ml-2 text-[11px] font-medium text-green-700/80">{group.aspects.length} {t('ประเด็น', 'aspects')}</span>
            </h3>
            <ul class="mt-2 space-y-2" role="list">
              {
                group.aspects.map((a) => (
                  <li>
                    <details
                      class="rounded-lg border border-gray-100 bg-white open:border-outline-variant/40"
                      data-aspect-card
                      data-io={a.inputOutput}
                      data-dir={a.directIndirect}
                      data-cond={a.condition}
                      data-sig={a.assessment.significance}
                    >
                      <summary class="flex cursor-pointer list-none flex-wrap items-start justify-between gap-2 px-3 py-2.5 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-lg">
                        <span class="min-w-0">
                          <span class="block font-medium text-on-surface">{a.aspect}</span>
                          <span class="mt-0.5 block text-[11px] text-on-surface-variant">
                            {`${t(ioLabel[a.inputOutput].th, ioLabel[a.inputOutput].en)} · ${t(dirLabel[a.directIndirect].th, dirLabel[a.directIndirect].en)} · ${t(condLabel[a.condition].th, condLabel[a.condition].en)}`}
                          </span>
                        </span>
                        <span class={`inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${sigBadge[a.assessment.significance]}`}>
                          {a.assessment.significance} · {t(sigLabel[a.assessment.significance].th, sigLabel[a.assessment.significance].en)}
                        </span>
                      </summary>
                      <dl class="border-t border-gray-100 px-3 py-3 text-xs text-on-surface-variant">
                        <div class="flex justify-between gap-3 py-1">
                          <dt>{t('คะแนนความเสี่ยง', 'Risk score')}</dt>
                          <dd class="font-medium num-tabular text-on-surface">{a.assessment.riskScore ?? '—'}</dd>
                        </div>
                        <div class="flex justify-between gap-3 py-1">
                          <dt>{t('แหล่งระดับความสำคัญ', 'Significance source')}</dt>
                          <dd class="font-medium text-on-surface">{a.assessment.significanceSource}</dd>
                        </div>
                        <div class="flex justify-between gap-3 py-1">
                          <dt>{t('แหล่งทะเบียน', 'Register source')}</dt>
                          <dd class="text-right font-medium text-on-surface">{`${a.sourceTrace.sheet} · ${t('แถว', 'row')} ${a.sourceTrace.sourceRow}`}</dd>
                        </div>
                        <div class="py-1">
                          <dt class="text-on-surface-variant">{t('การควบคุม/ป้องกัน', 'Control / prevention')}</dt>
                          <dd class="mt-0.5 text-on-surface">{a.controlMeasure ? a.controlMeasure.text : '—'}</dd>
                        </div>
                      </dl>
                    </details>
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </div>
    <p class="mt-3 text-[11px] text-on-surface-variant">{sourceNote}</p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat13-action-title">
