<style>
  .cat13-chip {
    display: inline-flex;
    cursor: pointer;
    border-radius: 9999px;
    border: 1px solid rgb(191 201 195 / 0.6);
    background: #f3f4f6;
    padding: 0.25rem 0.7rem;
    font-size: 11px;
    font-weight: 600;
    color: #374151;
  }
  .cat13-chip:has(:focus-visible) {
    outline: 2px solid #003527;
    outline-offset: 2px;
  }
  .cat13-chip:has(:checked) {
    background: #003527;
    border-color: #003527;
    color: #fff;
  }
  .cat13-journey details > summary::-webkit-details-marker {
    display: none;
  }

  .cat13-journey:has(#cat13-io-input:checked) [data-aspect-card]:not([data-io='input']),
  .cat13-journey:has(#cat13-io-output:checked) [data-aspect-card]:not([data-io='output']),
  .cat13-journey:has(#cat13-dir-direct:checked) [data-aspect-card]:not([data-dir='direct']),
  .cat13-journey:has(#cat13-dir-indirect:checked) [data-aspect-card]:not([data-dir='indirect']),
  .cat13-journey:has(#cat13-cond-normal:checked) [data-aspect-card]:not([data-cond='normal']),
  .cat13-journey:has(#cat13-cond-abnormal:checked) [data-aspect-card]:not([data-cond='abnormal']),
  .cat13-journey:has(#cat13-cond-emergency:checked) [data-aspect-card]:not([data-cond='emergency']),
  .cat13-journey:has(#cat13-sig-L:checked) [data-aspect-card]:not([data-sig='L']),
  .cat13-journey:has(#cat13-sig-M:checked) [data-aspect-card]:not([data-sig='M']),
  .cat13-journey:has(#cat13-sig-H:checked) [data-aspect-card]:not([data-sig='H']) {
    display: none;
  }

  .cat13-journey:has(#cat13-io-input:checked) .cat13-activity:not(:has([data-io='input'])),
  .cat13-journey:has(#cat13-io-output:checked) .cat13-activity:not(:has([data-io='output'])),
  .cat13-journey:has(#cat13-dir-direct:checked) .cat13-activity:not(:has([data-dir='direct'])),
  .cat13-journey:has(#cat13-dir-indirect:checked) .cat13-activity:not(:has([data-dir='indirect'])),
  .cat13-journey:has(#cat13-cond-normal:checked) .cat13-activity:not(:has([data-cond='normal'])),
  .cat13-journey:has(#cat13-cond-abnormal:checked) .cat13-activity:not(:has([data-cond='abnormal'])),
  .cat13-journey:has(#cat13-cond-emergency:checked) .cat13-activity:not(:has([data-cond='emergency'])),
  .cat13-journey:has(#cat13-sig-L:checked) .cat13-activity:not(:has([data-sig='L'])),
  .cat13-journey:has(#cat13-sig-M:checked) .cat13-activity:not(:has([data-sig='M'])),
  .cat13-journey:has(#cat13-sig-H:checked) .cat13-activity:not(:has([data-sig='H'])) {
    display: none;
  }

  /* Bounded 1.3.1: never hide journey content if GO-MOTION init or
     IntersectionObserver fails (oversized sections cannot hit 12%). */
  :global(html.motion-ready .cat13-journey .landing-reveal),
  :global(html.motion-ready .cat13-journey .landing-reveal:not(.is-visible)) {
    opacity: 1 !important;
    transform: none !important;
  }
  .cat13-sig-fill {
    transform: none;
  }
</style>

<script>
  import '../../scripts/landing-motion.ts';

  const root = document.querySelector('.cat13-journey');
  if (root instanceof HTMLElement) {
    const host = root;
    const total = host.querySelectorAll('[data-aspect-card]').length;
    const status = host.querySelector('[data-cat13-filter-status]');
    const empty = host.querySelector('[data-cat13-empty]');
    const filters = host.querySelector('[data-cat13-filters]');
    const isEn = document.documentElement.lang === 'en';

    function syncFilterStatus() {
      const visible = [...host.querySelectorAll('[data-aspect-card]')].filter(
        (el) => getComputedStyle(el).display !== 'none',
      ).length;
      if (status) {
        status.textContent = isEn
          ? `Showing ${visible} of ${total} aspects`
          : `แสดง ${visible} จาก ${total} ประเด็น`;
      }
      empty?.classList.toggle('hidden', visible !== 0);
    }

    filters?.addEventListener('change', () => requestAnimationFrame(syncFilterStatus));
  }
</script>
