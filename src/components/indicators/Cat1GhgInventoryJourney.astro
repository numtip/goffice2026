---
/** 1.5.1 GHG Inventory Journey — FY2568 historical baseline. */
import {
  buildGhgInventory,
  buildGhgMonthlySeries,
  buildGhgAnomalies,
  buildGhgDashboardReconcile,
  buildGhgProvenance,
  ghgContractSources,
  formatTco2e,
  CAT1_YEAR,
} from '../../utils/category1-ghg-presentation';
import { getLocalizedPath } from '../../i18n/utils';
import { withBase } from '../../utils/with-base';

interface Props { locale: 'th' | 'en'; }
const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);
const t = (th: string, en: string) => isEn ? en : th;

const inventory = buildGhgInventory();
const months = buildGhgMonthlySeries();
const anomalies = buildGhgAnomalies();
const reconcile = buildGhgDashboardReconcile();
const provenance = buildGhgProvenance();
const sources = ghgContractSources();
const maxMonth = Math.max(...months.map((m) => m.tCO2e));
const workbookXlsx = withBase('/documents/resources/ghg/1.6GreenHouseGas2025.xlsx');
const invPdf = withBase('/documents/fy2568/cat1/1.5Green house gass/1.5.1 (9-3-69).pdf');
const officialPdf = withBase('/documents/fy2568/cat1/1.5Green house gass/1.5.2 (9-3-69).pdf');
---

<div class="cat15-journey space-y-6" data-cat1-ghg-inventory data-view="1.5.1">
  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat15-hero-title">
    <p class="text-xs font-semibold text-primary">{t(`ตัวชี้วัด 1.5.1 · FY${CAT1_YEAR} Historical Baseline`, `Indicator 1.5.1 · FY${CAT1_YEAR} Historical Baseline`)}</p>
    <h2 id="cat15-hero-title" class="mt-1 text-lg font-bold text-on-surface sm:text-xl">{t('บัญชีก๊าซเรือนกระจก (GHG Inventory)', 'Greenhouse gas inventory')}</h2>
    <p class="mt-2 max-w-prose text-sm leading-relaxed text-on-surface-variant">
      {t(`ข้อมูลปี ${CAT1_YEAR} เป็นฐานประวัติ — ไม่ใช่ผลประเมินปีปัจจุบัน และไม่ใช่คะแนนสำนักงานสีเขียว`, `FY${CAT1_YEAR} is the historical baseline — not a current-year result and not an official Green Office score`)}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat15-pulse-title">
    <h2 id="cat15-pulse-title" class="text-base font-bold text-on-surface">{t('ภาพรวมปี 2568', 'FY2568 overview')}</h2>
    <ol class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4" role="list">
      <li class="list-none rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <p class="text-xs text-on-surface-variant">{t('ยอดรายงานทางการ', 'Official reported total')}</p>
        <p class="mt-1 font-bold num-tabular text-3xl text-primary">{formatTco2e(inventory.totalTCO2e)}</p>
        <p class="mt-1 text-[10px] text-on-surface-variant">tCO₂e · 1.5.2 signed form</p>
      </li>
      <li class="list-none rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <p class="text-xs text-on-surface-variant">{t('ผลรวมรายเดือนจาก workbook', 'Workbook monthly sum')}</p>
        <p class="mt-1 font-bold num-tabular text-3xl text-primary">{formatTco2e(reconcile.dashboardTotalTCO2e)}</p>
        <p class="mt-1 text-[10px] text-on-surface-variant">tCO₂e · 12/12 months</p>
      </li>
      <li class="list-none rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <p class="text-xs text-on-surface-variant">{t('ส่วนต่างที่เปิดเผย', 'Disclosed delta')}</p>
        <p class="mt-1 font-bold num-tabular text-3xl text-primary">{formatTco2e(reconcile.deltaTCO2e)}</p>
        <p class="mt-1 text-[10px] text-on-surface-variant">tCO₂e · official − workbook</p>
      </li>
      <li class="list-none rounded-stitch border border-outline-variant/20 bg-surface-container-lowest p-4">
        <p class="text-xs text-on-surface-variant">{t('ก๊าซเรือนกระจกต่อคน (ทางการ)', 'Official per-capita GHG')}</p>
        <p class="mt-1 font-bold num-tabular text-3xl text-primary">{formatTco2e(inventory.perCapitaTCO2e)}</p>
        <p class="mt-1 text-[10px] text-on-surface-variant">tCO₂e/{t('คน', 'person')} · ≈{formatTco2e(inventory.perCapitaKgCO2e, 0)} kgCO₂e/{t('คน', 'person')}</p>
      </li>
    </ol>
    <p class="mt-3 text-[11px] text-on-surface-variant">
      {t(`ค่ารายงานทางการ ${formatTco2e(inventory.totalTCO2e)} tCO₂e; ผลรวมรายเดือนจาก workbook ${formatTco2e(reconcile.dashboardTotalTCO2e)} tCO₂e; Δ${formatTco2e(reconcile.deltaTCO2e)} เปิดเผยไว้ ไม่ปรับให้ตรงกันโดยเงียบ`, `Official reported total ${formatTco2e(inventory.totalTCO2e)} tCO₂e; workbook monthly sum ${formatTco2e(reconcile.dashboardTotalTCO2e)} tCO₂e; the Δ${formatTco2e(reconcile.deltaTCO2e)} is disclosed, not silently reconciled.`)}
    </p>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat15-scope-title">
    <h2 id="cat15-scope-title" class="text-base font-bold text-on-surface">{t('แยกตามขอบเขต (Scope 1 / 2 / 3)', 'Scope 1 / 2 / 3 breakdown')}</h2>
    <p class="mt-1 text-xs text-on-surface-variant">{t(`ค่าจากแบบฟอร์มทางการ 1.5.2 · ${inventory.methodology}`, `Values from the official 1.5.2 form · ${inventory.methodology}`)}</p>
    <ol class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3" role="list">
      {[
        { label: 'Scope 1', v: inventory.scope1TCO2e },
        { label: 'Scope 2', v: inventory.scope2TCO2e },
        { label: 'Scope 3', v: inventory.scope3TCO2e },
      ].map((s) => (
        <li class="list-none rounded-lg border border-green-100 bg-green-50/40 p-4">
          <p class="text-xs font-semibold text-green-900">{s.label}</p>
          <p class="mt-1 num-tabular text-2xl font-bold text-green-950">{formatTco2e(s.v)} <span class="text-sm font-normal">tCO₂e</span></p>
        </li>
      ))}
    </ol>
  </section>

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="cat15-monthly-title">
    <h2 id="cat15-monthly-title" class="text-base font-bold text-on-surface">{t('สรุปรายเดือนจาก workbook', 'Workbook monthly summary')}</h2>
    <p class="mt-1 text-xs text-on-surface-variant">{t('ชุดรายเดือนเดียวกับ /dashboard/ghg/ และรวมได้ 231.23 tCO₂e', 'Same monthly series as /dashboard/ghg/, summing to 231.23 tCO₂e')}</p>
    <div class="mt-4 overflow-x-auto" data-cat15-monthly-table>
      <table class="min-w-full text-left text-sm">
        <thead><tr class="border-b border-gray-200 text-xs text-on-surface-variant"><th class="py-2 pr-3 font-semibold">{t('เดือน', 'Month')}</th><th class="py-2 pr-3 font-semibold">tCO₂e</th><th class="py-2 font-semibold">{t('แหล่ง', 'Source')}</th></tr></thead>
        <tbody>
          {months.map((m) => (
            <tr class="border-b border-gray-100" data-month={m.month}>
              <td class="py-2 pr-3 font-medium">{t(m.labelTh, m.labelEn)}</td>
              <td class="py-2 pr-3 num-tabular">{formatTco2e(m.tCO2e)}</td>
              <td class="py-2 text-xs text-on-surface-variant">{t('Workbook · แถวรวม', 'Workbook · total row')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-4 space-y-1" aria-hidden="true">
      {months.map((m) => (
        <div class="flex items-center gap-2 text-xs"><span class="w-8 shrink-0 text-on-surface-variant">{t(m.labelTh, m.labelEn)}</span><div class="h-3 flex-1 rounded-full bg-gray-100"><div class="h-3 rounded-full bg-primary/70" style={`width: ${Math.max(4, (m.tCO2e / maxMonth) * 100)}%`} /></div><span class="w-12 shrink-0 num-tabular text-right">{formatTco2e(m.tCO2e)}</span></div>
      ))}
    </div>
  </section>

  {anomalies.length > 0 && (
    <section class="rounded-xl border border-amber-200 bg-amber-50/40 p-5 sm:p-6" aria-labelledby="cat15-anomaly-title">
      <h2 id="cat15-anomaly-title" class="text-base font-bold text-amber-950">{t('ข้อแตกต่าง / ข้อจำกัดที่เปิดเผย', 'Disclosed differences / limits')}</h2>
      <ul class="mt-3 space-y-2" role="list">{anomalies.map((a) => <li class="rounded-lg border border-amber-200/80 bg-white/70 p-3 text-xs text-amber-950"><p class="font-semibold">{a.code}</p><p class="mt-1 leading-relaxed">{a.reason}</p></li>)}</ul>
    </section>
  )}

  <section class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-base font-bold text-on-surface">{t('วิธีการและแหล่งข้อมูล', 'Methodology & provenance')}</h2>
    <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2"><div><dt class="text-xs text-on-surface-variant">{t('Workbook รายเดือน', 'Monthly workbook')}</dt><dd class="font-medium">{provenance.sourceWorkbook}</dd></div><div><dt class="text-xs text-on-surface-variant">{t('แผ่นงาน', 'Sheet')}</dt><dd class="font-medium">{provenance.sourceSheet}</dd></div></dl>
    <ul class="mt-3 space-y-1 text-sm" role="list">
      <li><a href={workbookXlsx} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">{t('ไฟล์คำนวณ GHG (XLSX)', 'GHG calculation workbook (XLSX)')}</a></li>
      <li><a href={officialPdf} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">{t('1.5.2 แบบฟอร์มรายงานทางการ (PDF)', '1.5.2 official reporting form (PDF)')}</a></li>
      <li><a href={invPdf} class="text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded">{t('1.5.1 หลักฐานบัญชี GHG (PDF)', '1.5.1 GHG inventory evidence (PDF)')}</a></li>
    </ul>
    <p class="mt-3 text-[10px] text-on-surface-variant">{sources.join(' · ')}</p>
  </section>

  <section class="rounded-xl border border-green-100 bg-green-50/40 p-5 sm:p-6">
    <a href={path('/dashboard/ghg/')} class="inline-flex min-h-11 items-center rounded-stitch bg-primary px-4 py-2.5 text-sm font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2">{t('เปิดแดชบอร์ด GHG', 'Open GHG dashboard')}</a>
  </section>
</div>
