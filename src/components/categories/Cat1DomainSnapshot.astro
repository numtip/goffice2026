---
import {
  buildCat1DomainSnapshot,
  resolveDomainFactValue,
  type Cat1Domain,
  type DomainFact,
  CAT1_YEAR,
} from '../../utils/category1-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

interface IssueSnapshot {
  issue: string;
  title: { th: string; en: string };
  route: string;
  domains: Cat1Domain[];
}

const ISSUE_SNAPSHOTS: IssueSnapshot[] = [
  {
    issue: '1.1',
    title: { th: 'การกำหนดแนวทางการดำเนินงานสำนักงานสีเขียว', en: 'Defining Green Office Operational Guidelines' },
    route: '/indicators/1.1.1/',
    domains: ['activities-aspects', 'targets'],
  },
  {
    issue: '1.2',
    title: { th: 'คณะทำงานด้านสิ่งแวดล้อม', en: 'Environmental Working Team' },
    route: '/indicators/1.2.1/',
    domains: ['environmental-committee'],
  },
  {
    issue: '1.3',
    title: { th: 'การระบุประเด็นปัญหาทรัพยากรและสิ่งแวดล้อม', en: 'Identification of Resource and Environmental Issues' },
    route: '/indicators/1.3.1/',
    domains: ['environmental-aspects-2568'],
  },
  {
    issue: '1.4',
    title: { th: 'กฎหมายและข้อกำหนดอื่นๆ ที่เกี่ยวข้อง', en: 'Relevant Laws and Regulations' },
    route: '/indicators/1.4.1/',
    domains: ['laws', 'compliance'],
  },
  {
    issue: '1.5',
    title: { th: 'ข้อมูลก๊าซเรือนกระจก', en: 'Greenhouse Gas Data' },
    route: '/indicators/1.5.1/',
    domains: ['ghg'],
  },
  {
    issue: '1.6',
    title: { th: 'แผนการดำเนินงานและโครงการเพื่อมุ่งสู่การลดก๊าซเรือนกระจกของหน่วยงาน', en: 'GHG Reduction Plans and Projects' },
    route: '/indicators/1.6.1/',
    domains: ['projects'],
  },
  {
    issue: '1.7',
    title: { th: 'การทบทวนฝ่ายบริหาร', en: 'Management Review' },
    route: '/indicators/1.7.1/',
    domains: ['management-review'],
  },
];

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const snapshots = ISSUE_SNAPSHOTS.map((s) => ({
  issue: s.issue,
  title: s.title,
  route: s.route,
  facts: s.domains.flatMap((d) => buildCat1DomainSnapshot(d).facts as DomainFact[]),
}));
---

<section
  class="mb-8"
  aria-labelledby="cat1-domain-snapshot"
  data-cat1-domain-snapshot
>
  <div class="mb-4">
    <h2 id="cat1-domain-snapshot" class="text-base font-semibold text-gray-900">
      {isEn ? `FY${CAT1_YEAR} domain snapshot` : `ภาพรวมข้อมูลรายโดเมน ปี ${CAT1_YEAR}`}
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-gray-600">
      {isEn
        ? 'Verified FY2568 facts from the normalized Category 1 contracts. Shown as coverage context, never as an official score.'
        : 'ข้อมูลปี 2568 ที่ตรวจสอบแล้วจากสัญญาข้อมูลหมวด 1 แสดงเป็นบริบทความพร้อมใช้งานเท่านั้น ไม่ใช่คะแนนอย่างเป็นทางการ'}
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      snapshots.map(({ issue, title, route, facts }) => (
        <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="mb-2 flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-start gap-2">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-800">
                {issue}
              </span>
              <a
                href={path(route)}
                class="text-sm font-semibold leading-snug text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
              >
                {t(title)}
              </a>
            </div>
            <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-cat1-domain-status>
              {isEn ? 'FY2568' : 'ปี 2568'}
            </span>
          </div>
          <ul class="space-y-1.5" role="list">
            {
              facts.map((fact) => (
                <li class="flex items-baseline justify-between gap-2 text-xs">
                  <span class="text-gray-500">{t(fact.label)}</span>
                  <span
                    class={`font-medium ${fact.kind === 'unavailable' ? 'text-gray-400' : fact.kind === 'status' ? 'text-amber-700' : 'text-gray-800'}`}
                    data-cat1-domain-fact={fact.kind}
                  >
                    {resolveDomainFactValue(fact.value, locale)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</section>
