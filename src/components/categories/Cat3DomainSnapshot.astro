---
import {
  buildCat3DomainSnapshot,
  resolveDomainFactValue,
  type Cat3Domain,
  type DomainFact,
  CAT3_YEAR,
} from '../../utils/category3-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

interface IssueSnapshot {
  issue: string;
  title: { th: string; en: string };
  route: string;
  domains: Cat3Domain[];
}

const ISSUE_SNAPSHOTS: IssueSnapshot[] = [
  {
    issue: '3.1',
    title: { th: 'การใช้น้ำ', en: 'Water Consumption' },
    route: '/indicators/3.1.1/',
    domains: ['measures', 'data', 'compliance'],
  },
  {
    issue: '3.2',
    title: { th: 'การใช้พลังงาน', en: 'Energy Consumption' },
    route: '/indicators/3.2.1/',
    domains: ['measures', 'data', 'compliance'],
  },
  {
    issue: '3.3',
    title: { th: 'การใช้ทรัพยากรอื่นๆ', en: 'Use of Other Resources' },
    route: '/indicators/3.3.1/',
    domains: ['measures', 'data', 'compliance'],
  },
  {
    issue: '3.4',
    title: { th: 'การประชุมและการจัดนิทรรศการ', en: 'Meetings and Exhibitions' },
    route: '/indicators/3.4.1/',
    domains: ['meetings'],
  },
];

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const targetFacts = buildCat3DomainSnapshot('targets').facts as DomainFact[];

const snapshots = ISSUE_SNAPSHOTS.map((s) => ({
  issue: s.issue,
  title: s.title,
  route: s.route,
  facts: s.domains.flatMap((d) => buildCat3DomainSnapshot(d).facts as DomainFact[]),
}));
---

<section class="mb-8" aria-labelledby="cat3-domain-snapshot" data-cat3-domain-snapshot>
  <div class="mb-4">
    <h2 id="cat3-domain-snapshot" class="text-base font-semibold text-gray-900">
      {isEn ? `FY${CAT3_YEAR} domain snapshot` : `ภาพรวมข้อมูลรายโดเมน ปี ${CAT3_YEAR}`}
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-gray-600">
      {isEn
        ? 'Verified FY2568 facts from the normalized Category 3 contracts. Shown as coverage context, never as an official score. 3.2.2 per-unit numbers remain unavailable (image-only tables); target outcomes are met/not-met context only.'
        : 'ข้อมูลปี 2568 ที่ตรวจสอบแล้วจากสัญญาข้อมูลหมวด 3 แสดงเป็นบริบทความพร้อมใช้งานเท่านั้น ไม่ใช่คะแนนอย่างเป็นทางการ ตัวเลขต่อหน่วย 3.2.2 ยังไม่พร้อมใช้งาน (ตารางเป็นรูปภาพ) ผลเทียบเป้าหมายเป็นบริบทบรรลุ/ไม่บรรลุเท่านั้น'}
    </p>
  </div>

  <div class="mb-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list" data-cat3-target-facts>
    {
      targetFacts.map((fact) => (
        <div class="flex flex-col rounded-xl border border-green-100 bg-white p-3 shadow-sm">
          <span class="text-xs text-gray-500">{t(fact.label)}</span>
          <span class="mt-1 text-sm font-semibold text-green-800" data-cat3-domain-fact={fact.kind}>
            {resolveDomainFactValue(fact.value, locale)}
          </span>
        </div>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      snapshots.map(({ issue, title, route, facts }) => (
        <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="mb-2 flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-start gap-2">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-800">
                {issue}
              </span>
              <a
                href={path(route)}
                class="text-sm font-semibold leading-snug text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
              >
                {t(title)}
              </a>
            </div>
            <span class="shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600" data-cat3-domain-status>
              {isEn ? 'FY2568' : 'ปี 2568'}
            </span>
          </div>
          <ul class="space-y-1.5" role="list">
            {
              facts.map((fact) => (
                <li class="flex items-baseline justify-between gap-2 text-xs">
                  <span class="text-gray-500">{t(fact.label)}</span>
                  <span
                    class={`font-medium text-right ${fact.kind === 'unavailable' ? 'text-gray-400' : fact.kind === 'status' ? 'text-amber-700' : 'text-gray-800'}`}
                    data-cat3-domain-fact={fact.kind}
                  >
                    {resolveDomainFactValue(fact.value, locale)}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      ))
    }
  </div>
</section>
