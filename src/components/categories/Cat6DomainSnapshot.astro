---
/**
 * Cat6DomainSnapshot.astro — FY2568 domain snapshot for Category 6.
 * Verified baseline facts from the normalized Category 6 contracts, grouped by
 * domain. Coverage context only — never an official score, never a PASS claim.
 * Percentages that are not evidenced are shown as unavailable, and recurring
 * evidence is labeled "awaiting FY2569 update".
 */
import {
  buildCat6DomainSnapshot,
  resolveDomainFactValue,
  type Cat6Domain,
  type DomainFact,
  CAT6_YEAR,
} from '../../utils/category6-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

interface DomainRoute {
  domain: Cat6Domain;
  title: { th: string; en: string };
  route: string;
}

const DOMAIN_ROUTES: DomainRoute[] = [
  { domain: 'products', title: { th: 'การจัดซื้อสินค้า', en: 'Product procurement' }, route: '/indicators/6.1.1/' },
  { domain: 'contractors', title: { th: 'การจัดจ้างและผู้รับจ้าง', en: 'Contracting' }, route: '/indicators/6.2.1/' },
  { domain: 'services', title: { th: 'บริการนอกสำนักงาน', en: 'External services' }, route: '/indicators/6.2.3/' },
];

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}

const snapshots = DOMAIN_ROUTES.map((s) => ({
  ...s,
  facts: buildCat6DomainSnapshot(s.domain).facts as DomainFact[],
}));
---

<section class="mb-8" aria-labelledby="cat6-domain-snapshot" data-cat6-domain-snapshot>
  <div class="mb-4">
    <h2 id="cat6-domain-snapshot" class="text-base font-semibold text-gray-900">
      {isEn ? `FY${CAT6_YEAR} domain snapshot` : `ภาพรวมข้อมูลรายด้านปี ${CAT6_YEAR}`}
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-gray-600">
      {isEn
        ? 'Verified FY2568 baseline facts from the normalized Category 6 contracts — the frozen baseline layer for FY2569. Shown as coverage context, never as an official score or PASS claim. Percentages not evidenced in the sources are shown as unavailable; recurring evidence awaits FY2569 collection.'
        : 'ข้อเท็จจริงฐานปี 2568 ที่ตรวจสอบแล้วจากสัญญาข้อมูลหมวด 6 — เป็นชั้นข้อมูลฐานที่ตรึงไว้สำหรับปี 2569 แสดงเป็นบริบทความครอบคลุมเท่านั้น ไม่ใช่คะแนนหรือการผ่านเกณฑ์ ร้อยละที่ไม่มีหลักฐานจะแสดงว่าไม่พบข้อมูล และหลักฐานที่เก็บเป็นประจำรอการเก็บในปี 2569'}
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      snapshots.map(({ domain, title, route, facts }) => (
        <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <div class="mb-2 flex items-start justify-between gap-2">
            <div class="flex min-w-0 items-start gap-2">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-800">
                {domain.slice(0, 1).toUpperCase()}
              </span>
              <a
                href={path(route)}
                class="text-sm font-semibold leading-snug text-green-700 hover:text-green-900 hover:underline"
              >
                {t(title)}
              </a>
            </div>
          </div>
          <dl class="space-y-2" data-cat6-domain-facts={domain}>
            {facts.map((fact) => (
              <div
                class="rounded-lg border border-gray-100 bg-gray-50/60 px-3 py-2"
                data-cat6-domain-fact={fact.kind}
              >
                <dt class="text-xs text-gray-500">{t(fact.label)}</dt>
                <dd
                  class:list={[
                    'mt-0.5 text-sm leading-snug',
                    fact.kind === 'unavailable' ? 'font-medium text-amber-700' : 'font-semibold text-gray-800',
                  ]}
                >
                  {resolveDomainFactValue(fact.value, locale)}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</section>
