---
/**
 * Cat6ManagementCycle.astro — Category 6 procurement management cycle.
 * Compact loop (Products → Report → Contractors → Inspect → External services),
 * restrained single-accent (green) hierarchy, not a marketing/hero surface.
 * FY2568 facts are labeled as the frozen baseline; FY2569 is shown separately.
 */
import {
  CAT6_MANAGEMENT_CYCLE,
  CAT6_JOURNEYS,
  indicatorTitle,
} from '../../utils/category6-presentation';
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isEn = locale === 'en';
const path = (p: string) => getLocalizedPath(locale, p);

function t(field: { th: string; en: string }): string {
  return isEn ? field.en : field.th;
}
---

<section
  class="mb-8 rounded-xl border border-green-100 bg-green-50/30 p-5 sm:p-6"
  aria-labelledby="cat6-management-cycle"
  data-cat6-management-cycle
>
  <div class="mb-4">
    <h2 id="cat6-management-cycle" class="text-base font-semibold text-gray-900">
      {isEn ? 'Category 6 procurement cycle' : 'วงจรการจัดการจัดซื้อและจัดจ้างหมวด 6'}
    </h2>
    <p class="mt-1 text-sm leading-relaxed text-gray-600">
      {isEn
        ? 'FY2568 facts below come from the normalized Category 6 contracts and are the frozen baseline for FY2569. Each stage links to its indicators. Recurring evidence (procurement %, product-list review, policy briefing, contractor evaluations) is awaiting FY2569 collection — never presented as a new result.'
        : 'ข้อมูลปี 2568 ด้านล่างมาจากสัญญาข้อมูลหมวด 6 ที่จัดรูปแบบแล้ว และเป็นข้อมูลฐานที่ตรึงไว้สำหรับปี 2569 แต่ละขั้นเชื่อมโยงไปยังตัวชี้วัด หลักฐานที่เก็บเป็นประจำ (ร้อยละการจัดซื้อ การทบทวนบัญชีสินค้า การชี้แจงนโยบาย การประเมินผู้รับจ้าง) รอการเก็บในปี 2569 — ไม่นำเสนอเป็นผลใหม่'}
    </p>
  </div>

  <ol class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-5" role="list" aria-label={isEn ? 'Procurement cycle stages' : 'ขั้นตอนวงจรการจัดการจัดซื้อและจัดจ้าง'}>
    {
      CAT6_MANAGEMENT_CYCLE.map((step) => (
        <li class="flex flex-col rounded-xl border border-green-200 bg-white p-4 shadow-sm">
          <span class="mb-2 inline-flex h-6 w-6 items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-800">
            {step.stage}
          </span>
          <a
            href={path(`/indicators/${step.targetCode}/`)}
            class="text-sm font-semibold leading-snug text-green-700 hover:text-green-900 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2 rounded"
          >
            {t(step.label)}
          </a>
          <p class="mt-1.5 text-xs leading-relaxed text-gray-500">
            {t(step.summary)}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="mt-4 border-t border-green-100 pt-3">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
      {isEn ? 'Cross-links' : 'เส้นทางการเชื่อมโยง'}
    </h3>
    <ul class="flex flex-wrap gap-2" role="list">
      {
        CAT6_JOURNEYS.map((j) => (
          <li>
            <a
              href={path(`/indicators/${j.from}/`)}
              class="inline-flex items-center gap-1 rounded-full border border-green-200 bg-white px-3 py-1 text-xs font-medium text-green-800 transition-colors hover:border-green-400 hover:bg-green-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-700 focus-visible:ring-offset-2"
              aria-label={`${indicatorTitle(j.from, locale)} — ${indicatorTitle(j.to, locale)}`}
            >
              {j.from} — {j.to}
              <span class="hidden sm:inline text-gray-500">· {t(j.label)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
