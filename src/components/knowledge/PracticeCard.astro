---
import { getLocalizedPath } from '../../i18n/utils';

interface Props {
  practice: any;
  locale: 'th' | 'en';
}

const { practice, locale } = Astro.props;
const isTh = locale === 'th';

const href = getLocalizedPath(locale, `/knowledge/${practice.slug}/`);
const title = isTh ? practice.titleTh : practice.titleEn;
const tagline = isTh ? practice.taglineTh : practice.taglineEn;
const firstAction = (isTh ? practice.actionsTh : practice.actionsEn)[0] ?? '';
const accent = practice.visual?.accent ?? '#0f766e';
---

<a
  href={href}
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
  style={`outline-color:${accent}`}
>
  <span class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-xl text-2xl" style={`background:${practice.visual?.accentSoft ?? '#f0fdfa'}`} aria-hidden="true">
    {practice.visual?.icon ?? '🌿'}
  </span>
  <div class="mb-2 flex items-center gap-2">
    <span class="rounded-full px-2.5 py-0.5 text-xs font-bold tracking-wide text-white" style={`background:${accent}`}>
      {practice.number}
    </span>
    <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">{isTh ? practice.titleEn : practice.titleTh}</span>
  </div>
  <h3 class="text-lg font-bold text-gray-900">{title}</h3>
  <p class="mt-1 text-sm text-gray-600 leading-relaxed">{tagline}</p>
  <p class="mt-3 flex-1 text-sm text-gray-500 leading-relaxed">
    <span class="font-semibold text-gray-700">{isTh ? 'ทำได้ทันที' : 'Start now'} · </span>
    {firstAction}
  </p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold" style={`color:${accent}`}>
    {isTh ? 'เข้าชมวิถี' : 'Explore practice'}
    <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
