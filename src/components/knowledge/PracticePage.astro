---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getLocalizedPath } from '../../i18n/utils';
import MediaCard from './MediaCard.astro';
import PracticeCard from './PracticeCard.astro';
import practicesData from '../../data/knowledge/practices.json';
import categoryData from '../../data/criteria/categories.json';
import indicatorData from '../../data/criteria/indicators.json';
import { dashboards, dashTitle, dashDescription } from '../../data/dashboard-config';

interface Props {
  practice: any;
  locale: 'th' | 'en';
}

const { practice, locale } = Astro.props;
const isTh = locale === 'th';
const allPractices = practicesData.practices;

const t = (pair: { th: string; en: string }): string => (isTh ? pair.th : pair.en);

const accent = practice.visual?.accent ?? '#0f766e';
const accentSoft = practice.visual?.accentSoft ?? '#f0fdfa';

const pageTitle = isTh
  ? `${practice.titleTh} | ${practice.number} · 8 วิถี Green Office`
  : `${practice.titleEn} | Practice ${practice.number} of 8 Green Office Practices`;
const pageDescription = isTh ? practice.seoDescriptionTh : practice.seoDescriptionEn;

// Verified category resolution from canonical categories.json
const resolvedCategories = (practice.categories ?? [])
  .map((code: string) => categoryData.categories.find((c) => c.code === code))
  .filter(Boolean);

// Verified indicator resolution from canonical indicators.json (never guessed)
const resolvedIndicators = (practice.indicators ?? [])
  .map((code: string) => indicatorData.indicators.find((ind) => ind.id === code))
  .filter(Boolean);

// Dashboard resolution from canonical dashboard-config.ts (validated set only)
const resolvedDashboards = (practice.dashboards ?? [])
  .map((id: string) => dashboards.find((d) => d.id === id))
  .filter(Boolean);

// Related practices
const relatedPractices = (practice.relatedKnowledge ?? [])
  .map((slug: string) => allPractices.find((p) => p.slug === slug))
  .filter(Boolean);

const videos = (practice.media ?? []).filter((m: any) => m.type === 'video');
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale}>
  <article>
    <!-- 1. Practice Hero -->
    <section class="relative overflow-hidden text-white" style={`background:${accent}`}>
      <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white blur-3xl"></div>
        <div class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-white/80 blur-3xl"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
        <nav class="mb-6 text-sm" aria-label={isTh ? 'เส้นทาง breadcrumb' : 'Breadcrumb'}>
          <a href={getLocalizedPath(locale, '/knowledge/')} class="text-white/80 hover:text-white hover:underline">
            {isTh ? 'ความรู้' : 'Knowledge'}
          </a>
          <span class="mx-2 text-white/50" aria-hidden="true">/</span>
          <span class="font-semibold text-white">{isTh ? practice.titleTh : practice.titleEn}</span>
        </nav>
        <div class="flex items-center gap-4">
          <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-4xl" aria-hidden="true">
            {practice.visual?.icon ?? '🌿'}
          </span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-white/80">
              {isTh ? `วิถีที่ ${practice.number} ใน 8` : `Practice ${practice.number} of 8`}
            </p>
            <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{isTh ? practice.titleTh : practice.titleEn}</h1>
          </div>
        </div>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/90">
          {isTh ? practice.taglineTh : practice.taglineEn}
        </p>
        <p class="mt-3 max-w-2xl leading-relaxed text-white/80">
          {isTh ? practice.summaryTh : practice.summaryEn}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="#do-this-today"
            class="inline-flex items-center gap-1.5 rounded-full bg-white px-5 py-2.5 text-sm font-bold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            style={`color:${accent}`}
          >
            {isTh ? 'ทำได้วันนี้' : 'Do this today'}
          </a>
          <a
            href="#why-it-matters"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/50 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {isTh ? 'เหตุผลที่สำคัญ' : 'Why it matters'}
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
        <!-- Main column -->
        <div class="lg:col-span-2">
          <!-- 2. Why It Matters -->
          <section id="why-it-matters" class="scroll-mt-24" aria-labelledby="why-heading">
            <h2 id="why-heading" class="mb-4 text-2xl font-bold text-gray-900">
              {isTh ? 'เหตุผลที่สำคัญ' : 'Why it matters'}
            </h2>
            <div class="space-y-4 text-gray-700 leading-relaxed">
              {(isTh ? practice.whyTh : practice.whyEn).map((para: string) => (
                <p>{para}</p>
              ))}
            </div>
          </section>

          <!-- 3. Do This Today -->
          <section id="do-this-today" class="mt-12 scroll-mt-24" aria-labelledby="do-heading">
            <div class="rounded-3xl p-8" style={`background:${accentSoft}`}>
              <h2 id="do-heading" class="mb-1 text-2xl font-bold text-gray-900">
                {isTh ? 'ทำได้วันนี้' : 'Do this today'}
              </h2>
              <p class="mb-6 text-sm text-gray-600">
                {isTh ? 'อ่านแล้วทำได้ทันที ไม่ต้องรอมาตรการใหญ่' : 'Read and act immediately — no big programme required.'}
              </p>
              <ul class="space-y-3">
                {(isTh ? practice.actionsTh : practice.actionsEn).map((action: string) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white text-sm font-bold" style={`color:${accent}`} aria-hidden="true">✓</span>
                    <span class="text-gray-800">{action}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <!-- 4. Watch / Learn -->
          {videos.length > 0 && (
            <section class="mt-12" aria-labelledby="watch-heading">
              <h2 id="watch-heading" class="mb-4 text-2xl font-bold text-gray-900">
                {isTh ? 'ชมและเรียนรู้' : 'Watch & learn'}
              </h2>
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {videos.map((media: any) => (
                  <MediaCard media={media} locale={locale} />
                ))}
              </div>
            </section>
          )}

          <!-- 5. Quick Knowledge -->
          <section class="mt-12" aria-labelledby="quick-heading">
            <h2 id="quick-heading" class="mb-4 text-2xl font-bold text-gray-900">
              {isTh ? 'เกร็ดความรู้' : 'Quick knowledge'}
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {practice.quickKnowledge.map((item: any, idx: number) => (
                <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
                  <p class="text-xs font-semibold uppercase tracking-wider" style={`color:${accent}`}>
                    {isTh
                      ? item.type === 'fact' ? 'ข้อเท็จจริง' : item.type === 'myth' ? 'ความเข้าใจที่ถูกต้อง' : 'คำอธิบาย'
                      : item.type === 'fact' ? 'Fact' : item.type === 'myth' ? 'Get it right' : 'Explain'}
                  </p>
                  <h3 class="mt-1 font-bold text-gray-900">{t({ th: item.titleTh, en: item.titleEn })}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-gray-600">{t({ th: item.bodyTh, en: item.bodyEn })}</p>
                </div>
              ))}
            </div>
          </section>

          <!-- 6. Green Challenge -->
          <section class="mt-12" aria-labelledby="challenge-heading">
            <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm">
              <p class="text-xs font-bold uppercase tracking-widest" style={`color:${accent}`}>
                {isTh ? 'ความท้าทายรายวัน' : 'Everyday Green Challenge'}
              </p>
              <p class="mt-3 text-lg font-semibold text-gray-900">
                {isTh ? practice.challengeTh : practice.challengeEn}
              </p>
            </div>
          </section>

          <!-- 7. Environmental Impact -->
          <section class="mt-12" aria-labelledby="impact-heading">
            <h2 id="impact-heading" class="mb-4 text-2xl font-bold text-gray-900">
              {isTh ? 'ผลกระทบที่เกี่ยวข้อง' : 'Environmental impact'}
            </h2>
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
              <p class="mb-4 text-sm text-gray-600">
                {isTh ? 'วิถีนี้เชื่อมโยงกับมิติผลการดำเนินงานเหล่านี้' : 'This practice connects to these performance dimensions:'}
              </p>
              <ul class="flex flex-wrap gap-2">
                {(isTh ? practice.impactLinks : practice.impactLinks.map((l: any) => ({ labelTh: l.labelTh, labelEn: l.labelEn })))
                  .map((link: any, idx: number) => (
                    <li class="inline-flex items-center gap-2">
                      <span class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-gray-800 shadow-sm">
                        {isTh ? link.labelTh : link.labelEn}
                      </span>
                      {idx < (isTh ? practice.impactLinks : practice.impactLinks).length - 1 && (
                        <svg class="h-4 w-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      )}
                    </li>
                  ))}
              </ul>
            </div>
          </section>

          <!-- 8. Our Performance (dashboards) -->
          {resolvedDashboards.length > 0 && (
            <section class="mt-12" aria-labelledby="performance-heading">
              <h2 id="performance-heading" class="mb-4 text-2xl font-bold text-gray-900">
                {isTh ? 'ผลการดำเนินงานของเรา' : 'Our performance'}
              </h2>
              <p class="mb-4 text-sm text-gray-600">
                {isTh
                  ? 'ติดตามผลการดำเนินงานจริงของสำนักงานที่เกี่ยวข้องกับวิถีนี้'
                  : 'Track the real office performance related to this practice.'}
              </p>
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                {resolvedDashboards.map((d: any) => (
                  <a
                    href={getLocalizedPath(locale, `/dashboard/${d.id}/`)}
                    class="block rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-green-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
                  >
                    <h3 class="text-sm font-bold text-green-700">{dashTitle(d, locale)}</h3>
                    <p class="mt-1 line-clamp-2 text-xs text-gray-500">{dashDescription(d, locale)}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- 9. Related Green Office Criteria -->
          {(resolvedCategories.length > 0 || resolvedIndicators.length > 0) && (
            <section class="mt-12" aria-labelledby="criteria-heading">
              <h2 id="criteria-heading" class="mb-4 text-2xl font-bold text-gray-900">
                {isTh ? 'เกณฑ์ Green Office ที่เกี่ยวข้อง' : 'Related Green Office criteria'}
              </h2>
              <p class="mb-4 text-sm text-gray-600">
                {isTh
                  ? 'เชื่อมโยงกับเกณฑ์และตัวชี้วัดที่ตรวจสอบแล้ว (ไม่มีการเดาหมายเลขตัวชี้วัด)'
                  : 'Linked to verified criteria and indicators (no guessed indicator IDs).'}
              </p>

              {resolvedCategories.length > 0 && (
                <div class="mb-6">
                  <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
                    {isTh ? 'หมวดหมู่' : 'Categories'}
                  </h3>
                  <ul class="space-y-2">
                    {resolvedCategories.map((cat: any) => (
                      <li>
                        <a
                          href={getLocalizedPath(locale, `/categories/${cat.code}/`)}
                          class="flex items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition hover:border-green-300 hover:shadow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
                        >
                          <span>
                            <span class="block text-sm font-bold text-gray-900">{t(cat.title)}</span>
                            <span class="block text-xs text-gray-500">{t(cat.summary)}</span>
                          </span>
                          <span class="shrink-0 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800">{cat.code}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {resolvedIndicators.length > 0 && (
                <div>
                  <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-500">
                    {isTh ? 'ตัวชี้วัด' : 'Indicators'}
                  </h3>
                  <ul class="space-y-2">
                    {resolvedIndicators.map((ind: any) => (
                      <li>
                        <a
                          href={getLocalizedPath(locale, `/indicators/${ind.id}/`)}
                          class="flex items-start justify-between gap-3 rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-sm transition hover:border-green-300 hover:shadow focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
                        >
                          <span class="text-sm text-gray-700">{t(ind.title)}</span>
                          <span class="shrink-0 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-700">{ind.id}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1" aria-label={isTh ? 'วิถีอื่น ๆ' : 'Other practices'}>
          <div class="lg:sticky lg:top-24">
            <h2 class="mb-4 text-lg font-bold text-gray-900">
              {isTh ? 'วิถีอื่น ๆ' : 'Other practices'}
            </h2>
            <div class="space-y-4">
              {relatedPractices.map((p: any) => (
                <PracticeCard practice={p} locale={locale} />
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
