---
import { getLocalizedPath } from '../../i18n/utils';
import { engageHref, engageImageAvailable, type EngageVisual } from '../../data/engageVisuals';

interface Props {
  visual: EngageVisual;
  locale: 'th' | 'en';
}

const { visual: v, locale } = Astro.props;
const isTh = locale === 'th';

const href = getLocalizedPath(locale, engageHref(v));
const title = isTh ? v.titleTh : v.titleEn;
const description = isTh ? v.descriptionTh : v.descriptionEn;
const alt = isTh ? v.altTh : v.altEn;
const tag = v.relatedMetric ?? (v.relatedCategory ?? '');
const available = engageImageAvailable(v.file);
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-stitch-lg border border-outline-variant/20 bg-surface-container-lowest/80 shadow-md backdrop-blur-sm transition-colors duration-300 hover:border-primary-container/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
  style={`outline-color:${v.accent}`}
>
  <!-- Canonical engage visual (web/<id>-master.webp), lazy; accent placeholder while pending -->
  <div class="relative overflow-hidden aspect-[16/9]">
    {available ? (
      <img
        src={v.image}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:group-hover:scale-100"
      />
    ) : (
      <div
        class="flex h-full w-full items-center justify-center"
        style={`background: linear-gradient(135deg, ${v.accentLight} 0%, #ffffff 100%)`}
        aria-hidden="true"
      >
        <svg
          class="h-10 w-10"
          style={`color: ${v.accent}`}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 22c0-5 3.5-9 9-10 0 5.5-3.5 10-9 10z" />
          <path d="M12 22c0-5-3.5-9-9-10 0 5.5 3.5 10 9 10z" />
          <path d="M12 22V10" />
        </svg>
      </div>
    )}
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-black/35 to-transparent" aria-hidden="true" />
  </div>

  <!-- Copy -->
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    {tag && (
      <p class="mb-2 font-mono text-[10px] uppercase tracking-wider" style={`color: ${v.accent}`}>
        {tag}
      </p>
    )}
    <h3 class="mb-2 text-lg font-semibold text-primary">{title}</h3>
    <p class="flex-1 text-sm leading-relaxed text-on-surface-variant line-clamp-2">{description}</p>
    <span class="mt-4 inline-flex items-center gap-1.5 text-label-sm font-medium uppercase tracking-wider text-secondary transition-colors duration-300 group-hover:text-primary">
      {isTh ? 'เข้าชมวิถี' : 'Explore practice'}
      <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
