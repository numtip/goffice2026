---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
import { getLocalizedPath } from '../../i18n/utils';
import EngagePracticeCard from './EngagePracticeCard.astro';
import MediaCard from './MediaCard.astro';
import practicesData from '../../data/knowledge/practices.json';
import { engageVisuals } from '../../data/engageVisuals';
import { dashboards, dashTitle, dashDescription } from '../../data/dashboard-config';

interface Props {
  locale: 'th' | 'en';
}

const { locale } = Astro.props;
const isTh = locale === 'th';
const hub = practicesData.hub;
const practices = practicesData.practices;

const t = (pair: { th: string; en: string }): string => (isTh ? pair.th : pair.en);

const pageTitle = isTh ? `${hub.titleTh} | ความรู้` : `${hub.titleEn} | Knowledge`;
const pageDescription = isTh
  ? 'สำรวจ 8 วิถี Green Office — ความรู้ สื่อ และแนวทางปฏิบัติที่ช่วยให้ทุกคนเข้าใจ ลงมือทำ และเห็นผลกระทบต่อสิ่งแวดล้อมของสำนักงาน'
  : 'Explore the 8 Green Office Practices — knowledge, media, and everyday actions to understand, act, and see the environmental impact of the office.';

// Featured practice video for the Watch / Learn block
const featured = practices.find((p) => p.id === hub.featuredPracticeId) ?? practices[0];
const featuredVideos = (featured.media ?? []).filter((m: any) => m.type === 'video');

// All media across practices for the media library
const mediaLibrary = practices.flatMap((p) =>
  (p.media ?? []).map((m: any) => ({ ...m, practiceSlug: p.slug, practiceTitleTh: p.titleTh, practiceTitleEn: p.titleEn })),
);

// Related dashboards (hub-level verified set)
const dashList = (hub.relatedDashboards ?? [])
  .map((id: string) => dashboards.find((d) => d.id === id))
  .filter(Boolean);
---

<BaseLayout title={pageTitle} description={pageDescription} locale={locale}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-primary text-white">
    <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-green-400 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-green-300 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-green-300">{isTh ? hub.eyebrowTh : hub.eyebrowEn}</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight sm:text-5xl">
        {isTh ? hub.titleTh : hub.titleEn}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-green-50">
        {isTh ? hub.taglineTh : hub.taglineEn}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={getLocalizedPath(locale, `/knowledge/${practices[0].slug}/`)}
          class="inline-flex items-center gap-2 rounded-full bg-green-400 px-6 py-3 text-sm font-bold text-primary transition hover:bg-green-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-300"
        >
          {isTh ? 'เริ่มจากวิถีที่ 1' : 'Start with Practice 1'}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a
          href={getLocalizedPath(locale, '/categories/')}
          class="inline-flex items-center gap-2 rounded-full border border-white/40 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {isTh ? 'ดูเกณฑ์ Green Office' : 'View Green Office Criteria'}
        </a>
      </div>
    </div>
  </section>

  <!-- Learn → Act → See Impact strip -->
  <section class="border-b border-gray-200 bg-white" aria-label={isTh ? 'กระบวนการเรียนรู้' : 'Learning journey'}>
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-4 py-8 sm:grid-cols-3 sm:px-6">
      {[
        { icon: '📚', labelTh: hub.learnLabelTh, labelEn: hub.learnLabelEn, descTh: 'ทำความเข้าใจว่าทำไมจึงสำคัญ', descEn: 'Understand why it matters' },
        { icon: '✅', labelTh: hub.actLabelTh, labelEn: hub.actLabelEn, descTh: 'ลงมือทำตามแนวทางที่ทำได้ทันที', descEn: 'Act with do-it-today actions' },
        { icon: '📊', labelTh: hub.impactLabelTh, labelEn: hub.impactLabelEn, descTh: 'เห็นความเชื่อมโยงกับผลการดำเนินงานจริง', descEn: 'See the link to real performance' },
      ].map((step) => (
        <div class="flex items-start gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-green-50 text-2xl" aria-hidden="true">{step.icon}</span>
          <div>
            <p class="font-bold text-gray-900">{isTh ? step.labelTh : step.labelEn}</p>
            <p class="mt-0.5 text-sm text-gray-600">{isTh ? step.descTh : step.descEn}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <!-- 8 Practice Navigator -->
    <section aria-labelledby="practices-heading">
      <div class="mb-6">
        <h2 id="practices-heading" class="text-2xl font-bold text-gray-900 sm:text-3xl">
          {isTh ? 'สำรวจ 8 วิถี' : 'Explore the 8 Practices'}
        </h2>
        <p class="mt-2 max-w-3xl text-gray-600">
          {isTh
            ? 'ทุกวิถีประกอบด้วยเหตุผลสำคัญ สิ่งที่ทำได้วันนี้ สื่อการเรียนรู้ และการเชื่อมโยงกับเกณฑ์และผลการดำเนินงานของสำนักงาน'
            : 'Each practice includes why it matters, what you can do today, learning media, and links to office criteria and performance.'}
        </p>
      </div>
      <div class="landing-stagger grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {engageVisuals.map((v) => (
          <div class="landing-reveal h-full">
            <EngagePracticeCard visual={v} locale={locale} />
          </div>
        ))}
      </div>
    </section>

    <!-- Watch / Learn — featured -->
    {featuredVideos.length > 0 && (
      <section class="mt-16" aria-labelledby="featured-media-heading">
        <div class="mb-6">
          <h2 id="featured-media-heading" class="text-2xl font-bold text-gray-900 sm:text-3xl">
            {isTh ? 'เริ่มจากวิดีโอแนะนำ' : 'Start with a featured video'}
          </h2>
          <p class="mt-2 max-w-3xl text-gray-600">
            {isTh
              ? `วิดีโอจากวิถี ${t({ th: featured.titleTh, en: featured.titleEn })} เพื่อเริ่มต้นความเข้าใจ`
              : `Videos from the ${t({ th: featured.titleTh, en: featured.titleEn })} practice to build understanding.`}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {featuredVideos.map((media: any) => (
            <MediaCard media={media} locale={locale} />
          ))}
        </div>
      </section>
    )}

    <!-- Everyday Green Challenge -->
    <section class="mt-16 rounded-3xl border border-green-100 bg-green-50/60 p-8" aria-labelledby="challenge-heading">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="challenge-heading" class="text-2xl font-bold text-gray-900">
            {isTh ? hub.challengeHeadingTh : hub.challengeHeadingEn}
          </h2>
          <p class="mt-3 text-lg font-semibold text-primary">
            {isTh ? featured.challengeTh : featured.challengeEn}
          </p>
          <p class="mt-2 text-sm text-gray-600">
            {isTh
              ? `ความท้าทายจากวิถี ${t({ th: featured.titleTh, en: featured.titleEn })} — ลองทำแล้วแชร์ให้เพื่อนร่วมงานรู้`
              : `From the ${t({ th: featured.titleTh, en: featured.titleEn })} practice — try it and share with your colleagues.`}
          </p>
        </div>
        <a
          href={getLocalizedPath(locale, `/knowledge/${featured.slug}/`)}
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-bold text-white transition hover:bg-primary-container focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {isTh ? 'ดูความท้าทายทั้งหมด' : 'See all challenges'}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Environmental Impact Connection -->
    <section class="mt-16" aria-labelledby="impact-heading">
      <div class="mb-6">
        <h2 id="impact-heading" class="text-2xl font-bold text-gray-900 sm:text-3xl">
          {isTh ? 'ทุกวิถีเชื่อมโยงกับผลกระทบจริง' : 'Every practice connects to real impact'}
        </h2>
        <p class="mt-2 max-w-3xl text-gray-600">
          {isTh
            ? 'แต่ละวิถีสะท้อนผ่านทรัพยากรที่วัดได้ และก๊าซเรือนกระจกเป็นผลกระทบขวางที่เชื่อมทุกวิถีเข้าด้วยกัน'
            : 'Each practice reflects through measurable resources, and greenhouse gas is the cross-cutting impact connecting them all.'}
        </p>
      </div>
      <div class="rounded-3xl border border-gray-200 bg-white p-8 shadow-sm">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {practices.map((p, i) => (
            <div class="flex items-center gap-3">
              <a
                href={getLocalizedPath(locale, `/knowledge/${p.slug}/`)}
                class="group flex flex-col items-center gap-1 rounded-2xl border border-gray-100 bg-gray-50 px-4 py-3 text-center transition hover:border-green-300 hover:bg-green-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
              >
                <span class="text-2xl" aria-hidden="true">{p.visual?.icon ?? '🌿'}</span>
                <span class="max-w-[7rem] text-xs font-semibold text-gray-800 group-hover:text-primary">
                  {isTh ? p.titleTh : p.titleEn}
                </span>
              </a>
              {i < practices.length - 1 && (
                <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              )}
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-col items-center justify-center gap-2 border-t border-dashed border-gray-200 pt-6 text-center">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-red-50 text-2xl" aria-hidden="true">🌍</span>
          <p class="font-bold text-gray-900">{isTh ? 'ผลกระทบต่อสิ่งแวดล้อม · ก๊าซเรือนกระจก' : 'Environmental impact · Greenhouse Gas'}</p>
          <a href={getLocalizedPath(locale, '/dashboard/ghg/')} class="text-sm font-semibold text-green-700 hover:underline">
            {isTh ? 'ดูแดชบอร์ด GHG' : 'View the GHG Dashboard'}
          </a>
        </div>
      </div>
    </section>

    <!-- Related Dashboards -->
    {dashList.length > 0 && (
      <section class="mt-16" aria-labelledby="related-dashboards-heading">
        <div class="mb-6">
          <h2 id="related-dashboards-heading" class="text-2xl font-bold text-gray-900 sm:text-3xl">
            {isTh ? 'ผลการดำเนินงานของสำนักงาน' : 'Our office performance'}
          </h2>
          <p class="mt-2 max-w-3xl text-gray-600">
            {isTh
              ? 'สำรวจแดชบอร์ดทรัพยากรที่เกี่ยวข้องกับวิถีทั้ง 8'
              : 'Explore the resource dashboards that relate to all 8 practices.'}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {dashList.map((d: any) => (
            <a
              href={getLocalizedPath(locale, `/dashboard/${d.id}/`)}
              class="block h-full rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-green-300 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
            >
              <h3 class="text-sm font-bold text-green-700">{dashTitle(d, locale)}</h3>
              <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-gray-500">{dashDescription(d, locale)}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Knowledge Media Library -->
    {mediaLibrary.length > 0 && (
      <section class="mt-16" aria-labelledby="media-library-heading">
        <div class="mb-6">
          <h2 id="media-library-heading" class="text-2xl font-bold text-gray-900 sm:text-3xl">
            {isTh ? 'คลังสื่อความรู้' : 'Knowledge media library'}
          </h2>
          <p class="mt-2 max-w-3xl text-gray-600">
            {isTh
              ? 'รวมวิดีโอและสื่อการเรียนรู้จากทุกวิถีไว้ในที่เดียว'
              : 'All videos and learning media from every practice in one place.'}
          </p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {mediaLibrary.map((media: any) => (
            <div>
              <MediaCard media={media} locale={locale} />
              <p class="mt-2 text-xs text-gray-500">
                <a
                  href={getLocalizedPath(locale, `/knowledge/${media.practiceSlug}/`)}
                  class="font-semibold text-green-700 hover:underline"
                >
                  {isTh ? media.practiceTitleTh : media.practiceTitleEn}
                </a>
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related links -->
    <section class="mt-16" aria-labelledby="hub-related-heading">
      <h2 id="hub-related-heading" class="mb-4 text-xl font-semibold text-gray-900">
        {isTh ? 'แหล่งข้อมูลที่เกี่ยวข้อง' : 'Related resources'}
      </h2>
      <ul class="flex flex-wrap gap-3">
        {hub.relatedLinks.map((link: any) => (
          <li>
            <a
              href={getLocalizedPath(locale, link.route.replace(/\/$/, ''))}
              class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-green-700 transition hover:border-green-300 hover:bg-green-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
            >
              {isTh ? link.labelTh : link.labelEn}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../scripts/landing-motion.ts';
</script>
