---
import { getLocalizedPath, stripBasePath, stripLocalePrefix, getLocale } from '../../i18n/utils';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import SiteLogo from '../ui/SiteLogo.astro';
import type { HomeNavStrings } from '../../i18n/dictionary';

interface Props {
  locale?: 'th' | 'en';
  t?: HomeNavStrings;
  university?: string;
  platformLabel?: string;
  languageLabels?: {
    choose: string;
    switchToThai: string;
    switchToEnglish: string;
  };
}

const locale = Astro.props.locale ?? getLocale(Astro.url);
const navLabels = Astro.props.t ?? {
  home: 'Home',
  dashboard: 'Dashboard',
  categories: 'Categories',
  evidence: 'Evidence',
  documents: 'Documents',
  news: 'News',
  activities: 'Activities',
  knowledge: 'Knowledge',
  about: 'About',
  search: 'Search',
  menu: 'Menu',
  primary_navigation: 'Primary navigation',
} as HomeNavStrings;

const university = Astro.props.university ?? 'Maejo University';
const platformLabel = Astro.props.platformLabel ?? 'Green Office Platform';
const languageLabels = Astro.props.languageLabels;
const primaryNavLabel = navLabels.primary_navigation ?? 'Primary navigation';

const navItems = [
  { href: '/', label: navLabels.home },
  { href: '/dashboard', label: navLabels.dashboard },
  { href: '/categories', label: navLabels.categories },
  { href: '/news', label: navLabels.news ?? 'News' },
  { href: '/activities', label: navLabels.activities ?? 'Activities' },
  { href: '/knowledge', label: navLabels.knowledge ?? 'Knowledge' },
  { href: '/evidence', label: navLabels.evidence },
  { href: '/documents', label: navLabels.documents },
  { href: '/about', label: navLabels.about ?? 'About' },
  { href: '/search', label: navLabels.search },
];

const isTh = locale === 'th';
const mobileOpenLabel = navLabels.menu ?? 'Menu';
const mobileCloseLabel = isTh ? 'ปิด' : 'Close';

const pathWithoutBase = stripLocalePrefix(stripBasePath(Astro.url.pathname));
const currentPath = pathWithoutBase || '/';
const isActive = (href: string) => {
  const normalized = href === '/' ? '/' : `${href.replace(/\/$/, '')}/`;
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(normalized);
};
---

<div class="bg-primary text-white">
  <div class="mx-auto flex min-h-10 max-w-6xl items-center justify-between gap-3 px-4 py-2 text-xs sm:text-sm">
    <p class="font-medium tracking-wide">
      {university} <span class="hidden text-primary-fixed sm:inline">· {platformLabel}</span>
    </p>
    <LanguageSwitcher
      chooseLabel={languageLabels?.choose}
      switchToThaiLabel={languageLabels?.switchToThai}
      switchToEnglishLabel={languageLabels?.switchToEnglish}
    />
  </div>
</div>

<nav class="border-b border-primary/10 bg-white/95 px-4 py-3 shadow-sm backdrop-blur supports-[backdrop-filter]:bg-white/85" aria-label={primaryNavLabel}>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
    <a href={getLocalizedPath(locale, '/')} class="group inline-flex min-w-0 items-center gap-3 text-left">
      <SiteLogo
        alt={isTh ? 'สำนักงานสีเขียว (Green Office)' : 'Green Office'}
        class="h-9 w-auto max-w-[7.5rem] shrink-0 object-contain object-left"
        width={36}
        height={29}
      />
      <span class="min-w-0">
        <span class="block text-sm font-semibold leading-tight text-primary">
          {isTh ? 'สำนักงานสีเขียว (Green Office)' : 'Green Office'}
        </span>
        <span class="block text-[11px] uppercase tracking-wide text-outline">
          {isTh
            ? 'อาคารเฉลิมพระเกียรติสมเด็จพระเทพรัตนราชสุดา มหาวิทยาลัยแม่โจ้'
            : 'Chalermprakiat Building, Maejo University'}
        </span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 text-sm lg:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={getLocalizedPath(locale, item.href)}
            class:list={[
              'inline-flex min-h-10 items-center whitespace-nowrap rounded-md px-3 py-2 font-semibold transition-colors duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
              isActive(item.href)
                ? 'bg-primary text-white shadow-sm'
                : 'text-on-surface hover:bg-primary-50 hover:text-primary',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <details class="group relative lg:hidden" id="mobile-nav">
      <summary class="flex min-h-10 cursor-pointer list-none items-center rounded-md border border-primary/20 px-3 py-2 text-sm font-semibold text-primary transition-colors duration-200 ease-out hover:bg-primary-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2" aria-label={navLabels.menu}>
        <span class="nav-menu-label">{navLabels.menu}</span>
        <svg class="nav-icon-hamburger ml-2 h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
        <svg class="nav-icon-close ml-2 hidden h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l8 8M14 6l-8 8" />
        </svg>
      </summary>
      <div class="absolute right-0 z-[60] mt-3 w-64 rounded-lg border border-primary/15 bg-white p-3.5 shadow-xl shadow-primary/5" role="navigation" aria-label={navLabels.menu}>
        <div class="mb-2.5 flex items-center justify-between border-b border-gray-100 pb-2.5">
          <span class="nav-menu-heading text-xs font-semibold text-outline">{navLabels.menu}</span>
          <button type="button" class="nav-close-btn flex items-center justify-center h-7 w-7 rounded-md text-outline transition-colors duration-200 ease-out hover:bg-gray-100 hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2" aria-label={`${locale === 'th' ? 'ปิด' : 'Close'} ${navLabels.menu}`}>
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l8 8M14 6l-8 8" />
            </svg>
          </button>
        </div>
        <ul class="space-y-1">
          {navItems.slice(0, 3).map((item) => (
            <li>
              <a
                href={getLocalizedPath(locale, item.href)}
                class:list={[
                  'flex min-h-11 items-center rounded-md px-3 py-2 text-sm font-semibold transition-colors duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
                  isActive(item.href)
                    ? 'bg-primary text-white'
                    : 'text-on-surface hover:bg-primary-50 hover:text-primary',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="my-2 border-t border-gray-100" aria-hidden="true"></div>
        <ul class="space-y-1">
          {navItems.slice(3).map((item) => (
            <li>
              <a
                href={getLocalizedPath(locale, item.href)}
                class:list={[
                  'flex min-h-11 items-center rounded-md px-3 py-2 text-sm font-semibold transition-colors duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
                  isActive(item.href)
                    ? 'bg-primary text-white'
                    : 'text-on-surface hover:bg-primary-50 hover:text-primary',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <style>
      details[open] .nav-icon-hamburger { display: none; }
      details[open] .nav-icon-close { display: block; }
    </style>

    <script define:vars={{ mobileOpenLabel, mobileCloseLabel }}>
      const details = document.getElementById('mobile-nav');
      if (details) {
        const summary = details.querySelector('summary');
        const label = details.querySelector('.nav-menu-label');
        const closeBtn = details.querySelector('.nav-close-btn');

        const updateState = () => {
          const isOpen = details.open;
          if (summary) {
            summary.setAttribute('aria-expanded', String(isOpen));
            summary.setAttribute('aria-label', isOpen ? mobileCloseLabel + ' ' + mobileOpenLabel : mobileOpenLabel);
          }
          if (label) {
            label.textContent = isOpen ? mobileCloseLabel : mobileOpenLabel;
          }
        };

        details.addEventListener('toggle', updateState);

        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            details.open = false;
          });
        }

        details.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && details.open) {
            details.open = false;
            if (summary) summary.focus();
          }
        });

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (details.open && target instanceof Node && !details.contains(target)) {
            details.open = false;
          }
        });

        updateState();
      }
    </script>
  </div>
</nav>
