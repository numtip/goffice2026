---
import { getLocalizedPath } from '../../i18n/utils';

interface Crumb {
  /** Already-localized display label. */
  label: string;
  /** Canonical site-relative path (e.g. '/evidence/'). Omit for the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
  locale: 'th' | 'en';
}

const { items, locale } = Astro.props;
const label = (th: string, en: string): string => (locale === 'th' ? th : en);
---

<nav class="mb-6 text-sm text-outline" aria-label={label('เส้นทางนำทาง', 'Breadcrumb')}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      const isLink = Boolean(item.href) && !isLast;
      return (
        <>
          {i > 0 && (
            <li class="flex select-none items-center text-outline/40" aria-hidden="true">
              <svg
                class="h-3.5 w-3.5"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 4 4 4-4 4" />
              </svg>
            </li>
          )}
          <li>
            {isLink ? (
              <a
                href={getLocalizedPath(locale, item.href!)}
                class="rounded-sm text-primary-600 underline-offset-4 transition-colors hover:text-primary-800 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                {item.label}
              </a>
            ) : (
              <span
                class:list={[
                  'truncate max-w-[200px]',
                  isLast ? 'font-medium text-on-surface' : 'text-outline',
                ]}
                aria-current={isLast ? 'page' : undefined}
              >
                {item.label}
              </span>
            )}
          </li>
        </>
      );
    })}
  </ol>
</nav>
